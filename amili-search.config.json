{
  "outDir": "dist",
  "label": "Search colour combinations",
  "placeholder": "Search palettes, colors, collections…",
  "suggest": [
    "beige",
    "sage green",
    "navy",
    "wada sanzo",
    "terracotta"
  ],
  "sourceIndex": {
    "file": "search-index.json",
    "map": {
      "u": "s",
      "t": "t",
      "g": "k",
      "k": "x"
    }
  },
  "ga4": true,
  "clarity": true,
  "skipScript": [
    "/embed/"
  ],
  "routes": [
    {
      "match": "hex",
      "href": "/tools/palette-from-color/?hex={hex}",
      "label": "Find the closest Wada palettes to #{HEX}",
      "group": "Tool"
    }
  ]
}
