---
/**
 * FurtherReading — editorial book list with Amazon affiliate links + cover images.
 *
 * Covers are pulled from the Open Library CDN (free, no auth) via ISBN.
 * Open Library returns a transparent 1x1 PNG on misses, so the `onerror`
 * handler swaps in a serif fallback tile — no broken-image glyphs.
 *
 * Used on:
 *  - /about (full book list with covers)
 *  - /shop (curated selection as a shop section)
 *  - /palettes/[slug] (compact variant with 2 rotating picks — sidebar)
 *
 * Affiliate: Amazon Associates only (tag colorcombinations-20). Operator
 * directive 2026-05-21: Bookshop.org retired; Amazon is the sole storefront.
 */

import { AMAZON, FURTHER_READING, bookBySlug, bookCover, type CuratedBook } from"@/config/monetization";

export interface Props {
  title?: string;
  intro?: string;
  /** Limit number of books shown. */
  limit?: number;
  /** Offset into the book list — used to rotate picks on palette pages. */
  offset?: number;
  /** Layout variant. */
  variant?:"full" |"compact" |"sidebar";
  /**
   * &ascsubtag= page-class slug forwarded to every book's Amazon link (see
   * AMAZON.link()) — e.g. "palette", "home", "about", "shop", "compare".
   * Defaults to this component's own honest, coarse bucket name so a caller
   * that forgets to pass one still reports something true (this render IS a
   * "further-reading" click) rather than silently pooling into a WRONG class.
   * Pass the calling page's own class where it's known — this component
   * renders on ~18 distinct page types, so an unqualified default pools all
   * of them together and can't answer "which surface actually converts?".
   */
  pageClass?: string;
  /**
   * Override which array of books renders — defaults to the site-wide
   * FURTHER_READING shelf. Pass a different CuratedBook[] (e.g.
   * COLOR_REFERENCE_LIBRARY) to reuse this component's proven render/rotate/
   * disclosure/compare-link logic for a standalone curated list without
   * touching the default shelf every other caller relies on.
   */
  books?: CuratedBook[];
}

const {
  title ="Further reading",
  intro,
  limit,
  offset = 0,
  variant ="full",
  pageClass ="further-reading",
  books: sourceBooks = FURTHER_READING,
} = Astro.props;

// Rotate + slice. Keeps the rendered set stable per-URL (no random) while
// giving different palette pages different book picks for impression variety.
const books = (() => {
  const rotated = [...sourceBooks.slice(offset), ...sourceBooks.slice(0, offset)];
  return typeof limit ==="number" ? rotated.slice(0, limit) : rotated;
})();

// FTC + Amazon Associates disclosure is shown unconditionally on non-sidebar
// listings. Click-tracking fires regardless of whether an affiliate tag is
// pasted in yet, so the disclosure is an always-on compliance surface.
const showDisclosure = true;

// One disclosure string, two placements. On a LONG list the trailing disclosure
// alone sits ~2,000 CSS px below the first buy link at 375px (measured on
// /trends/color-trends-2026/, 2026-09-02: 18 CTAs spanning y=7691-9507, sole
// in-content disclosure at y=9664) - i.e. the reader passes every affiliate link
// before seeing one. The already-fixed /palettes/ sidebar keeps that gap <=690px,
// which is the standard this restores. Short lists are unchanged.
const DISCLOSURE_TEXT =
  variant ==="sidebar"
    ?"Affiliate links — as an Amazon Associate we earn from qualifying purchases."
    :"Book links are Amazon Associates affiliate links. Your price is unchanged; a small commission supports the archive. As an Amazon Associate we earn from qualifying purchases.";
const showLeadDisclosure = showDisclosure && variant !=="sidebar" && books.length >= 5;

// When the rendered set includes either Wada dictionary (the two highest-click
// books on the site — 150+ Amazon clicks/30d combined), route undecided
// readers to the on-site comparison instead of losing them at the buy fork.
// Internal link → /compare/wada-vol-1-vs-vol-2 (was an orphan page with zero
// inbound links; this surface renders on every palette page + /about + /shop).
const WADA_ASINS = new Set(["4861522471","4861527724"]);
const showWadaCompare = books.some((b) => WADA_ASINS.has(b.amazonAsin));
---

<section class:list={["further-reading", `further-reading--${variant}`]}>
  <header class="further-reading__head">
    <p class="eyebrow">Library</p>
    <h2 class="text-balance">{title}</h2>
    {intro && <p class="further-reading__intro">{intro}</p>}
  </header>

  {showLeadDisclosure && (
    <p class="further-reading__disclosure further-reading__disclosure--lead">
      {DISCLOSURE_TEXT}
    </p>
  )}

  <ul class="further-reading__list" role="list">
    {books.map((book) => {
      const coverUrl = bookCover(book, variant ==="sidebar" ?"M" :"L");
      const initials = book.title
        .split(/\s+/)
        .slice(0, 2)
        .map((w) => w[0])
        .join("")
        .toUpperCase();

      // Every book routes to Amazon via the affiliate-tagged URL. Books
      // without an ASIN fall back to an internal anchor (#) so the layout
      // doesn't break, but the FURTHER_READING dataset should have an ASIN
      // for every entry — this branch is defensive only.
      const amazonHref = book.amazonAsin ? AMAZON.link(book.amazonAsin, pageClass) :"#";

      const detail = (
        <>
          <p class="further-reading__note">{book.note}</p>
          <p class="further-reading__why">{book.why}</p>
          <div class="further-reading__links">
            <a
              href={amazonHref}
              rel="sponsored nofollow noopener"
              target="_blank"
              class="btn btn-secondary further-reading__link"
              data-event="amazon_click"
              data-book={book.title}
            >
              See price on Amazon <span aria-hidden="true">↗</span>
            </a>
            {variant ==="sidebar" && bookBySlug(book.slug) && (
              <a href={`/books/${book.slug}/`} class="further-reading__more">
                More about this book
              </a>
            )}
          </div>
        </>
      );

      return (
        <li class="further-reading__item">
          <a
            href={amazonHref}
            rel="sponsored nofollow noopener"
            target="_blank"
            class="further-reading__cover"
            data-event="amazon_click"
            data-book={book.title}
            aria-label={`${book.title} on Amazon`}
          >
            {coverUrl ? (
              <img
                src={coverUrl}
                alt={`${book.title} by ${book.author} — book cover`}
                loading="lazy"
                decoding="async"
                data-cover-img
                onerror="this.classList.add('is-missing')"
                onload="if (this.naturalWidth < 10) this.classList.add('is-missing')"
              />
            ) : (
              <span class="further-reading__cover-fallback" aria-hidden="true">
                {initials}
              </span>
            )}
            <span class="further-reading__cover-fallback fallback-layer" aria-hidden="true">
              {initials}
            </span>
          </a>

          <div class="further-reading__meta">
            <p class="further-reading__by">{book.author}</p>
            <h3 class="further-reading__title">
              <a
                href={amazonHref}
                rel="sponsored nofollow noopener"
                target="_blank"
                class=""
                data-event="amazon_click"
                data-book={book.title}
              >
                {book.title}
              </a>
            </h3>
            {variant !=="sidebar" && detail}
          </div>
          {/*
            Sidebar (the single book on every /palettes/ page) used to show a
            title and a button only — no edition, no reason, so the reader had
            nothing to decide with. Both lines come straight from the book's own
            record. Rendered below the cover row at full card width so the text
            isn't squeezed into a ~200px column at 375px.
          */}
          {variant ==="sidebar" && <div class="further-reading__detail">{detail}</div>}
        </li>
      );
    })}
  </ul>

  {showWadaCompare && (
    <p class="further-reading__compare">
      Torn between the two Wada dictionaries?{""}
      <a href="/compare/wada-vol-1-vs-vol-2/">Vol 1 vs Vol 2, compared plate by plate →</a>
    </p>
  )}

  {showDisclosure && (
    <p class="further-reading__disclosure">
      {DISCLOSURE_TEXT}
    </p>
  )}
</section>

<style>
  .further-reading {
    padding-block: var(--spacing-section);
  }

  .further-reading--compact {
    padding-block: 2.5rem;
  }

  .further-reading--sidebar {
    padding-block: 0;
  }

  .further-reading__head {
    max-width: 58ch;
    margin-bottom: 2.5rem;
  }

  .further-reading--sidebar .further-reading__head {
    margin-bottom: 1rem;
  }

  .further-reading__head .eyebrow {
    margin-bottom: 0.75rem;
  }

  .further-reading__head h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw + 1rem, 2.25rem);
    line-height: 1.15;
    margin: 0;
  }

  .further-reading--sidebar .further-reading__head h2 {
    font-size: 1rem;
    font-weight: 500;
  }

  .further-reading__intro {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-ink-700);
    line-height: 1.65;
    margin-top: 1rem;
  }

  .further-reading__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .further-reading__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .further-reading--full .further-reading__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .further-reading--sidebar .further-reading__list {
    grid-template-columns: 1fr !important;
    gap: 0.875rem;
  }

  .further-reading__item {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-plate);
  }

  .further-reading--sidebar .further-reading__item {
    grid-template-columns: 3.5rem 1fr;
    gap: 0.875rem;
    padding: 0.875rem;
    box-shadow: none;
  }

  @media (max-width: 480px) {
    .further-reading__item {
      grid-template-columns: 6rem 1fr;
      gap: 1rem;
      padding: 1.25rem;
    }
  }

  /* ============ COVER ============ */

  .further-reading__cover {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: var(--color-paper-100);
    border-radius: var(--radius-sm);
    overflow: hidden;
    text-decoration: none;
    align-self: start;
  }

  .further-reading__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 2;
  }

  .further-reading__cover img.is-missing {
    display: none;
  }

  .further-reading__cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-ink-500);
    background: linear-gradient(
      135deg,
      var(--color-paper-100) 0%,
      var(--color-paper-200) 100%
    );
    z-index: 1;
  }

  /* ============ META ============ */

  .further-reading__meta {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .further-reading__by {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    margin: 0 0 0.25rem;
  }

  .further-reading--sidebar .further-reading__by {
    font-size: 0.625rem;
  }

  .further-reading__title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .further-reading--sidebar .further-reading__title {
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .further-reading__title a {
    color: var(--color-ink-900);
    text-decoration: none;
  }

  .further-reading__title a:hover {
    color: var(--color-accent-500);
  }

  .further-reading__note {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
    margin: 0 0 0.75rem;
  }

  .further-reading__why {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-700);
    margin: 0 0 1rem;
    font-style: italic;
  }

  .further-reading__links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: auto;
  }

  .further-reading__link {
    font-size: 0.8125rem;
    padding: 0.4rem 0.75rem;
  }

  .further-reading--sidebar .further-reading__link {
    display: flex;
    width: 100%;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    font-size: 0.8125rem;
    padding: 0.4rem 0.75rem;
  }

  .further-reading--sidebar .further-reading__note {
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .further-reading--sidebar .further-reading__why {
    font-size: 0.8125rem;
    margin-bottom: 0.875rem;
  }

  .further-reading--sidebar .further-reading__detail {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
  }

  .further-reading__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.8125rem;
    color: var(--color-ink-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .further-reading__more:hover {
    color: var(--color-accent-500);
  }

  .further-reading__amazon {
    font-size: 0.75rem;
    color: var(--color-ink-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .further-reading__amazon:hover {
    color: var(--color-accent-500);
  }

  .further-reading__compare {
    margin-block-start: 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft, inherit);
  }

  /* Lead disclosure sits ABOVE a long list; the trailing one keeps its top margin. */
  .further-reading__disclosure--lead {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  /* 44px tap floor on the buy CTA at mobile (fleet-mobile-standard). This class
     overrides the global .btn padding (0.75rem -> 0.4rem), which rendered the
     buy button ("See price on Amazon") at 36px measured at 375px - 8px under the floor, on
     the money path of the site's most-cited page. Mobile-scoped so the desktop
     compact look is untouched. */
  @media (max-width: 640px) {
    .further-reading__link {
      min-height: 44px;
      white-space: nowrap;
    }
  }

  .further-reading__disclosure {
    margin-top: 2rem;
    font-size: 0.75rem;
    color: var(--color-ink-400);
    max-width: 60ch;
    line-height: 1.5;
    font-style: italic;
  }

  /* Compact FTC disclosure for the sidebar variant on /palettes/[slug] —
     affiliate links there must carry the disclosure too (FTC 16 CFR 255). */
  .further-reading--sidebar .further-reading__disclosure {
    margin-top: 1rem;
    font-size: 0.6875rem;
  }
</style>
