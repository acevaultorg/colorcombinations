---
// ColorHarmony — derived, zero-fabrication color-theory + usage section for
// /colors/[slug]. The template already ships curated palettes ("Palettes with
// X") and raw specs (hex/RGB/HSL/contrast) but NOTHING on colour harmony or how
// to actually use the colour — the single thing a "what goes with X" visitor
// wants. This adds it, computed entirely from the colour's own hex via standard
// hue-wheel math + WCAG contrast (the site's own lib/color). It lifts the ~34
// thinnest /colors pages (basic names like brown, purple, white) above the
// Strong threshold and enriches all 213 without any authored/fabricated prose.
import { hexToRgb, contrastRatio, bestTextColorOn } from "@/lib/color";
import type { HexColor } from "@/types/palette";

interface Props {
  hex: HexColor;
  name: string;
}
const { hex, name } = Astro.props;

// --- standard colour-space conversions (pure math, no data) ---
function rgbToHsl(r: number, g: number, b: number) {
  const rn = r / 255,
    gn = g / 255,
    bn = b / 255;
  const max = Math.max(rn, gn, bn),
    min = Math.min(rn, gn, bn);
  const l = (max + min) / 2;
  const d = max - min;
  let h = 0;
  const s = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
  if (d !== 0) {
    if (max === rn) h = ((gn - bn) / d) % 6;
    else if (max === gn) h = (bn - rn) / d + 2;
    else h = (rn - gn) / d + 4;
    h *= 60;
    if (h < 0) h += 360;
  }
  return { h, s, l };
}
function hslToHex(h: number, s: number, l: number): string {
  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
  const m = l - c / 2;
  let rp = 0,
    gp = 0,
    bp = 0;
  if (h < 60) [rp, gp, bp] = [c, x, 0];
  else if (h < 120) [rp, gp, bp] = [x, c, 0];
  else if (h < 180) [rp, gp, bp] = [0, c, x];
  else if (h < 240) [rp, gp, bp] = [0, x, c];
  else if (h < 300) [rp, gp, bp] = [x, 0, c];
  else [rp, gp, bp] = [c, 0, x];
  const to = (v: number) =>
    Math.round((v + m) * 255)
      .toString(16)
      .padStart(2, "0");
  return `#${to(rp)}${to(gp)}${to(bp)}`.toUpperCase();
}

const { r, g, b } = hexToRgb(hex);
const { h, s, l } = rgbToHsl(r, g, b);
const rot = (deg: number) => hslToHex((h + deg + 360) % 360, s, l) as HexColor;

const nearNeutral = s < 0.15;

type Harmony = { label: string; blurb: string; hexes: HexColor[] };
const harmonies: Harmony[] = [
  {
    label: "Complementary",
    blurb: "the hue directly opposite — the highest-contrast pairing, good for a single bold accent.",
    hexes: [rot(180)],
  },
  {
    label: "Analogous",
    blurb: "the two neighbours on the wheel — a calm, cohesive scheme that feels effortless.",
    hexes: [rot(-30), rot(30)],
  },
  {
    label: "Triadic",
    blurb: "two hues an even third of the wheel away — balanced and lively without clashing.",
    hexes: [rot(120), rot(240)],
  },
  {
    label: "Split-complementary",
    blurb: "the two colours either side of the complement — the contrast of a complement, softened.",
    hexes: [rot(150), rot(210)],
  },
];

// --- usage guidance, derived from lightness / saturation / WCAG contrast ---
const onWhite = contrastRatio(hex, "#FFFFFF" as HexColor);
const onBlack = contrastRatio(hex, "#000000" as HexColor);
const maxContrast = Math.max(onWhite, onBlack);
const bestBg = onWhite >= onBlack ? "a light background" : "a dark background";
const textOn = bestTextColorOn(hex) === "light" ? "light" : "dark";
const lPct = Math.round(l * 100);
const sPct = Math.round(s * 100);
const hDeg = Math.round(h);
const lightWord = lPct >= 70 ? "light" : lPct >= 40 ? "mid-tone" : "deep";
const satWord = nearNeutral ? "near-neutral" : sPct >= 60 ? "vivid" : "muted";
const textVerdict =
  maxContrast >= 4.5
    ? `passes WCAG AA for body text against ${bestBg} (${maxContrast.toFixed(1)}:1) — safe for paragraphs, buttons and labels`
    : maxContrast >= 3
      ? `passes WCAG AA only for large text against ${bestBg} (${maxContrast.toFixed(1)}:1) — use it for headings, not long paragraphs`
      : `has low text contrast (${maxContrast.toFixed(1)}:1 at best) — keep it for fills, borders and decoration rather than type`;
const roleWord =
  lPct >= 70
    ? "a soft background or a light accent"
    : lPct <= 35
      ? "a grounding background or strong accent"
      : "a versatile mid-tone for accents, buttons or blocks";

function swatch(hx: HexColor) {
  return hx;
}
---

<section class="harmony" aria-labelledby="harmony-heading">
  <h2 id="harmony-heading" class="section-title">Colours that go with {name}</h2>
  <p class="harmony__intro">
    {
      nearNeutral
        ? `As a ${lightWord} near-neutral, ${name} sits comfortably beside almost any accent — the schemes below show the subtle, reliable pairings from a standard colour wheel.`
        : `From a standard colour wheel, ${name} anchors these four classic schemes. Each swatch is computed from its exact hue, so every hex is a real, usable pairing.`
    }
  </p>

  <div class="harmony__grid">
    {
      harmonies.map((hg) => (
        <div class="harmony__card">
          <h3 class="harmony__label">{hg.label}</h3>
          <div class="harmony__swatches">
            <span
              class="harmony__chip"
              style={`background:${hex};color:${textOn === "light" ? "#fff" : "#111"}`}
            >
              {hex}
            </span>
            {hg.hexes.map((hx) => (
              <span
                class="harmony__chip"
                style={`background:${swatch(hx)};color:${
                  contrastRatio(hx, "#FFFFFF" as HexColor) >= contrastRatio(hx, "#111111" as HexColor)
                    ? "#fff"
                    : "#111"
                }`}
              >
                {hx}
              </span>
            ))}
          </div>
          <p class="harmony__blurb">{hg.blurb}</p>
        </div>
      ))
    }
  </div>

  <h2 class="section-title" style="margin-top:2rem">How to use {name}</h2>
  <p class="harmony__use">
    {name} is a {lightWord}, {satWord} tone (HSL {hDeg}°, {sPct}%, {lPct}%),
    which makes it {roleWord}. For text it {textVerdict}. When you do set type on
    it, use {textOn} lettering. Pair it with its complement ({rot(180)}) for a
    focal accent, or with its analogous neighbours ({rot(-30)} and {rot(30)}) for
    a quieter, harmonious feel.
  </p>
</section>

<style>
  .harmony {
    margin: 2rem 0;
  }
  .harmony__intro,
  .harmony__use {
    color: var(--muted-strong, #444);
    line-height: 1.6;
    margin: 0.5rem 0 1rem;
  }
  .harmony__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .harmony__card {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 0.85rem;
  }
  .harmony__label {
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
    font-weight: 650;
  }
  .harmony__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }
  .harmony__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 68px;
    padding: 0.5rem 0.4rem;
    border-radius: 5px;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .harmony__blurb {
    margin: 0;
    font-size: 0.83rem;
    color: var(--muted, #666);
    line-height: 1.5;
  }
</style>
