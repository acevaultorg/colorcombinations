---
// Cookie preferences note — no-tracking disclosure.
// Per DECISIONS.md 2026-04-10, no AdSense / Mediavine / display-ad networks
// run on this site. Plausible is cookieless. Under GDPR/CCPA we are not
// required to show a consent banner at all. This banner is retained ONLY
// as a transparency signal + a way for users to reopen from the footer.
// Default state: hidden. Only appears if the user explicitly clicks the
// "Cookie Preferences" button in the footer.
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie preferences" aria-live="polite" hidden>
  <div class="cookie-banner__inner">
    <p class="cookie-banner__text">
      <strong>No tracking cookies.</strong> This site runs on
      <a href="https://plausible.io/data-policy" class="cookie-banner__link" rel="noopener" target="_blank">Plausible</a>
      (cookieless analytics) and sets zero ad / marketing cookies.
      <a href="/privacy" class="cookie-banner__link">Full privacy policy</a>.
    </p>
    <div class="cookie-banner__actions">
      <button id="cc-ok" class="cookie-banner__btn cookie-banner__btn--primary">
        Got it
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  // Banner is NEVER shown by default — no tracking means no consent needed.
  // Only appears when the operator-facing footer button #cc-reopen is clicked.
  function show() {
    var banner = document.getElementById('cookie-banner');
    if (banner) banner.hidden = false;
  }
  function dismiss() {
    var banner = document.getElementById('cookie-banner');
    if (banner) banner.hidden = true;
  }

  document.addEventListener('DOMContentLoaded', function () {
    var okBtn = document.getElementById('cc-ok');
    if (okBtn) okBtn.addEventListener('click', dismiss);
    var reopen = document.getElementById('cc-reopen');
    if (reopen) reopen.addEventListener('click', function (e) {
      e.preventDefault();
      show();
    });
  });
})();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: calc(100% - 2rem);
    max-width: 680px;
    background: var(--color-bg-elevated, #fff);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 24px rgba(20, 20, 20, 0.12);
    padding: 1rem 1.25rem;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cookie-banner__text {
    flex: 1;
    font-size: 0.875rem;
    color: var(--color-ink-700);
    line-height: 1.55;
    margin: 0;
    min-width: 200px;
  }

  .cookie-banner__link {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-banner__actions {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .cookie-banner__btn {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.4375rem 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .cookie-banner__btn--secondary {
    background: transparent;
    border-color: var(--color-border);
    color: var(--color-ink-700);
  }

  .cookie-banner__btn--secondary:hover {
    background: var(--color-paper-100);
    border-color: var(--color-ink-400);
  }

  .cookie-banner__btn--primary {
    background: var(--color-ink-900);
    border-color: var(--color-ink-900);
    color: var(--color-paper-50);
  }

  .cookie-banner__btn--primary:hover {
    background: var(--color-ink-700);
    border-color: var(--color-ink-700);
  }

  @media (max-width: 480px) {
    .cookie-banner__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
    }

    .cookie-banner__actions {
      width: 100%;
    }

    .cookie-banner__btn {
      flex: 1;
      text-align: center;
    }
  }
</style>
