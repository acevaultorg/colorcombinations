---
// Notice banner — shown once on first visit.
// This site uses Microsoft Clarity + Google Analytics 4 (and cookieless Cloudflare
// Web Analytics). Plausible was retired 2026-06-28. Mediavine display ads went live
// 2026-09-04 — its TCF CMP (consentmanager.net) is the ACTUAL consent gate for ad
// vendors and runs independently of this banner. This banner stayed a transparency
// notice; it must never claim we run no ad networks again (it did until 2026-09-04,
// which was live and false on every page for the first hours of ad serving).
// Book links route via Amazon Associates; amazon.com sets its own cookies
// *after* you click through. The banner exists to be transparent about that,
// not to gate consent for anything we ourselves set.
// Preference stored in localStorage: "cc_status" = "acknowledged".
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Site data notice" aria-live="polite" hidden>
  <div class="cookie-banner__inner">
    <p class="cookie-banner__text">
      <strong>About data on this site.</strong> We use Microsoft Clarity and
      Google Analytics to measure aggregate usage and record on-page
      interactions, alongside cookieless Cloudflare Web Analytics. Display
      advertising is served by Mediavine, whose own consent tool manages your
      advertising choices. Book links route through the
      Amazon Associates affiliate program; amazon.com sets its own cookies
      once you visit it. As an Amazon Associate we earn from qualifying
      purchases. <a href="/privacy" class="cookie-banner__link">Privacy policy</a>
    </p>
    <div class="cookie-banner__actions">
      <button id="cc-accept" class="cookie-banner__btn cookie-banner__btn--primary">
        Got it
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var STORAGE_KEY = 'cc_status';
  var status = localStorage.getItem(STORAGE_KEY);

  // ONE CONSENT SURFACE (2026-09-23): where the ad CMP applies (EU/UK: TCF
  // gdprApplies === true) it already covers the phone screen, and this notice
  // stacked underneath it. So this notice is shown only where the CMP does not
  // apply, or where no CMP loads at all within ~4s. Its content is repeated on
  // /privacy, which the footer links on every page.
  function show() {
    var banner = document.getElementById('cookie-banner');
    if (banner && !localStorage.getItem(STORAGE_KEY)) banner.hidden = false;
  }
  if (!status) {
    var tries = 0;
    (function waitForCmp() {
      if (typeof window.__tcfapi === 'function') {
        var decided = false;
        window.__tcfapi('addEventListener', 2, function (tc, ok) {
          if (decided || !ok || !tc) return;
          if (typeof tc.gdprApplies !== 'boolean') return;
          decided = true;
          if (!tc.gdprApplies) show();
        });
        // A CMP stub that never answers must not hide the notice forever.
        setTimeout(function () { if (!decided) { decided = true; show(); } }, 6000);
        return;
      }
      if (++tries < 16) return setTimeout(waitForCmp, 250);
      show();
    })();
  }

  function dismiss() {
    localStorage.setItem(STORAGE_KEY, 'acknowledged');
    var banner = document.getElementById('cookie-banner');
    if (banner) banner.hidden = true;
  }

  document.addEventListener('DOMContentLoaded', function () {
    var acceptBtn = document.getElementById('cc-accept');
    if (acceptBtn) acceptBtn.addEventListener('click', dismiss);
  });
})();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: calc(100% - 2rem);
    max-width: 680px;
    background: var(--color-bg-elevated, #fff);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 24px rgba(20, 20, 20, 0.12);
    padding: 1rem 1.25rem;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cookie-banner__text {
    flex: 1;
    font-size: 0.875rem;
    color: var(--color-ink-700);
    line-height: 1.55;
    margin: 0;
    min-width: 200px;
  }

  .cookie-banner__link {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-banner__actions {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .cookie-banner__btn {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.4375rem 0.875rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .cookie-banner__btn--secondary {
    background: transparent;
    border-color: var(--color-border);
    color: var(--color-ink-700);
  }

  .cookie-banner__btn--secondary:hover {
    background: var(--color-paper-100);
    border-color: var(--color-ink-400);
  }

  .cookie-banner__btn--primary {
    background: var(--color-ink-900);
    border-color: var(--color-ink-900);
    color: var(--color-paper-50);
  }

  .cookie-banner__btn--primary:hover {
    background: var(--color-ink-700);
    border-color: var(--color-ink-700);
  }

  @media (max-width: 480px) {
    .cookie-banner__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
    }

    .cookie-banner__actions {
      width: 100%;
    }

    .cookie-banner__btn {
      flex: 1;
      text-align: center;
    }
  }
</style>
