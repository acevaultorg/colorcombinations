---
/**
 * PaintThisPalette — intent-matched art-supply shelf.
 *
 * Context: the Amazon read for `colorcombinations-20` was ~87 clicks → 0
 * orders, ~50 of them on the Sanzo Wada volumes ($40-60 Japanese imports of
 * a catalogue this site gives away free). The click surface works; the
 * product match does not. Someone reading a colour plate is usually about
 * to MAKE something, not to buy an out-of-print import.
 *
 * So this carries the materials a colour study actually gets made with,
 * placed at the moment the reader has the hex codes in hand.
 *
 * Compliance (Amazon Associates operating agreement + FTC):
 *  - no prices rendered anywhere (prices go stale and are not permitted)
 *  - no product images (image use requires the Product Advertising API)
 *  - rel="sponsored nofollow noopener" on every outbound link
 *  - disclosure adjacent to the links, in every variant
 *  - no scarcity language, no"click to support us"
 *
 * Measurement: clicks carry data-event="amazon_click" + data-tool, so supply
 * clicks are separable from book clicks (data-book) in Clarity/GA4 — the
 * whole point is to find out which shelf the audience actually wants.
 */

import { AMAZON, ART_SUPPLIES, PRIME_BOUNTY, type ArtSupply } from"@/config/monetization";

export interface Props {
  title?: string;
  intro?: string;
  /** Cap the number of items rendered. */
  limit?: number;
  /** Rotate the starting item so different palette pages lead with different tools. */
  offset?: number;
  /** Layout variant. */
  variant?:"full" |"sidebar" |"destination";
  /**
   * Short slug forwarded as `?c=` on every /go/ link, which the worker
   * re-appends as `&ascsubtag=` on whichever marketplace it resolves to.
   *
   * WHY THIS EXISTS (2026-09-03). This variant's subtag was hardcoded to
   * "palette-destination", so by today six different surfaces — /palettes/,
   * /colors/, /trends/color-trends-2026 and all six /tools/ result pages —
   * were reporting as ONE bucket. The next per-tag Associates read could not
   * have answered which of them converts, which is the same failure
   * FurtherReading already solved with its own `pageClass` prop (see the note
   * at its Props). Only 112 of 355 beacon clicks carry a position label at
   * all, so collapsing surfaces on top of that makes the sparse signal
   * useless.
   *
   * Defaults preserve the previous values exactly, so /palettes/ keeps
   * continuity with the data already collected under "palette-destination"
   * and the full/sidebar shelves keep "art-supplies".
   */
  pageClass?: string;
}

const {
  title ="Paint this palette",
  intro,
  limit,
  offset = 0,
  variant ="full",
  pageClass,
} = Astro.props;

// Preserve the historical defaults per variant when no override is given.
const destTag = pageClass ??"palette-destination";
const shelfTag = pageClass ??"art-supplies";

// Deterministic rotation — stable per URL (no randomness, so the HTML is
// cacheable and the same reader sees the same shelf on reload), but spread
// across the catalogue so every tool gets impressions somewhere.
const items: ArtSupply[] = (() => {
  const n = ART_SUPPLIES.length;
  const start = ((offset % n) + n) % n;
  const rotated = [...ART_SUPPLIES.slice(start), ...ART_SUPPLIES.slice(0, start)];
  return typeof limit ==="number" ? rotated.slice(0, limit) : rotated;
})();

/**
 * DESTINATION variant — one verdict per destination, instead of a flat shelf.
 *
 * Why this exists (measured, per-tag report 2026-09-01, window Aug 03 - Sep 01):
 * this site's constraint is NOT the call-to-action and NOT conversion. It is
 * basket size.
 *
 *   425 clicks -> 42 orders -> 9.88%  (the fleet's best conversion rate)
 *   $27.25 US commission               = $0.065 per click, the fleet's lowest
 *   ~$21 average item                  vs fitmylens at ~$379/item, $0.55/click
 *
 * 251 of those 425 clicks went to three books at ~$20 each, earning ~$23. The
 * catalogue already contains the genuine high-basket end of the SAME intent
 * (the print and calibrate groups), but the rotating shelf shows an arbitrary
 * two of ten, so a given page often surfaces two of the cheapest items.
 *
 * This variant guarantees each of the three destinations is represented once,
 * with an explicit verdict rather than a list — the reader self-selects on
 * where their palette is going, which is a real question they already have.
 * Rotation still happens WITHIN each group via `offset`, so impressions stay
 * spread and the HTML stays deterministic per URL (cacheable).
 *
 * No prices are rendered here, as everywhere else — Amazon's operating
 * agreement forbids it and stale prices are worse than none.
 */
const DESTINATIONS: { key: ArtSupply["group"]; label: string; verdict: string }[] = [
  {
    key:"print",
    label:"...onto paper",
    verdict:"Start here if the palette gets printed. Screen colour and ink colour are not the same colour, and this is the deck that translates between them.",
  },
  {
    key:"calibrate",
    label:"...onto a screen you can trust",
    verdict:"Start here if it stays digital. An uncalibrated monitor is the single most common reason a palette that looked right on your desk looks wrong everywhere else.",
  },
  {
    key:"paint",
    label:"...by hand",
    verdict:"Start here if you are mixing it. Wada's plates were flat printed colour; gansai pans are the closest everyday medium to them.",
  },
];

const destinations = DESTINATIONS.map((d) => {
  const pool = ART_SUPPLIES.filter((a) => a.group === d.key);
  if (pool.length === 0) return null;
  // Deterministic pick within the group — same URL always yields the same item.
  const item = pool[(((offset % pool.length) + pool.length) % pool.length)]!;
  return { ...d, item };
}).filter((d): d is typeof d & { item: ArtSupply } => d !== null);
---

<section class:list={["paint-kit", `paint-kit--${variant}`]}>
  <header class="paint-kit__head">
    <p class="eyebrow">Studio</p>
    <h2 class="text-balance">{title}</h2>
    {intro && <p class="paint-kit__intro">{intro}</p>}
  </header>

  {variant ==="destination" ? (
    <ul class="paint-kit__dest" role="list">
      {destinations.map(({ label, verdict, item }) => (
        <li class="paint-kit__dest-item">
          <p class="paint-kit__dest-label">{label}</p>
          <p class="paint-kit__dest-verdict">{verdict}</p>
          <p class="paint-kit__brand">{item.brand}</p>
          <h3 class="paint-kit__name">
            <a
              href={AMAZON.link(item.amazonAsin, destTag)}
              rel="sponsored nofollow noopener"
              target="_blank"
              data-event="amazon_click"
              data-tool={item.name}
              aria-label={`${item.name} by ${item.brand} on Amazon`}
            >
              {item.name}
            </a>
          </h3>
          {/*
            The catalogue `why` is deliberately NOT rendered here. Measured at
            375px it made the block 1175px tall — about 1.5 phone screens of
            commerce mid-article — and it was largely REPEATING the verdict
            above it ("this is the deck that translates between them" vs "this
            is the shared vocabulary between you and the press"). Cutting it is
            shorter and it is better writing; the verdict already carries the
            reason. The full `why` still renders in the "full" and "sidebar"
            variants, where it is the only explanation present.
          */}
          <a
            href={AMAZON.link(item.amazonAsin, destTag)}
            rel="sponsored nofollow noopener"
            target="_blank"
            class="btn btn-secondary paint-kit__link"
            data-event="amazon_click"
            data-tool={item.name}
            aria-label={`${item.name} by ${item.brand} on Amazon`}
          >
            View on Amazon <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
  <ul class="paint-kit__list" role="list">
    {items.map((item) => (
      <li class="paint-kit__item">
        <p class="paint-kit__brand">{item.brand}</p>
        <h3 class="paint-kit__name">
          <a
            href={AMAZON.link(item.amazonAsin, shelfTag)}
            rel="sponsored nofollow noopener"
            target="_blank"
            class=""
            data-event="amazon_click"
            data-tool={item.name}
            aria-label={`${item.name} by ${item.brand} on Amazon`}
          >
            {item.name}
          </a>
        </h3>
        <p class="paint-kit__why">{item.why}</p>
        {(
          <a
            href={AMAZON.link(item.amazonAsin, shelfTag)}
            rel="sponsored nofollow noopener"
            target="_blank"
            class="btn btn-secondary paint-kit__link"
            data-event="amazon_click"
            data-tool={item.name}
          >
            View on Amazon <span aria-hidden="true">↗</span>
          </a>
        )}
      </li>
    ))}
  </ul>
  )}

  {/*
    Prime free-trial bounty — a FLAT fee per sign-up, so it is unaffected by
    the ~$0.46 average commission the shelf above earns per order. Raw href
    on purpose: bounties must not be routed through /go/, and the linkId is
    SiteStripe-issued and byte-exact. data-from="prime-bounty" is what
    amazon-track.js reads to score this click as shelf="prime" — the only
    measurement available, since bounties always report under `Others`.
  */}
  <aside class="paint-kit__prime">
    <p class="paint-kit__prime-pitch">{PRIME_BOUNTY.pitch}</p>
    <a
      href={PRIME_BOUNTY.url}
      rel="sponsored nofollow noopener"
      target="_blank"
      class="btn btn-secondary paint-kit__prime-link"
      data-from="prime-bounty"
    >
      {PRIME_BOUNTY.cta} <span aria-hidden="true">↗</span>
    </a>
    <p class="paint-kit__prime-disclosure">{PRIME_BOUNTY.disclosure}</p>
  </aside>

  <p class="paint-kit__disclosure">
    Amazon Associates affiliate links — your price is unchanged and a small
    commission keeps the archive free. As an Amazon Associate we earn from
    qualifying purchases.
  </p>
</section>

<style>
  .paint-kit {
    padding-block: var(--spacing-section);
  }

  .paint-kit--sidebar {
    padding-block: 0;
  }

  /* ── destination variant ────────────────────────────────────────────────
     Three cards, one per destination. Grid at >=760px so the three verdicts
     are comparable side by side; a single stacked column below that, where
     comparison is impossible anyway and vertical rhythm reads better.
     Buttons are min-height 44px per the fleet mobile standard. */
  .paint-kit__dest {
    display: grid;
    /* auto-fit against the CONTAINER, not the viewport. A viewport media query
       is wrong here: .palette-body becomes `minmax(0,1fr) 22rem` at >=960px, so
       between ~960 and ~1100px the prose column is only ~550-650px wide while a
       `min-width: 760px` query would already be forcing three columns into it
       (~170px each). auto-fit gives 1 column at 375px, 2 in a narrow prose
       column, 3 when there is genuinely room — with no breakpoint to guess. */
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paint-kit__dest-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 1.1rem;
    border-top: 2px solid var(--rule, currentColor);
  }

  .paint-kit__dest-label {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .paint-kit__dest-verdict {
    margin: 0 0 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  .paint-kit__dest-item .paint-kit__link {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 14px;
  }

  .paint-kit__head {
    max-width: 58ch;
    margin-bottom: 2rem;
  }

  .paint-kit--sidebar .paint-kit__head {
    margin-bottom: 0.875rem;
  }

  .paint-kit__head .eyebrow {
    margin-bottom: 0.75rem;
  }

  .paint-kit__head h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw + 1rem, 2.25rem);
    line-height: 1.15;
    margin: 0;
  }

  .paint-kit--sidebar .paint-kit__head h2 {
    font-size: 1rem;
    font-weight: 500;
  }

  .paint-kit__intro {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-ink-700);
    line-height: 1.65;
    margin-top: 1rem;
  }

  .paint-kit--sidebar .paint-kit__intro {
    font-size: 0.9375rem;
    margin-top: 0.5rem;
  }

  .paint-kit__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .paint-kit--full .paint-kit__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .paint-kit--full .paint-kit__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .paint-kit--sidebar .paint-kit__list {
    gap: 0.875rem;
  }

  .paint-kit__item {
    padding: 1.25rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }

  .paint-kit--sidebar .paint-kit__item {
    padding: 0.875rem 1rem;
  }

  .paint-kit__brand {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin: 0 0 0.35rem;
  }

  .paint-kit__name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
  }

  .paint-kit--sidebar .paint-kit__name {
    font-size: 0.9375rem;
  }

  .paint-kit__name a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .paint-kit__name a:hover,
  .paint-kit__name a:focus-visible {
    border-bottom-color: currentColor;
  }

  .paint-kit__why {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-700);
    margin: 0.5rem 0 0;
  }

  .paint-kit--sidebar .paint-kit__why {
    font-size: 0.8125rem;
    margin-top: 0.35rem;
  }

  .paint-kit__link {
    margin-top: 1rem;
    min-height: 44px;
  }

  /* The money page (/palettes/[slug]) renders this in the sidebar variant.
     Before 2026-08-25 the button was gated to variant="full", so the only
     Amazon affordance there was a text link. Full-width button on the
     conversion surface. */
  .paint-kit--sidebar .paint-kit__link {
    display: flex;
    width: 100%;
    justify-content: center;
    margin-top: 0.75rem;
  }

  @media (max-width: 719px) {
    .paint-kit__link {
      display: flex;
      width: 100%;
      justify-content: center;
      margin-top: 0.875rem;
    }
  }

  .paint-kit__name a {
    display: inline-block;
    padding-block: 0.5rem;
  }

  .paint-kit__disclosure {
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--color-ink-700);
    margin-top: 1.25rem;
    max-width: 60ch;
  }

  .paint-kit--sidebar .paint-kit__disclosure {
    font-size: 0.8125rem;
    line-height: 1.55;
    margin-top: 0.75rem;
  }

  /* Prime free-trial bounty — set apart from the commission shelf so it reads
     as a delivery note, not a sixth product. Quiet by design: the museum
     identity forbids anything that looks like an ad slot. */
  .paint-kit__prime {
    margin-top: 1.5rem;
    padding: 0.9rem 1.05rem;
    border-left: 3px solid var(--color-ink-300, #c9c9c4);
    border-radius: 0 6px 6px 0;
    background: var(--color-paper-100, #f7f7f4);
  }

  .paint-kit__prime-pitch {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    max-width: 60ch;
    color: var(--color-ink-800, #2b2b28);
  }

  .paint-kit__prime-link {
    margin-top: 0.75rem;
    /* 44px minimum touch target — fleet mobile standard. */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .paint-kit__prime-disclosure {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-700);
    max-width: 60ch;
  }

  .paint-kit--sidebar .paint-kit__prime {
    margin-top: 1.1rem;
    padding: 0.8rem 0.9rem;
  }

  .paint-kit--sidebar .paint-kit__prime-link {
    width: 100%;
    justify-content: center;
  }
</style>
