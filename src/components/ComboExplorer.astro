---
/**
 * ComboExplorer — the homepage's visit-only hook (board task mte98o0rp7buo2).
 *
 * WHY: Bing AI Performance (pulled 2026-08-29) shows the homepage alone holds
 * 13.4K of the site's 26.7K 3-month citations (50%) on definitional queries
 * ("dictionary of color combinations") that an AI answer satisfies inline —
 * citation→visit CTR leaks. This grid is something a chat answer can't be:
 * every archive color, tappable, instantly showing every documented
 * combination it appears in, each linking to the full plate.
 *
 * CWV discipline: the swatch grid renders server-side (no JS to appear);
 * the dataset (/data/explorer.json) is fetched only on the FIRST interaction;
 * the results panel has a reserved min-height so nothing shifts.
 */
import { allColors } from "@/data/colors";
const colors = allColors().sort((a, b) => b.paletteCount - a.paletteCount);
---

<section class="explorer section" id="explorer" aria-labelledby="explorer-heading">
  <div class="container">
    <header class="explorer-head">
      <h2 id="explorer-heading">Find every combination for a color</h2>
      <p>
        Tap any of the {colors.length} archive colors to see each documented
        combination it appears in — every result links to the full plate with
        hex values.
      </p>
    </header>
    <div class="ex-grid" id="ex-grid" role="listbox" aria-label="Archive colors">
      {
        colors.map((c) => (
          <button
            class="ex-sw"
            type="button"
            data-name={c.name}
            style={`background:${c.hex}`}
            title={`${c.name} — ${c.paletteCount} combination${c.paletteCount === 1 ? "" : "s"}`}
            aria-label={`${c.name}, ${c.paletteCount} combination${c.paletteCount === 1 ? "" : "s"}`}
          />
        ))
      }
    </div>
    <div class="ex-results" id="ex-results" aria-live="polite">
      <p class="ex-hint">Pick a color above — its combinations appear here.</p>
    </div>
  </div>
</section>

<style is:global>
  .explorer-head p {
    max-width: 56ch;
  }
  .ex-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-height: 172px;
    overflow-y: auto;
    padding: 4px;
    border-radius: 10px;
    margin: 1.25rem 0 1rem;
  }
  .ex-sw {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    cursor: pointer;
    padding: 0;
    transition: transform 0.08s ease;
  }
  .ex-sw:hover,
  .ex-sw:focus-visible {
    transform: scale(1.18);
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }
  .ex-sw[aria-pressed="true"] {
    outline: 3px solid #111;
    outline-offset: 1px;
  }
  .ex-results {
    min-height: 180px;
  }
  .ex-hint {
    opacity: 0.7;
    font-size: 0.95rem;
  }
  .ex-title {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }
  .ex-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ex-card {
    display: block;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--card, #fff);
  }
  .ex-card:hover .ex-card-name {
    text-decoration: underline;
  }
  .ex-strip {
    display: flex;
    height: 44px;
  }
  .ex-strip span {
    flex: 1;
  }
  .ex-card-name {
    display: block;
    padding: 8px 10px;
    font-size: 0.85rem;
    line-height: 1.3;
  }
  @media (max-width: 640px) {
    .ex-sw {
      width: 44px;
      height: 44px;
      min-width: 44px;
    }
    .ex-grid {
      max-height: 208px;
    }
  }
</style>

{/* type="module" added 2026-09-04 (LCP fix mtncwponxsc3i5): the dataset fetch is already
    first-interaction-lazy (see doc comment above); the listener setup itself has no reason
    to run during initial paint. Deferring via module semantics only. */}
<script is:inline type="module">
  (function () {
    var grid = document.getElementById("ex-grid");
    var results = document.getElementById("ex-results");
    if (!grid || !results) return;
    var data = null;
    var loading = null;
    function load() {
      if (data) return Promise.resolve(data);
      if (!loading)
        loading = fetch("/data/explorer.json")
          .then(function (r) {
            return r.json();
          })
          .then(function (d) {
            data = d;
            return d;
          });
      return loading;
    }
    grid.addEventListener("click", function (ev) {
      var btn = ev.target.closest("button.ex-sw");
      if (!btn) return;
      var name = btn.getAttribute("data-name");
      grid.querySelectorAll("[aria-pressed]").forEach(function (b) {
        b.removeAttribute("aria-pressed");
      });
      btn.setAttribute("aria-pressed", "true");
      results.innerHTML = '<p class="ex-hint">Loading combinations…</p>';
      load()
        .then(function (d) {
          var entry = null;
          for (var i = 0; i < d.c.length; i++)
            if (d.c[i].n === name) {
              entry = d.c[i];
              break;
            }
          if (!entry || !entry.p.length) {
            results.innerHTML =
              '<p class="ex-hint">No documented combinations found for ' +
              name +
              ".</p>";
            return;
          }
          var html =
            '<h3 class="ex-title">' +
            name +
            " appears in " +
            entry.p.length +
            " combination" +
            (entry.p.length === 1 ? "" : "s") +
            ':</h3><ul class="ex-cards">';
          entry.p.forEach(function (idx) {
            var pal = d.p[idx];
            if (!pal) return;
            var strip = pal.h
              .map(function (hx) {
                return '<span style="background:' + hx + '"></span>';
              })
              .join("");
            html +=
              '<li><a class="ex-card" href="/palettes/' +
              pal.s +
              '/"><span class="ex-strip">' +
              strip +
              '</span><span class="ex-card-name">' +
              pal.t +
              "</span></a></li>";
          });
          html += "</ul>";
          results.innerHTML = html;
          try {
            if (window.gtag)
              gtag("event", "explorer_use", { color_name: name });
            if (window.clarity) clarity("event", "ExplorerUse");
          } catch (e) {}
        })
        .catch(function () {
          results.innerHTML =
            '<p class="ex-hint">Could not load the combinations — please refresh and try again.</p>';
        });
    });
  })();
</script>
