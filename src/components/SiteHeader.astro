---
const { pathname } = Astro.url;
const isActive = (href: string): boolean => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};

const links = [
  { href: "/browse", label: "Browse" },
  { href: "/colors", label: "Colors" },
  { href: "/collections", label: "Collections" },
  { href: "/paintings", label: "Paintings" },
  { href: "/tools", label: "Tools" },
  { href: "/learn", label: "Learn" },
  { href: "/about", label: "About" },
  { href: "/shop", label: "Shop" },
] as const;
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-header__brand" aria-label="The Dictionary of Color Combinations — home">
      <span class="site-header__mark" aria-hidden="true">
        <span class="site-header__dot" style="background-color: #9A2A2A;"></span>
        <span class="site-header__dot" style="background-color: #1B2A4E;"></span>
        <span class="site-header__dot" style="background-color: #F4EEE0;"></span>
      </span>
      <span class="site-header__wordmark">The Dictionary of<br />Color Combinations</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {/* Desktop (≥768px): the 7 links inline. */}
      <ul class="site-header__nav-desktop">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={`site-header__link ${isActive(href) ? "is-active" : ""}`}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      {/* Mobile (<768px): zero-JS <details> collapse. The 7 links are a
          nowrap flex row (~700px) that overflows a 375px header; this
          collapses them behind a "Menu" toggle. Open = an absolutely-
          positioned dropdown (overlays, no reflow → no CLS). */}
      <details class="site-header__nav-mobile">
        <summary class="site-header__nav-toggle" aria-label="Browse navigation">Menu</summary>
        <ul>
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class={`site-header__link ${isActive(href) ? "is-active" : ""}`}
                aria-current={isActive(href) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-paper-50);
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: saturate(120%) blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-ink-900);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.15;
    text-decoration: none;
    letter-spacing: -0.005em;
  }

  .site-header__brand:hover {
    color: var(--color-ink-900);
  }

  .site-header__mark {
    display: inline-flex;
    flex-direction: row;
    gap: 2px;
  }

  .site-header__dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 1px;
    border: 1px solid rgba(20, 20, 20, 0.08);
  }

  .site-header__wordmark {
    white-space: nowrap;
  }

  @media (max-width: 400px) {
    .site-header__wordmark {
      display: none;
    }
  }

  .site-header__nav-desktop {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  /* Mobile nav collapse (zero-JS). The 7 nowrap links (~700px) overflow a
     375px header; below 768px they collapse behind a <details> "Menu" toggle
     and the inline rail is hidden. The 768px media query flips it. */
  .site-header__nav-mobile {
    position: relative;
    display: none;
  }
  .site-header__nav-toggle {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-700);
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    user-select: none;
  }
  .site-header__nav-toggle::-webkit-details-marker {
    display: none;
  }
  .site-header__nav-mobile[open] .site-header__nav-toggle {
    color: var(--color-ink-900);
    border-color: var(--color-ink-900);
  }
  .site-header__nav-mobile ul {
    list-style: none;
    margin: 0;
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 11rem;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-paper-50);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(20, 20, 20, 0.12);
    z-index: 50;
  }
  .site-header__nav-mobile .site-header__link {
    padding-block: 0.4rem;
  }

  @media (max-width: 767px) {
    .site-header__nav-desktop {
      display: none;
    }
    .site-header__nav-mobile {
      display: block;
    }
  }

  .site-header__link {
    color: var(--color-ink-700);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .site-header__link:hover {
    color: var(--color-ink-900);
    border-bottom-color: var(--color-ink-900);
  }

  .site-header__link.is-active {
    color: var(--color-ink-900);
    border-bottom-color: var(--color-accent-500);
  }
</style>
