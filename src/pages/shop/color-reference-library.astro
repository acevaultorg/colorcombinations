---
/**
 * /shop/color-reference-library — standalone curated-buyable-list page.
 *
 * Distinct from /shop (which stays untouched): /shop converts at 73.3%
 * (55 Amazon clicks / 75 users, 30d GA4) — the highest-converting shape on
 * the site — but it is one page carrying the whole book rail while /browse
 * and /colors (2,862 humans/mo combined) convert at 0.6-0.9%, mid-task
 * rather than in a buying mindset. This page targets readers who arrive
 * already looking for a named reference work — "Sanzo Wada colour
 * dictionary", "Munsell colour system", "Pantone colour reference" — and
 * gives /browse + /colors a second, deliberate entry point into that same
 * buying mindset via ShelfCallout banners.
 *
 * Item selection + verification discipline documented at
 * COLOR_REFERENCE_LIBRARY in src/config/monetization.ts.
 *
 * Compliance (shared Associates account — one breach risks the fleet):
 * tag on every link via AMAZON.link(), rel="sponsored nofollow noopener",
 * FTC disclosure (rendered unconditionally by FurtherReading), no price,
 * no scarcity language, no invented facts.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import FurtherReading from "@components/FurtherReading.astro";
import { COLOR_REFERENCE_LIBRARY } from "@/config/monetization";

const title = "The Color Reference Library";
const description =
  "Six reference works worth owning outright — Sanzo Wada's dictionary, Josef Albers on color interaction, a Munsell-notation field guide, Pantone's design history, and the 1821 colour dictionary that came a century before Wada's.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: new URL("/shop/color-reference-library/", Astro.site).toString(),
    isPartOf: {
      "@type": "WebSite",
      name: "The Dictionary of Color Combinations",
      url: Astro.site?.toString(),
    },
    numberOfItems: COLOR_REFERENCE_LIBRARY.length,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    numberOfItems: COLOR_REFERENCE_LIBRARY.length,
    itemListElement: COLOR_REFERENCE_LIBRARY.map((book, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Book",
        name: book.title,
        author: { "@type": "Person", name: book.author },
        ...(book.isbn ? { isbn: book.isbn } : {}),
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Shop", item: new URL("/shop/", Astro.site).toString() },
      { "@type": "ListItem", position: 3, name: "Color Reference Library" },
    ],
  },
];
---

<BaseLayout title={title} description={description} image="/og-default.png" jsonLd={jsonLd} adContent>
  {/* ============ HERO ============ */}
  <section class="crl-hero">
    <div class="container-wide crl-hero__inner">
      <nav class="crl-crumbs" aria-label="Breadcrumb">
        <a href="/shop/">Shop</a>
        <span aria-hidden="true">→</span>
        <span>Color Reference Library</span>
      </nav>
      <p class="eyebrow">Named references</p>
      <h1 class="display-hero text-balance">
        Six books worth owning outright.
      </h1>
      <p class="crl-hero__lede">
        The archive stays free — every plate, every hex value, no login. This
        shelf is different from the general
        {" "}<a href="/shop/">shop</a>: it is the reading list for someone who
        already knows they want a Sanzo Wada dictionary on the desk, an Albers
        for the studio, or the field guide built on Munsell's own notation.
        Six works, none of them out of print, none of them duplicated on this
        page for padding.
      </p>
    </div>
  </section>

  {/* ============ THE SHELF ============ */}
  <section class="container-wide">
    <FurtherReading
      books={COLOR_REFERENCE_LIBRARY}
      pageClass="color-reference-library"
      variant="full"
      title="The reference shelf"
      intro="Six works, chosen for what they do that the free archive doesn't: a printed original, a working theory, a system of notation, a design history, a precedent a century older than Wada's."
    />
  </section>

  {/* ============ WHY THESE SIX ============ */}
  <section class="crl-note section">
    <div class="container-prose crl-note__inner">
      <p class="eyebrow">Why these six</p>
      <p>
        Wada's own dictionary — both volumes — is the obvious anchor: this
        whole site is a digitisation of Vol. 1, and Vol. 2's plates aren't in
        it. Albers explains the relational effect Wada's plates only show.
        Gurney's field guide is the practical, working-painter's route into
        Munsell's hue/value/chroma notation, honestly billed as a guide
        <em>built on</em> the system rather than written by Munsell himself.
        Pantone's own history traces the twentieth century in colour. And
        Werner's 1821 nomenclature — the book Darwin carried on the Beagle —
        is the same instinct as this whole archive, a full century before
        Wada's version of it.
      </p>
      <p>
        Not every colour book belongs here — the general shelf on
        {" "}<a href="/shop/">the shop page</a> covers wider ground. This one
        is deliberately six, deliberately named, deliberately references
        rather than survey reading.
      </p>
    </div>
  </section>

  {/* ============ MORE FROM THE ARCHIVE ============ */}
  <section class="crl-more section">
    <div class="container-wide crl-more__inner">
      <p class="eyebrow">Keep exploring</p>
      <div class="crl-more__links">
        <a href="/browse/">Browse all palettes →</a>
        <a href="/colors/">The color dictionary →</a>
        <a href="/shop/">The full shop →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crl-hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }

  .crl-hero__inner {
    max-width: 62rem;
  }

  .crl-crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-500);
    margin-bottom: 1.5rem;
  }

  .crl-crumbs a {
    color: var(--color-ink-500);
    text-decoration: none;
  }

  .crl-crumbs a:hover {
    color: var(--color-accent-500);
    text-decoration: underline;
  }

  .crl-hero .eyebrow {
    margin-bottom: 1.5rem;
  }

  .crl-hero__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.4vw + 0.75rem, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-700);
    max-width: 58ch;
    margin-top: 1.75rem;
  }

  .crl-hero__lede a {
    color: var(--color-accent-500);
  }

  /* ---- Why these six ---- */
  .crl-note {
    background-color: var(--color-paper-50);
    border-block: 1px solid var(--color-border);
  }

  .crl-note__inner {
    max-width: 62ch;
    padding-block: 2rem;
  }

  .crl-note__inner p {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink-700);
    margin-bottom: 1.25rem;
  }

  .crl-note__inner a {
    color: var(--color-accent-500);
  }

  .crl-note .eyebrow {
    margin-bottom: 1rem;
  }

  /* ---- Keep exploring ---- */
  .crl-more__inner {
    max-width: 62rem;
  }

  .crl-more .eyebrow {
    margin-bottom: 1rem;
  }

  .crl-more__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
  }

  .crl-more__links a {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-ink-900);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.125rem;
  }

  .crl-more__links a:hover {
    color: var(--color-accent-500);
    border-color: var(--color-accent-500);
  }
</style>
