---
import BaseLayout from "@layouts/BaseLayout.astro";
import { PAID_API } from "@/config/monetization";
import { allPalettes } from "@data/palettes";
import { collections } from "@data/collections";

const total = allPalettes().length;
const totalCollections = collections.length;

const title = "JSON API — docs + pricing";
const description = `Free JSON API for every one of ${total} palettes + ${totalCollections} collections. Commercial tier for bulk access + legal license.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: new URL("/api-docs", Astro.site).toString(),
    author: { "@id": "https://colorcombinations.org/#organization" },
    publisher: { "@id": "https://colorcombinations.org/#organization" },
    datePublished: "2026-04-20",
    dateModified: "2026-04-20",
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "Commercial JSON API — Dictionary of Color Combinations",
    description: "Bulk access + formal commercial-use license for the 378-palette dataset.",
    brand: { "@id": "https://colorcombinations.org/#organization" },
    offers: {
      "@type": "Offer",
      price: "19.00",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "19.00",
        priceCurrency: "USD",
        billingDuration: "P1M",
        billingIncrement: 1,
      },
    },
  },
];

const apiCheckoutUrl = PAID_API.isLive ? PAID_API.checkoutUrl : "#contact";
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="api-docs">
    <div class="container-prose">
      <header class="api-docs__header">
        <p class="eyebrow">Developer</p>
        <h1 class="text-balance">JSON API — 378 palettes, five collections endpoints, zero paywall on the basics.</h1>
        <p class="api-docs__lede">
          Every palette has a JSON twin at <code>/api/v1/palettes/[slug].json</code>.
          Free forever. CORS open. Cached at the Cloudflare edge.
          For commercial products redistributing the data, the <a href="#commercial">$19/mo Commercial License</a> gives you a signed legal right + bulk endpoint + priority support.
        </p>
      </header>

      <section id="tiers">
        <h2>Two tiers</h2>
        <div class="tiers-grid">
          <div class="tier">
            <p class="tier-eyebrow">Free</p>
            <h3>Public API</h3>
            <p class="tier-price"><span class="tier-amount">$0</span></p>
            <ul>
              <li>All 378 palette endpoints</li>
              <li>All 30+ collection endpoints</li>
              <li>CORS open for browser-side fetch</li>
              <li>100 req/day soft cap per IP (Cloudflare zone)</li>
              <li>No auth, no key, no sign-up</li>
              <li>Cached at Cloudflare edge (fast from anywhere)</li>
            </ul>
          </div>
          <div class="tier tier--paid">
            <p class="tier-eyebrow">Commercial</p>
            <h3>Commercial License</h3>
            <p class="tier-price">
              <span class="tier-amount">$19</span>
              <span class="tier-period">/month</span>
            </p>
            <ul>
              <li>Everything in Free</li>
              <li>Bulk endpoint: <code>/api/v1/bulk</code> — all 378 in one call</li>
              <li>10,000 req/day (soft cap, contact for more)</li>
              <li>Signed commercial-use license agreement</li>
              <li>Right to redistribute editorial palettes (the 30 non-Wada entries)</li>
              <li>Priority email support</li>
              <li>Supports the archive directly</li>
            </ul>
            <p class="tier-cta">
              <a
                class="btn-primary"
                href={apiCheckoutUrl}
                target={PAID_API.isLive ? "_blank" : "_self"}
                rel="noopener"
                data-event="api_checkout_click"
              >
                {PAID_API.isLive ? "Subscribe — $19/mo" : "Join the waitlist"}
              </a>
            </p>
          </div>
        </div>
        {!PAID_API.isLive && (
          <p class="api-docs__waitlist">
            Commercial subscription launches as soon as the Gumroad product is
            live. Email <a href="mailto:contact@colorcombinations.org?subject=API%20Commercial%20waitlist">
            contact@colorcombinations.org</a> to get notified.
          </p>
        )}
      </section>

      <section id="endpoints">
        <h2>Endpoints</h2>
        <dl class="api-endpoints">
          <dt><code>GET /api/v1/palettes</code></dt>
          <dd>Index of all 378 palettes, slim metadata. Returns JSON with <code>meta</code> + <code>data[]</code>.</dd>

          <dt><code>GET /api/v1/palettes/[slug].json</code></dt>
          <dd>Full palette record — title, Japanese original, summary, full color array with meanings, tags, usage notes.</dd>

          <dt><code>GET /api/v1/collections</code></dt>
          <dd>Index of all {totalCollections} thematic collections.</dd>

          <dt><code>GET /api/v1/collections/[slug].json</code></dt>
          <dd>Collection detail + ordered list of all palettes in that collection.</dd>

          <dt><code>GET /api/v1/bulk</code> <span class="paid-tag">Commercial only</span></dt>
          <dd>
            Single-response snapshot of every palette + every color name + every collection mapping.
            Pass <code>Authorization: Bearer [license-key]</code>.
            License key delivered by Gumroad after subscription. Under the hood: Cloudflare Worker verifies the key against Gumroad's license-verify API, caches verdict for 24 h.
          </dd>
        </dl>
      </section>

      <section id="examples">
        <h2>Quick examples</h2>

        <h3>curl — get one palette</h3>
        <pre class="api-code"><code>{`curl -s https://colorcombinations.org/api/v1/palettes/kurenai-kon.json | jq '.data.colors'`}</code></pre>

        <h3>JavaScript fetch — list all</h3>
        <pre class="api-code"><code>{`const r = await fetch("https://colorcombinations.org/api/v1/palettes");
const { data } = await r.json();
console.log(\`Loaded \${data.length} palettes\`);`}</code></pre>

        <h3>Python — one collection's palettes</h3>
        <pre class="api-code"><code>{`import requests
r = requests.get("https://colorcombinations.org/api/v1/collections/japanese.json")
for p in r.json()["data"]["palettes"]:
    print(p["title"], p["hex"])`}</code></pre>

        <h3>curl — commercial bulk (paid)</h3>
        <pre class="api-code"><code>{`curl -s https://colorcombinations.org/api/v1/bulk \\
  -H "Authorization: Bearer YOUR_LICENSE_KEY" \\
  -o all-378-palettes.json`}</code></pre>
      </section>

      <section id="commercial">
        <h2>Commercial use policy</h2>
        <p>
          All 378 palette hex values + Japanese color names are
          <strong> public-domain cultural commons</strong>. You don't technically
          need a license from us to use them in any commercial product.
        </p>
        <p>
          The Commercial License exists for two reasons:
        </p>
        <ol>
          <li>
            <strong>Legal clarity</strong> — if your product or SaaS
            redistributes the archive (e.g. a Figma plugin that bundles
            all 378 palettes, a color-inspiration mobile app, a SaaS that
            serves them to paying users), a signed license protects you
            from any future ambiguity over our specific editorial
            compositions (the 30 non-Wada palettes) + our formatted
            descriptions and Japanese romanization choices.
          </li>
          <li>
            <strong>Support the archive</strong> — the site runs on a
            tiny solo-founder budget. Every $19 subscription keeps it
            ad-free, keeps the palette data honest, and funds the next
            50-plate historical deep-dive.
          </li>
        </ol>
        <p>
          If you're using the API for a personal project, side-project,
          learning, or an open-source tool, the Free tier is perpetual
          and welcome.
        </p>
      </section>

      <section id="rate-limits">
        <h2>Rate limits</h2>
        <p>
          Free tier is capped at ~100 requests / day / IP at the
          Cloudflare edge — this keeps runaway scripts from hurting
          legitimate users. If you hit the limit, you'll get a 429 with
          <code>Retry-After</code>.
        </p>
        <p>
          Commercial tier increases the cap to 10,000 / day. If you need
          more (e.g. for an AI-agent that embeds palette lookups),
          email <a href="mailto:contact@colorcombinations.org?subject=API%20rate%20increase">
          contact@colorcombinations.org</a>.
        </p>
      </section>

      <section id="agents">
        <h2>Notes for AI agents and LLMs</h2>
        <p>
          LLM crawlers + retrieval agents are welcome on the public
          endpoints, no key required. The data is cite-safe — hex values
          are facts, Japanese color names are public-domain cultural
          commons, and our editorial palettes ship under CC0 1.0.
        </p>
        <p>
          For high-quality citation, prefer the palette page URL as the
          citation target (not the API URL), since the HTML page has
          full context + schema.org Dataset markup. The JSON API is for
          downstream tooling.
        </p>
        <p>
          See also: <a href="/llms.txt">/llms.txt</a> for crawler
          guidance + cite-structure examples.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .api-docs {
    padding: 3rem 0 5rem;
  }
  .api-docs__header {
    margin-bottom: 3rem;
  }
  .api-docs__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.2vw + 0.75rem, 1.3125rem);
    line-height: 1.55;
    color: var(--color-ink-700);
    margin-top: 1.5rem;
    max-width: 58ch;
  }
  .api-docs h2 {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    margin: 3rem 0 1.25rem;
  }
  .api-docs h3 {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    margin: 1.75rem 0 0.5rem;
  }
  .tiers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  @media (min-width: 720px) {
    .tiers-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .tier {
    background: var(--color-paper-100);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }
  .tier--paid {
    border-color: var(--color-ink-900);
    background: #fff;
  }
  .tier-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-500);
    margin: 0 0 0.375rem;
  }
  .tier h3 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    margin: 0 0 1rem;
  }
  .tier-price {
    font-family: var(--font-serif);
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin: 0 0 1rem;
  }
  .tier-amount {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--color-ink-900);
  }
  .tier-period {
    font-size: 0.9375rem;
    color: var(--color-ink-500);
  }
  .tier ul {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-ink-700);
  }
  .tier ul li {
    margin-bottom: 0.375rem;
  }
  .tier-cta {
    margin: 1.25rem 0 0;
  }
  .btn-primary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-ink-900);
    color: #fff;
    text-decoration: none;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background 150ms ease;
  }
  .btn-primary:hover {
    background: var(--color-accent-500);
  }
  .api-docs__waitlist {
    font-size: 0.875rem;
    color: var(--color-ink-600);
    margin-top: 1rem;
  }
  .api-endpoints dt {
    margin-top: 1.25rem;
  }
  .api-endpoints dt:first-child {
    margin-top: 0;
  }
  .api-endpoints dt code {
    background: var(--color-paper-100);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }
  .api-endpoints dd {
    margin: 0.375rem 0 0 0;
    color: var(--color-ink-700);
  }
  .paid-tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    margin-left: 0.5rem;
    background: var(--color-ink-900);
    color: #fff;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 999px;
    vertical-align: middle;
  }
  .api-code {
    background: var(--color-paper-100);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre;
    color: var(--color-ink-800);
  }
</style>
