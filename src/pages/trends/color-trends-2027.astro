---
/**
 * /trends/color-trends-2027 — the 2027 Color of the Year season, tracked live.
 *
 * Sibling to color-trends-2026.astro, which is the most-cited page in the fleet
 * (6,777 Bing impressions, ~96% of this site's AI citations). That page works
 * because it puts EVERY authority side by side instead of covering one. This
 * one does the same job for 2027 — with the difference that the 2027 season is
 * still running, so the page's honesty about what is NOT yet announced is part
 * of its value, not a gap in it.
 *
 * ZERO FABRICATION, and it constrains the design in two specific ways:
 *
 * 1. No invented hexes. Paint colours do not map to one exact sRGB value, and
 *    for two of the three picks below no hex has been published anywhere I
 *    could source. So a card NEVER claims to show you the brand's colour. It
 *    shows the closest colour in THIS archive — labelled as exactly that — and
 *    links to the brand's own page as the authoritative reference. The one
 *    sourced hex (Behr Grounded #5E5C50) is marked and still not presented as
 *    an exact match.
 *
 * 2. Sherwin-Williams "Rewild" is NOT filed as a Color of the Year, because it
 *    isn't one. It is their 2027 Colormix TREND FORECAST — 48 hues in three
 *    stories — and Sherwin-Williams' own announcement says the forecast is the
 *    foundation their Color of the Year is later drawn FROM. Several roundups
 *    have already blurred these two things together. This page keeps them
 *    apart, which is the kind of distinction that earns a citation.
 *
 * Each pick's on-site destination is a hue-family pairing page that ALREADY
 * EXISTS (verified 200 before shipping). It is deliberately not the
 * /colors-that-go-with/[pick-slug]/ pattern the 2026 page uses: those work
 * because the 14 2026 picks were added to commonColors in src/data/pairings.ts
 * with the authorities' own hexes. Doing that for 2027 needs hexes that are not
 * published yet — inventing them to unlock the link would be exactly the thing
 * pairings.ts forbids ("Nothing is invented"). When the hexes land, add the
 * entries there and repoint these cards.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import FurtherReading from "@components/FurtherReading.astro";

const siteUrl = "https://colorcombinations.org/";
const pageUrl = "https://colorcombinations.org/trends/color-trends-2027/";
const PUBLISHED = "2026-09-06T00:00:00Z";
// Verified 2026-09-06 against each brand's own announcement plus Forbes, HGTV,
// Young House Love and PR Newswire. Bump when the picks are re-checked or a new
// authority announces — never automatically. (Same rule as the 2026 page; there
// dateModified used to be the build clock, which asserted a content change on
// every deploy. Fixed 2026-09-06, commit 75dcb84.)
const VERIFIED = "2026-09-06";
const MODIFIED = `${VERIFIED}T00:00:00Z`;

const AUTHOR = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}#person-paulo-de-vries`,
  name: "Paulo de Vries",
  jobTitle: "Founder + editor, The Dictionary of Color Combinations",
  url: `${siteUrl}about/`,
  worksFor: { "@id": `${siteUrl}#organization` },
  sameAs: ["https://paulodevries.com/", "https://www.linkedin.com/in/paulomichaeldevries"],
};

interface Pick {
  brand: string;
  name: string;
  /** The brand's own colour code, or "—" where none has been published. */
  code: string;
  family: string;
  /** The brand's own description, not ours. */
  blurb: string;
  /** Authoritative reference — the brand's page. */
  url: string;
  announced: string;
  /** A sourced hex for this paint, where one exists. Never a guess. */
  sourcedHex: string | null;
  /** Closest colour in THIS archive. Its own hex — never presented as the paint's. */
  match: { slug: string; name: string; hex: string };
}

// Announced 2027 Colours of the Year, in announcement order.
// Names, codes and descriptions are each authority's own — see Sources.
const PICKS: Pick[] = [
  {
    brand: "Valspar",
    name: "Cottage Door",
    code: "8004-38E",
    family: "Grayed mid-tone blue",
    blurb:
      "A mid-tone neutral blue blending warm and cool undertones — Valspar frames it as soothing familiarity and comfortable respite, a trans-seasonal colour for thoughtful, introspective spaces.",
    url: "https://www.valspar.com/en/colors/color-of-the-year-2027",
    announced: "5 August 2026",
    sourcedHex: null,
    match: { slug: "blue", name: "Blue", hex: "#3E6FA3" },
  },
  {
    brand: "Dutch Boy",
    name: "Deep Rooted",
    code: "—",
    family: "Earthy orange",
    blurb:
      "An earthy orange — a genuinely rare choice for a Color of the Year — presented as a move toward grounding, authenticity and connection rather than the neutrals that dominated 2026.",
    url: "https://www.dutchboygroup.com",
    announced: "25 August 2026",
    sourcedHex: null,
    match: { slug: "terracotta", name: "Terracotta", hex: "#C66B3D" },
  },
  {
    brand: "Behr",
    name: "Grounded",
    code: "T27-01",
    family: "Mossy olive with brown undertones",
    blurb:
      "A mossy olive with earthy brown undertones under the theme “Rooted in Renewal” — Behr describes it as transforming everyday spaces into personal sanctuaries. Reads greyer in practice than “mossy olive” suggests.",
    url: "https://www.behr.com/colors/color-detail/t27-01",
    announced: "late August 2026",
    sourcedHex: "#5E5C50",
    match: { slug: "olive-green", name: "Olive Green", hex: "#708238" },
  },
];

// Authorities whose 2027 pick has NOT been announced at the verified date.
// Timing notes are the historical pattern, not a claim about 2027.
const PENDING = [
  { brand: "Pantone", note: "Announces in the first week of December, and is the one the rest of the industry reacts to." },
  { brand: "Benjamin Moore", note: "Announced its 2026 pick (Silhouette AF-655) in mid-October 2025." },
  { brand: "Sherwin-Williams", note: "Colour of the Year is drawn from the Rewild forecast below; announced separately, typically autumn." },
  { brand: "Glidden", note: "Typically announces in the autumn." },
  { brand: "Dulux", note: "Announces a ColourFutures pick, usually in September." },
  { brand: "Dunn-Edwards", note: "Announced its 2026 pick in the autumn." },
  { brand: "Graham & Brown", note: "Announces in the autumn." },
];

const faq = [
  {
    q: "What is the 2027 Color of the Year?",
    a: "There is no single one. Each authority names its own. As of 6 September 2026 three have announced for 2027: Valspar's Cottage Door (8004-38E), a grayed mid-tone blue; Dutch Boy's Deep Rooted, an earthy orange; and Behr's Grounded (T27-01), a mossy olive with brown undertones. Pantone — the most-cited of them — announces in the first week of December.",
  },
  {
    q: "Is Sherwin-Williams' Rewild the 2027 Color of the Year?",
    a: "No. Rewild is Sherwin-Williams' 2027 Colormix Trend Forecast — a 48-hue collection organised into three stories, Revive, Reignite and Reconnect. Sherwin-Williams' own announcement describes the forecast as the foundation that informs its upcoming Color of the Year, which is a separate, single-colour announcement. Several roundups have conflated the two.",
  },
  {
    q: "When are the rest of the 2027 colours announced?",
    a: "The season runs from roughly late July to early December. Valspar opened it on 5 August 2026 and Pantone traditionally closes it in the first week of December. Benjamin Moore, Sherwin-Williams, Glidden, Dulux and others fall in between, mostly across September to November.",
  },
  {
    q: "Why does this page not show the exact paint colour?",
    a: "Because publishing a hex we cannot source would be inventing it. Paint colours do not map to a single exact sRGB value, and for two of the three 2027 picks no hex has been published. Each card therefore shows the closest colour in this archive — labelled as that, with its own hex — and links to the brand's page as the authoritative reference.",
  },
  {
    q: "What is the emerging 2027 direction?",
    a: "Too early to call with three picks, and worth saying so. What is visible: all three are mid-tone and unmistakably earth-referenced — olive, terracotta-orange, and a blue with warm undertones — which continues rather than breaks the grounded, tactile half of the 2026 split. Whether that holds depends on Pantone in December.",
  },
];

const title = "The 2027 Colors of the Year — Every Pick Announced So Far";
const description =
  "Every 2027 Color of the Year announced so far, side by side: Valspar Cottage Door, Dutch Boy Deep Rooted and Behr Grounded — plus who has not announced yet and when they are expected. Verified 6 September 2026.";

const jsonLd = [
  AUTHOR,
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "The 2027 Colors of the Year — Every Pick Announced So Far",
    description,
    url: pageUrl,
    inLanguage: "en",
    datePublished: PUBLISHED,
    dateModified: MODIFIED,
    author: { "@id": `${siteUrl}#person-paulo-de-vries` },
    publisher: { "@id": `${siteUrl}#organization` },
    isPartOf: { "@id": `${siteUrl}#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "2027 Colors of the Year announced so far",
    description:
      "Official 2027 Color of the Year selections announced as of 6 September 2026. The season is ongoing.",
    numberOfItems: PICKS.length,
    itemListElement: PICKS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${p.brand}: ${p.name}${p.code !== "—" ? ` (${p.code})` : ""}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Trends", item: `${siteUrl}trends/color-trends-2027/` },
      { "@type": "ListItem", position: 3, name: "Colors of the Year 2027" },
    ],
  },
];
---

<BaseLayout
  adContent
  title={title}
  description={description}
  canonical={pageUrl}
  type="article"
  author="Paulo de Vries"
  publishedTime={PUBLISHED}
  modifiedTime={MODIFIED}
  keywords={[
    "2027 color of the year",
    "color trends 2027",
    "Behr Grounded",
    "Valspar Cottage Door",
    "Dutch Boy Deep Rooted",
    "Sherwin-Williams Rewild",
  ]}
  jsonLd={jsonLd}
>
  <article class="coty">
    <header class="coty-hero container-narrow">
      <p class="eyebrow">Color Report · 2027 · in progress</p>
      <h1 class="display-hero text-balance">The 2027 Colors of the Year</h1>
      <p class="coty-hero__lede">
        The 2027 season opened on 5 August 2026 and closes with Pantone in
        December. <strong>Three authorities have announced so far</strong> — and
        all three are mid-tone and earth-referenced. Here is every pick to date,
        what each brand actually said, and who is still to come.
      </p>
      <p class="coty-hero__meta">
        By <a class="coty-hero__byline" href="/about/" rel="author">Paulo de Vries</a>
        · Last verified <time datetime={VERIFIED}>6 September 2026</time>
        · {PICKS.length} announced · {PENDING.length} still to come · sources cited below
      </p>
    </header>

    <section class="mv-content container-narrow">
      <div class="coty-note">
        <p>
          <strong>This page is updated as the season runs.</strong> Every colour
          below is the authority's own name, code and description. Nothing here
          is a prediction — if a brand has not announced, it is listed under
          <a href="#pending">still to come</a> rather than guessed at.
        </p>
      </div>

      <ul class="coty-picks" role="list">
        {PICKS.map((p) => (
          <li class="coty-pick">
            <div
              class="coty-pick__swatch"
              style={`background-color:${p.match.hex}`}
              aria-hidden="true"
            ></div>
            <div class="coty-pick__body">
              <p class="coty-pick__brand">{p.brand} · announced {p.announced}</p>
              <h2 class="coty-pick__name">
                {p.name}
                {p.code !== "—" && <span class="coty-pick__code">{p.code}</span>}
              </h2>
              <p class="coty-pick__family">{p.family}</p>
              <p class="coty-pick__blurb">{p.blurb}</p>
              <p class="coty-pick__swatch-note">
                Swatch shows <strong>{p.match.name} {p.match.hex}</strong> — the closest
                colour in this archive, not {p.brand}'s paint.
                {p.sourcedHex
                  ? ` A hex of ${p.sourcedHex} has been reported for ${p.name}; treat it as an approximation, since paint does not map to one exact sRGB value.`
                  : ` No hex has been published for ${p.name} yet.`}
              </p>
              <p class="coty-pick__links">
                <a class="coty-pick__cta" href={`/colors-that-go-with/${p.match.slug}/walls/`}>
                  What goes with {p.match.name.toLowerCase()} →
                </a>
                <a class="coty-pick__ref" href={p.url} rel="nofollow noopener" target="_blank">
                  {p.brand}'s official page ↗
                </a>
              </p>
            </div>
          </li>
        ))}
      </ul>

      <h2 id="forecast">Sherwin-Williams Rewild is a forecast, not a Color of the Year</h2>
      <p>
        Worth separating, because it is being reported both ways. On 30 July 2026
        Sherwin-Williams introduced <strong>Rewild</strong>, its 2027 Colormix
        Trend Forecast: 48 hues organised into three stories — Revive, Reignite
        and Reconnect. Sherwin-Williams' own announcement describes the forecast
        as the foundation informing its Color of the Year and Colors of the Month
        programmes. In other words the single 2027 colour is drawn <em>from</em>
        Rewild and has not been named yet.
      </p>
      <p>
        The distinction matters if you are specifying paint: a forecast is a
        palette to work within, a Color of the Year is one colour to commit to.
      </p>

      <h2 id="pending">Still to come</h2>
      <p>
        Seven authorities tracked here have not announced a 2027 pick as of
        {" "}<time datetime={VERIFIED}>6 September 2026</time>. Timing notes below
        are each brand's historical pattern, not a claim about this year.
      </p>
      <ul class="coty-pending" role="list">
        {PENDING.map((b) => (
          <li>
            <strong>{b.brand}</strong> — {b.note}
          </li>
        ))}
      </ul>

      <h2 id="direction">What the first three suggest</h2>
      <p>
        Three picks is not a trend, and it would be easy to over-read them. What
        can be said honestly: all three are <strong>mid-tone</strong> rather than
        the very light or very dark ends, and all three are earth-referenced — a
        mossy olive, an earthy orange, and a blue that its own maker describes as
        carrying warm undertones. None is a clean, cool, bright hue.
      </p>
      <p>
        That continues one half of the 2026 story rather than reversing it. The
        2026 field split into serene weightless light (Pantone's Cloud Dancer) and
        grounded tactile earth (Benjamin Moore's Silhouette, Behr's Hidden Gem).
        So far 2027 is reading as the grounded half, without the light one. See
        <a href="/trends/color-trends-2026/"> the full 2026 set</a> for the
        comparison — and check back after Pantone announces in December, which is
        the pick most likely to decide whether that holds.
      </p>

      <h2 id="faq">Common questions</h2>
      <dl class="coty-faq">
        {faq.map((item) => (
          <>
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </>
        ))}
      </dl>

      <h2 id="sources">Sources &amp; methodology</h2>
      <p>
        Every name, code and description above is the authority's own, taken from
        its announcement or a first-hand report of it. Where two sources gave
        different announcement dates for Behr's pick (26 and 31 August), this page
        says “late August 2026” rather than pick one.
      </p>
      <ul class="coty-sources" role="list">
        <li>
          Valspar — <a href="https://www.valspar.com/en/colors/color-of-the-year-2027" rel="nofollow noopener" target="_blank">Color of the Year 2027: Cottage Door</a>,
          and Forbes, <a href="https://www.forbes.com/sites/rdaniel-foster/2026/08/05/valspar-kicks-off-2027-color-of-the-year-season-with-cottage-door/" rel="nofollow noopener" target="_blank">“Valspar Kicks Off 2027 Color Of The Year Season”</a> (5 August 2026).
        </li>
        <li>
          Dutch Boy — Forbes, <a href="https://www.forbes.com/sites/rdaniel-foster/2026/08/25/dutch-boy-2027-color-of-the-year-is-a-rare-orange-hue/" rel="nofollow noopener" target="_blank">“Dutch Boy 2027 Color Of The Year Is A Rare Orange Hue”</a> (25 August 2026).
        </li>
        <li>
          Behr — <a href="https://www.behr.com/colors/color-detail/t27-01" rel="nofollow noopener" target="_blank">Grounded T27-01</a>,
          and HGTV, <a href="https://www.hgtv.com/decorating/color/behrs-color-of-the-year-2027" rel="nofollow noopener" target="_blank">“Behr's 2027 Color of the Year Is a Rich Olive Hue”</a>.
        </li>
        <li>
          Sherwin-Williams — <a href="https://www.sherwin-williams.com/en-us/color/color-collections/colormix-forecast/2027" rel="nofollow noopener" target="_blank">Colormix Forecast 2027: Rewild</a>,
          and the PR Newswire announcement, <a href="https://www.prnewswire.com/news-releases/sherwin-williams-introduces-its-2027-colormix-trend-forecast-rewild-302838414.html" rel="nofollow noopener" target="_blank">30 July 2026</a>.
        </li>
        <li>
          Season tracking cross-checked against Young House Love,
          <a href="https://www.younghouselove.com/2027-color-of-the-year/" rel="nofollow noopener" target="_blank">“Every 2027 Color Of The Year (So Far!)”</a>.
        </li>
      </ul>
    </section>

    <div class="container-wide">
      <FurtherReading />
    </div>
  </article>
</BaseLayout>

<style>
  .coty-hero {
    padding-block: var(--spacing-section) 1.5rem;
  }

  .coty-hero__lede {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-ink-700);
    margin: 1rem 0 1.25rem;
  }

  .coty-hero__meta {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }

  .coty-hero__byline {
    color: var(--color-ink-700);
  }

  .coty-note {
    padding: 1rem 1.25rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-500);
    border-radius: var(--radius-md);
    margin-bottom: 2.5rem;
  }

  .coty-note p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-700);
  }

  .coty-picks {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    gap: 1.5rem;
  }

  .coty-pick {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-elevated);
    box-shadow: var(--shadow-plate);
  }

  @media (min-width: 640px) {
    .coty-pick {
      grid-template-columns: 160px 1fr;
    }
  }

  .coty-pick__swatch {
    min-height: 120px;
  }

  .coty-pick__body {
    padding: 1.5rem;
  }

  .coty-pick__brand {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    margin: 0 0 0.375rem;
  }

  .coty-pick__name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
    margin: 0 0 0.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.625rem;
  }

  .coty-pick__code {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-500);
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .coty-pick__family {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
    margin: 0 0 0.75rem;
  }

  .coty-pick__blurb {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-700);
    margin: 0 0 0.75rem;
  }

  .coty-pick__swatch-note {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-500);
    margin: 0 0 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .coty-pick__links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: baseline;
  }

  .coty-pick__cta {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-accent-500);
    text-decoration: none;
  }

  .coty-pick__cta:hover {
    text-decoration: underline;
  }

  .coty-pick__ref {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }

  .coty-pending {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 0.75rem;
  }

  .coty-pending li {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-700);
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
  }

  .coty-faq dt {
    font-weight: 600;
    margin-top: 1.25rem;
    color: var(--color-ink-900);
  }

  .coty-faq dd {
    margin: 0.375rem 0 0;
    color: var(--color-ink-700);
    line-height: 1.65;
  }

  .coty-sources {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 0.625rem;
  }

  .coty-sources li {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-ink-500);
  }
</style>
