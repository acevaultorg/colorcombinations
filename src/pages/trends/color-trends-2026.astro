---
/**
 * /trends/color-trends-2026 — annual "State of Color 2026" report.
 *
 * Aggregates every major authority's official 2026 Color of the Year into one
 * cited, AI-citable, press-pitchable page. The differentiated value vs. any
 * single-authority article: ALL of them side by side + the synthesised
 * meta-trend. High book-purchase intent → FurtherReading (Amazon, tag
 * colorcombinations-20).
 *
 * Zero fabrication: every NAME / CODE / DESCRIPTION is the authority's own,
 * cited in the Sources section. Swatch hexes are honest sRGB approximations
 * (paint + Pantone colours don't map to one exact hex) — labelled as such;
 * the authoritative reference is each brand's official colour code (linked).
 * Confirmed exact hexes: Pantone Cloud Dancer #F0EEE9, BM Silhouette #57504c.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSourceBook from "@components/HeroSourceBook.astro";
import AskAmili from "@components/AskAmili.astro";
import FurtherReading from "@components/FurtherReading.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";
import AmazonPick from "@components/AmazonPick.astro";
import { renderNextStep, NEXT_STEP_CSS } from "../../../kit/next-step.mjs";
import { palettesForTrendHexes, closestTo } from "@/lib/trendPalettes";


const siteUrl = "https://colorcombinations.org/";
const pageUrl = "https://colorcombinations.org/trends/color-trends-2026/";
const PUBLISHED = "2026-06-20T00:00:00Z";
// Re-verified 2026-10-16: PPG added (Secret Safari PPG1110-4, PPG release on Business Wire 2025-10-02; swatch #C6BB68 read from the swatch ppgpaints.com renders for PPG1110-4, so exact:false). Dulux re-checked on dulux.co.uk and kept as the prose note, not a card, by design. Earlier: re-verified 2026-09-02 against NAHB, Young House Love, Dulux + the 14 authorities' own pages
// (task mtjaxsmk36hi9v). Bump this date whenever the picks are re-checked, never automatically.
const VERIFIED = "2026-10-16";
// dateModified is the CURATED verification date, not the build clock. It used to be
// `new Date().toISOString()`, which told machines this page changed on every deploy while
// the byline told humans "Last verified 2 September" — the same page asserting two
// different things, and the auto one was false: a rebuild is not a content change.
// The rule three lines up ("never automatically") is the right one; it just wasn't
// applied to the machine-readable half. Bumping VERIFIED now moves both together.
const MODIFIED = `${VERIFIED}T00:00:00Z`;
const AUTHOR = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}#person-paulo-de-vries`,
  name: "Paulo de Vries",
  jobTitle: "Founder + editor, The Dictionary of Color Combinations",
  url: `${siteUrl}about/`,
  worksFor: { "@id": `${siteUrl}#organization` },
  sameAs: ["https://paulodevries.com/", "https://www.linkedin.com/in/paulomichaeldevries"],
};

interface Pick {
  brand: string;
  name: string;
  code: string;
  hex: string;
  exact: boolean;
  family: string;
  blurb: string;
  url: string;
}

// Each pick now has an ON-SITE destination. This page is the most-cited in the fleet,
// and every card used to link straight out to the brand — pantone.com, benjaminmoore.com
// and twelve more — so the reader it attracted was handed to a competitor and
// /colors/cloud-dancer/ returned 404. The question this page provokes ("fine, what goes
// WITH it?") is the one this site exists to answer, so the card now leads there and the
// brand link stays as the authoritative code reference.
const slugFor = (n: string) => n.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const pairUrl = (n: string) => `/colors-that-go-with/${slugFor(n)}/walls/`;

// Verified picks (names/codes/descriptions are each authority's own — see Sources).
const PICKS: Pick[] = [
  { brand: "Pantone", name: "Cloud Dancer", code: "PANTONE 11-4201", hex: "#F0EEE9", exact: true, family: "Serene white", blurb: "A lofty, serene white symbolising calm, clarity and spaciousness — the first true white named Color of the Year since the program began in 1999.", url: "https://www.pantone.com" },
  { brand: "WGSN + Coloro", name: "Transformative Teal", code: "Coloro 100-31-15", hex: "#1C7E84", exact: false, family: "Blue-green teal", blurb: "A fluid fusion of dependable blue and aquatic green for a year of redirection — cooling, regenerative and Earth-first.", url: "https://www.wgsn.com/en/blog/colour-year-2026-transformative-teal" },
  { brand: "Benjamin Moore", name: "Silhouette", code: "AF-655", hex: "#57504C", exact: true, family: "Burnt-umber charcoal", blurb: "A burnt umber with delicate notes of charcoal — a warm, grounding alternative to black.", url: "https://www.benjaminmoore.com" },
  { brand: "Sherwin-Williams", name: "Universal Khaki", code: "SW 6150", hex: "#CBBBA1", exact: false, family: "Warm tan neutral", blurb: "The essential neutral — a warm, earthy, creamy tan anchoring a tailored, timeless mood.", url: "https://www.sherwin-williams.com" },
  { brand: "Behr", name: "Hidden Gem", code: "N430-6A", hex: "#5E7A72", exact: false, family: "Smokey jade", blurb: "A smokey, desaturated jade — mysterious elegance that holds a full wall.", url: "https://www.behr.com" },
  { brand: "Valspar", name: "Warm Eucalyptus", code: "—", hex: "#98A189", exact: false, family: "Gray-green", blurb: "A muted, earthy gray-green meant to be restful to the eye and restorative to the soul.", url: "https://www.valspar.com" },
  { brand: "Glidden", name: "Warm Mahogany", code: "PPG1060-7", hex: "#7B473C", exact: false, family: "Red-brown", blurb: "A rich, grounded red-brown evoking rest, connection and creativity.", url: "https://www.glidden.com" },
  { brand: "PPG", name: "Secret Safari", code: "PPG1110-4", hex: "#C6BB68", exact: false, family: "Soft yellow-green", blurb: "A versatile yellow-green that balances soothing comfort with a touch of energy, part of PPG's 2026 global theme, Parallels.", url: "https://www.businesswire.com/news/home/20251002304338/en/PPG-announces-Secret-Safari-as-2026-Color-of-the-Year" },
  { brand: "Dunn-Edwards", name: "Midnight Garden", code: "—", hex: "#39463C", exact: false, family: "Deep green", blurb: "A deep, muted green of quiet elegance with earthy undertones and timeless appeal.", url: "https://www.dunnedwards.com" },
  { brand: "Dutch Boy", name: "Melodious Ivory", code: "—", hex: "#EEE6D2", exact: false, family: "Warm cream", blurb: "A warm cream with a nostalgic, elevated vibe — a base for layering bolder accents.", url: "https://www.dutchboy.com/" },
  { brand: "Graham & Brown", name: "Divine Damson", code: "—", hex: "#4C2E48", exact: false, family: "Deep purple", blurb: "A deep, saturated damson purple — luxury and sophistication with timeless versatility.", url: "https://www.grahambrown.com" },
  { brand: "C2 Paint", name: "Epernay", code: "—", hex: "#D6B96C", exact: false, family: "Soft ochre", blurb: "A soft, earthy ochre-yellow inspired by craft, artistry and European interiors.", url: "https://www.c2paint.com" },
  { brand: "Minwax", name: "Special Walnut", code: "—", hex: "#6B4A30", exact: false, family: "Walnut wood", blurb: "A medium walnut wood-stain tone, riding the rustic wood-drenching trend.", url: "https://www.minwax.com" },
  { brand: "Krylon", name: "Coffee Bean", code: "—", hex: "#4A3B30", exact: false, family: "Dark brown", blurb: "A dark, natural brown spray tone inspired by elements of the earth.", url: "https://www.krylon.com" },
  { brand: "Rust-Oleum", name: "Satin Lagoon", code: "—", hex: "#2E7C84", exact: false, family: "Teal", blurb: "A tranquil-yet-vibrant teal that pairs with both neutrals and bold hues.", url: "https://www.rustoleum.com" },
];

/*
 * TITLE/META — Bing CTR test, 2026-08-24 (TaskPeace mt79i08wgdw5ln).
 *
 * WHY THIS CHANGED. Bing is 98.8% of this site's search traffic. Per-page Bing
 * data showed this page earning 2.95% CTR at position 4.9 while the homepage
 * earns 6.93% at 4.1 — near-identical rank, 43% of the click rate. The sharpest
 * signal was the query "color of the year 2026": 841 impressions, 3 clicks,
 * 0.36% CTR at position 5.2. Page one, and almost nothing earned from it.
 *
 * Reading the live SERP settled the cause: every competing result that earns the
 * click NAMES THE ACTUAL COLOUR in its title — "…Silhouette AF-655 | Benjamin
 * Moore", "PANTONE 11-4201 Cloud Dancer | Color of the Year 2026", "Color of the
 * Year 2026 - Hidden Gem | Behr". The old title said "Every Authority's Pick" and
 * named none. The description already named them; the title is what Bing shows.
 *
 * Worth recording what this is NOT: a one-fact zero-click query. Those are
 * structurally unclickable at any rank and no rewrite helps them. This one is
 * genuinely plural — every brand picks a different colour — so the answer is
 * LIST-shaped, which is the shape that does capture. That is why a title fix is
 * the right lever here and would have been the wrong one on, say, a single-fact
 * reference page.
 *
 * The count is COMPUTED from PICKS, never typed. A hardcoded "13" silently
 * becomes a lie the moment a 15th authority is added.
 */
const title = `Color of the Year 2026: Pantone Cloud Dancer + ${PICKS.length - 1} More`;
const description = `All ${PICKS.length} official 2026 Colors of the Year in one place — Pantone Cloud Dancer, Benjamin Moore Silhouette, Behr Hidden Gem, Sherwin-Williams Universal Khaki and more.`;

// Luminance → readable swatch text colour (no fabrication; pure math).
const textOn = (hex: string): string => {
  const c = hex.replace("#", "");
  const r = parseInt(c.slice(0, 2), 16);
  const g = parseInt(c.slice(2, 4), 16);
  const b = parseInt(c.slice(4, 6), 16);
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? "#1a1a1a" : "#ffffff";
};

// ── Cloud Dancer in numbers (Amili card from:mvc157jxy2oz0d, 2026-10-17) ─────────────────────
// This page's Bing queries "pantone color of the year 2026" (565 impressions, avg position 7.0) and
// "pantone colour of the year 2026" (162, pos 6.3) over the 4 weekly buckets 2026-09-25..10-16
// (GetQueryStats, read 2026-10-17). The #1 result for them is Pantone's own announcement, which gives
// the name, code and mood. What a designer asks next — the hex, RGB, and which text colours are
// readable on it — it does not answer. Everything below is COMPUTED from the one confirmed hex
// (#F0EEE9) and the confirmed hexes already on this site (Silhouette here, Mocha Mousse on
// /trends/pantone-color-of-the-year/), with the WCAG 2.x relative-luminance formula, at build time,
// so no number on the page can drift from its input.
const hexRgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const lin = (c: number) => { const v = c / 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };
const luminance = (h: string) => { const [r, g, b] = hexRgb(h).map(lin); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };
const contrast = (a: string, b: string) => { const [x, y] = [luminance(a), luminance(b)].sort((m, n) => n - m); return (x + 0.05) / (y + 0.05); };
const hsl = (h: string) => {
  const [r, g, b] = hexRgb(h).map((c) => c / 255);
  const max = Math.max(r, g, b), min = Math.min(r, g, b), l = (max + min) / 2, d = max - min;
  if (d === 0) return [0, 0, Math.round(l * 100)];
  const sat = d / (1 - Math.abs(2 * l - 1));
  let hue = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
  hue = Math.round(hue * 60); if (hue < 0) hue += 360;
  return [hue, Math.round(sat * 100), Math.round(l * 100)];
};
const CD = "#F0EEE9";
const cdRgb = hexRgb(CD);
const cdHsl = hsl(CD);
const verdict = (r: number) => (r >= 7 ? "Passes AAA, any text size" : r >= 4.5 ? "Passes AA for body text" : r >= 3 ? "Large text and icons only (AA large)" : "Fails, decoration only");
const CD_TEXT = [
  { name: "Black", note: "body text", hex: "#000000" },
  { name: "Benjamin Moore Silhouette", note: "2026 pick, AF-655", hex: "#57504C" },
  { name: "Pantone Mocha Mousse", note: "2025 pick, 17-1230", hex: "#A47864" },
  { name: "Pure white", note: "#FFFFFF page next to it", hex: "#FFFFFF" },
].map((t) => ({ ...t, ratio: contrast(CD, t.hex) }));
const fmtRatio = (r: number) => `${r.toFixed(2)}:1`;

const faq = [
  {
    q: "What is the hex code for Pantone Cloud Dancer?",
    a: `Cloud Dancer (PANTONE 11-4201) is ${CD} on screen: RGB ${cdRgb.join(", ")}, HSL ${cdHsl[0]}°, ${cdHsl[1]}%, ${cdHsl[2]}%. It is a warm off-white, not pure white. Black text on it has a contrast ratio of ${fmtRatio(contrast(CD, "#000000"))}, well past the WCAG AAA threshold; against a pure white page it measures only ${fmtRatio(contrast(CD, "#FFFFFF"))}, so a Cloud Dancer panel on white needs a border or shadow to be seen. For print, use the PANTONE code, not the hex.`,
  },
  {
    q: "What is the Pantone Color of the Year 2026?",
    a: "Pantone's 2026 Color of the Year is Cloud Dancer (PANTONE 11-4201), a soft, serene white — the first true white ever chosen since the program began in 1999.",
  },
  {
    q: "What is the 2026 Color of the Year?",
    a: "There is no single one — each authority names its own. Pantone chose Cloud Dancer (a serene white); WGSN and Coloro chose Transformative Teal; and the paint brands lean toward warm earthy neutrals and browns, including Benjamin Moore Silhouette, Sherwin-Williams Universal Khaki and Glidden Warm Mahogany.",
  },
  {
    q: "What is the overall 2026 color trend?",
    a: "Two linked moods: serene, near-weightless light (Pantone Cloud Dancer, Dutch Boy Melodious Ivory) and grounded, tactile earth tones (warm browns, deep greens and smokey teals). Together they read as an antidote to digital fatigue — a pull toward calm, nature and the hand-made.",
  },
  {
    q: "What are the 2026 paint colors of the year?",
    a: "Benjamin Moore Silhouette (AF-655), Sherwin-Williams Universal Khaki (SW 6150), Behr Hidden Gem (N430-6A), Valspar Warm Eucalyptus, Glidden Warm Mahogany (PPG1060-7), Dunn-Edwards Midnight Garden and Dutch Boy Melodious Ivory.",
  },
  {
    q: "What are the colours for 2026?",
    a: "Two linked moods: serene, near-weightless light (Pantone Cloud Dancer, Dutch Boy Melodious Ivory, Sherwin-Williams Universal Khaki) and grounded, tactile earth (Benjamin Moore Silhouette, Behr Hidden Gem, WGSN + Coloro's Transformative Teal, and more warm browns and deep greens). Full list and swatches below.",
  },
  {
    q: "How is 2026 different from 2025 (Mocha Mousse)?",
    a: "2025 was brown and plum: Pantone Mocha Mousse, Benjamin Moore Cinnamon Slate, Behr Rumors. 2026 swings to calm light and earth: Pantone Cloud Dancer is its first-ever white, and the paint brands move from reds and plums to khaki, jade, walnut and teal.",
  },
];

// 2025 → 2026, same authority side by side. Names are each brand's own as recorded by
// NAHB (Dec 2024) and Young House Love's 2025 guide; codes only where a primary source states one.
const YEAR_OVER_YEAR: { brand: string; y2025: string; y2026: string; shift: string }[] = [
  { brand: "Pantone", y2025: "Mocha Mousse (17-1230)", y2026: "Cloud Dancer (11-4201)", shift: "warm brown → serene white" },
  { brand: "Benjamin Moore", y2025: "Cinnamon Slate (2113-40)", y2026: "Silhouette (AF-655)", shift: "heathered plum-brown → burnt-umber charcoal" },
  { brand: "Sherwin-Williams", y2025: "Grounded", y2026: "Universal Khaki (SW 6150)", shift: "earthy brown → warm tan" },
  { brand: "Behr", y2025: "Rumors (MQ1-15)", y2026: "Hidden Gem (N430-6A)", shift: "ruby red → smokey jade" },
  { brand: "Valspar", y2025: "Encore", y2026: "Warm Eucalyptus", shift: "deep blue → gray-green" },
  { brand: "Glidden", y2025: "Purple Basil (PPG1046-7)", y2026: "Warm Mahogany (PPG1060-7)", shift: "red-plum → red-brown" },
  { brand: "Dunn-Edwards", y2025: "Caramelized", y2026: "Midnight Garden", shift: "terracotta brown → deep green" },
  { brand: "Dutch Boy", y2025: "Mapped Blue", y2026: "Melodious Ivory", shift: "medium blue → warm cream" },
  { brand: "Graham & Brown", y2025: "Elderton", y2026: "Divine Damson", shift: "brown → deep purple" },
  { brand: "C2 Paint", y2025: "Raku", y2026: "Epernay", shift: "burnt red-brown → soft ochre" },
  { brand: "Minwax", y2025: "Violet", y2026: "Special Walnut", shift: "violet stain → walnut wood" },
  { brand: "Krylon", y2025: "Hammered Black", y2026: "Coffee Bean", shift: "black → dark brown" },
  { brand: "Rust-Oleum", y2025: "Satin Warm Caramel", y2026: "Satin Lagoon", shift: "caramel → teal" },
];

const jsonLd = [
  AUTHOR,
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "The 2026 Colors of the Year — Every Authority's Pick",
    description,
    url: pageUrl,
    inLanguage: "en",
    datePublished: PUBLISHED,
    dateModified: MODIFIED,
    author: { "@id": `${siteUrl}#person-paulo-de-vries` },
    publisher: { "@id": `${siteUrl}#organization` },
    isPartOf: { "@id": `${siteUrl}#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "2026 Colors of the Year",
    description: "Official 2026 Color of the Year selections from leading colour and paint authorities.",
    numberOfItems: PICKS.length,
    itemListElement: PICKS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${p.brand}: ${p.name}${p.code !== "—" ? ` (${p.code})` : ""}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      // No position-2 "Trends" crumb: there is no /trends/ hub (it 404s), so the middle
      // crumb pointed at THIS page — a self-referential breadcrumb, which is malformed.
      // Home > leaf is correct until a real /trends/ index exists. Fixed 2026-09-06.
      { "@type": "ListItem", position: 2, name: "Colors of the Year 2026" },
    ],
  },
];

// One clear second page right after the picks (round cc-adsense-trends, 2026-10-22): real palettes
// built on the picks' closest archive colours, plus the two sibling reports. Kit block kit/next-step.mjs.
const nextStep = renderNextStep({
  id: "keep-exploring",
  heading: "Keep exploring the 2026 colours",
  intro: "Palettes from the archive that already use the closest colours to these picks, and the other lists to compare them with.",
  palettes: palettesForTrendHexes(PICKS.map((p) => ({ hex: p.hex, label: p.name }))).map(({ palette, shared }) => ({
    href: `/palettes/${palette.slug}/`,
    name: palette.title,
    colors: palette.colors.map((c) => c.hex),
    note: closestTo(shared),
  })),
  links: [
    { href: "/trends/color-trends-2027/", title: "The 2027 Colors of the Year so far", text: "Every pick announced for next year, updated as the season runs." },
    { href: "/trends/pantone-color-of-the-year/", title: "Every Pantone Color of the Year since 2000", text: "With codes, screen hexes and the closest colour in this archive." },
  ],
  from: "trends-2026-next",
});
const featured = PICKS.slice(0, 2);
const grid = PICKS.slice(2);
---

<BaseLayout
  adContent
  title={title}
  description={description}
  canonical={pageUrl}
  type="article"
  author="Paulo de Vries"
  publishedTime={PUBLISHED}
  modifiedTime={MODIFIED}
  keywords={[
    "2026 color of the year",
    "color trends 2026",
    "Pantone color of the year 2026",
    "2026 paint colors of the year",
    "Cloud Dancer",
    "Transformative Teal",
  ]}
  jsonLd={jsonLd}
>
  <article class="coty">
    <header class="coty-hero container-narrow">
      <p class="eyebrow">Color Report · 2026</p>
      <h1 class="display-hero text-balance">The 2026 Colors of the Year</h1>
      <AskAmili />
      <p class="coty-hero__lede">
        Every major authority names its own Color of the Year — and for 2026
        they split into two camps that tell one story: <strong>serene, weightless
        light</strong> and <strong>grounded, tactile earth</strong>. Here is the
        complete set, side by side, with the meta-trend that ties them together.
      </p>
      <HeroSourceBook lead="Trends change every year; most palettes on this site come from one 1933 book." surface="trends-hero" />
      <p class="coty-hero__meta">
        By <a class="coty-hero__byline" href="/about/" rel="author">Paulo de Vries</a>
        · Last verified <time datetime={VERIFIED}>16 October 2026</time>
        · {PICKS.length} authorities · sources cited below
      </p>
      {/* 2027 pointer (2026-10-22): this sat ~43% down the page with "Valspar, Dutch Boy and
          Behr have announced" while the 2027 page already listed 14 picks, and GA4 showed 0
          onward views to /trends/color-trends-2027/ from here in 28 days (113 organic landings).
          Moved into the hero, BELOW the source-book buy line. No count in the copy: it names
          brands that have announced, so it cannot go stale as more picks arrive. */}
      <p class="coty-next coty-next--hero">
        <strong>The 2027 Colors of the Year are coming in.</strong> Valspar, Behr,
        Sherwin-Williams, Benjamin Moore and more have announced; Pantone follows in early December.
        <a href="/trends/color-trends-2027/">See every 2027 pick announced so far →</a>
        <br /><a href="/trends/pantone-color-of-the-year/">Every Pantone Color of the Year since 2000 →</a>
      </p>
    </header>

    <section class="container-narrow">
      {/* One clear Amazon button for the matching paint set (Amili card mvc8yz47xd0zq3, 2026-10-17); clicks per button: f=/p= strike-2026.
          Moved 2026-10-22 (Paulo mvjfbf3yug8n1b, card mvjfgix6dzqbfn) to directly after the hero, the same spot as /browse/,
          whose identical button sits on the first phone screen and got 16 clicks over 4 days to 0 here. */}
      <AmazonPick
        asin="B07R7XGHJW"
        placement="strike-2026"
        title="Mix the 2026 colours by hand"
        text="Cloud Dancer is a soft white, and whites are where screens lie the most. A 48-colour gansai set lets you mix it and the other 2026 picks on paper, next to each other."
      />
    </section>

    <section class="coty-featured container-narrow" aria-label="The two global picks">
      {featured.map((p) => (
        <a class="coty-feature" href={pairUrl(p.name)}>
          <span class="coty-feature__swatch" style={`background:${p.hex};color:${textOn(p.hex)}`}>
            <span class="coty-feature__hex">{p.hex}{!p.exact && <em> approx.</em>}</span>
          </span>
          <span class="coty-feature__body">
            <span class="coty-feature__brand">{p.brand}</span>
            <span class="coty-feature__name">{p.name}</span>
            {p.code !== "—" && <span class="coty-feature__code">{p.code}</span>}
            <span class="coty-feature__blurb">{p.blurb}</span>
            <span class="coty-feature__cta">See what goes with {p.name} &rarr;</span>
          </span>
        </a>
      ))}
    </section>

    <section class="container-narrow">
      <h2 id="all-picks">Every 2026 Color of the Year</h2>
      <p class="coty-note">
        Swatches are approximate sRGB renderings — physical paint and Pantone
        colours don't map to a single exact hex, so each brand's official colour
        code (linked) is the source of truth. Cloud Dancer and Silhouette show
        confirmed values.
      </p>
      <ul class="coty-grid" role="list">
        {grid.map((p) => (
          <li class="coty-card">
            <a href={pairUrl(p.name)}>
              <span class="coty-card__swatch" style={`background:${p.hex};color:${textOn(p.hex)}`}>
