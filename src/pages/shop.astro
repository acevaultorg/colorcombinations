---
import BaseLayout from "@layouts/BaseLayout.astro";
import BundleCta from "@components/BundleCta.astro";
import DesignTools from "@components/DesignTools.astro";
import EmailCapture from "@components/EmailCapture.astro";
import FurtherReading from "@components/FurtherReading.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";
import { BUNDLE, PRINTS } from "@/config/monetization";

const title = "Shop";
const description =
  "Support the archive. Get the bundle, the books, and the prints that built The Dictionary of Color Combinations.";

const bundlePrice = BUNDLE.price.replace(/[^\d.]/g, "");
const bundleMinPrice = BUNDLE.minPrice.replace(/[^\d.]/g, "");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: BUNDLE.name,
    description:
      "All 378 historically-grounded color combinations (348 Sanzo Wada plates + 30 editorial) as Figma tokens, Tailwind config, CSS variables, SVG plates, and full JSON — the complete archive in one download. Pay what you want, minimum $3, suggested $5.",
    brand: {
      "@type": "Brand",
      name: "The Dictionary of Color Combinations",
    },
    image: new URL("/og-default.png", Astro.site).toString(),
    offers: {
      "@type": "Offer",
      priceCurrency: "USD",
      price: bundleMinPrice,
      priceSpecification: {
        "@type": "PriceSpecification",
        price: bundlePrice,
        priceCurrency: "USD",
        minPrice: bundleMinPrice,
      },
      availability: BUNDLE.isLive
        ? "https://schema.org/InStock"
        : "https://schema.org/PreOrder",
      url: new URL("/shop", Astro.site).toString(),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Shop",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} image="/og/shop.png" jsonLd={jsonLd} adContent>
  {/* ============ HERO ============ */}
  <section class="shop-hero">
    <div class="container-wide shop-hero__inner">
      <p class="eyebrow">The museum gift shop</p>
      <h1 class="display-hero text-balance">
        The library, the toolbox, and a thank-you.
      </h1>
      <p class="shop-hero__lede">
        Everything at The Dictionary of Color Combinations is free to browse and
        copy — that will never change. This page is what to reach for next. The
        books that taught us the material — both volumes of Wada, the Albers
        classic, and shelf-defining histories of color. A short list of tools
        that pair with the archive. And a tip jar with the full bundle attached
        as a thank-you.
      </p>
    </div>
  </section>

  {/* ============ 1. BOOKS (primary affiliate rail — visual, high conversion) ============ */}
  <div class="shop-books" id="library">
    <div class="container-wide">
      <FurtherReading
      pageClass="shop"
        title="The library behind the archive"
        intro="Every palette in this archive stands on the shoulders of these books. Real criticism, real history, real judgment. If you want to go deeper than hex values, start here."
      />
    </div>
  </div>

  {/* ============ 2. STUDIO (materials rail — added 2026-07-21) ============
      The book rail above measured ~87 clicks → 0 orders: readers here are
      makers, not collectors of out-of-print imports. This rail carries what
      a colour study is actually made with. */}
  <div class="shop-studio" id="studio">
    <div class="container-wide">
      <PaintThisPalette
        title="Off the screen"
        intro="A palette is a set of decisions until someone mixes it. These are the materials — Japanese watercolour pans, paper that takes a wash, and the one reference that survives the trip to a printing press."
      />
    </div>
  </div>

  {/* Non-Amazon third-party affiliate sections (design-tool / course / print-on-demand
      referrals) removed 2026-06-14 — operator directive: colorcombinations is Amazon-only.
      Revenue focus = the Amazon book rail above + first-party prints/support below. */}

  {/* ============ 3. PRINTS (waitlist until demand validated) ============ */}
  <section class="prints section" id="prints">
    <div class="container-wide prints__inner">
      <div class="prints__body">
        <p class="eyebrow">Prints &amp; posters</p>
        <h2 class="text-balance">Museum-grade poster sets.</h2>
        <p class="prints__lede">
          Each palette, printed as a single plate — generous margins, archival
          matte paper, designed to sit on a studio wall the way Wada's book sat
          on a studio shelf. Printed on demand, shipped worldwide.
        </p>
        <div class="prints__actions">
          {PRINTS.isLive ? (
            <a
              href={PRINTS.storeUrl}
              class="btn btn-primary"
              target="_blank"
              rel="noopener"
              data-event="prints_cta_click"
            >
              Browse the print shop <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <>
              <a
                href="/#newsletter"
                class="btn btn-primary"
                data-event="prints_waitlist_click"
              >
                Join the waitlist
              </a>
              <p class="prints__note">
                Prints launch after the first batch of early supporters — subscribers hear first.
              </p>
            </>
          )}
        </div>
      </div>
      <div class="prints__aside" aria-hidden="true">
        <div class="prints__mock plate">
          <div class="prints__mock-swatches">
            <span style="background:#F9D5E0" />
            <span style="background:#A3C293" />
            <span style="background:#F8F4E9" />
            <span style="background:#4C5D3F" />
          </div>
          <p class="prints__mock-title">Sakura &amp; Wakatake</p>
          <p class="prints__mock-meta">Heian era · Print no. 02</p>
        </div>
      </div>
    </div>
  </section>

  {/* ============ 4. SUPPORT / BUNDLE (honest tip jar) ============ */}
  <BundleCta variant="big" id="bundle" />
  {/* The BundleCta's own anchor target. This WAS an empty aria-hidden
      section: 64 bundle_interest_click/30d (GA4 294106772, 2026-09-03) scrolled
      to a zero-height invisible element, so every one of those intent clicks
      dead-ended with no way to say "tell me when". The product itself is
      operator-gated (BUNDLE.checkoutUrl is still the /shop fallback), so the
      honest thing to put here is capture, not a buy button for a thing that
      does not exist yet. `source` segments these from homepage newsletter
      signups in the SUBSCRIBERS KV so the launch email can go to the right
      list. Per ux-conversion-friction: never leave a dead end. */}
  <section id="bundle-coming-soon" class="bundle-waitlist">
    <EmailCapture
      source="bundle-waitlist"
      heading="The bundle isn't out yet. Want the nudge when it is?"
      lede="One email, once, when the archive bundle goes live — all 378 palettes in Figma, Tailwind, CSS, SVG and JSON. Nothing else goes to this list."
      cta="Tell me when it's out"
      note="Free. No credit card. The archive itself stays free either way."
    />
  </section>

  {/* ============ 5. DESIGN TOOLS (software rail — pairs a palette with a
      place to actually use it; higher commission ceiling than books, added
      2026-09-06) ============ */}
  <div class="container-wide">
    <DesignTools />
  </div>

  {/* ============ CLOSING NOTE ============ */}
  <section class="shop-note section">
    <div class="container-prose shop-note__inner">
      <p class="eyebrow">A note from the archive</p>
      <p>
        The archive itself will always stay free — no paywall, no login, no
        watermarks on the exports. The affiliate links above earn a small
        commission, the bundle is a tip jar for folks who want to support the
        work directly, and the prints will be a real product once demand is
        proven.
      </p>
      <p>
        If you can't support financially, just share a palette you found useful.
        Word of mouth is the archive's oldest friend.
      </p>
      <p class="shop-note__sign">— The editors</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* anchor target for the bundle CTA — clear the header on jump */
  .bundle-waitlist { scroll-margin-block-start: 5rem; }

  .shop-hero {
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }

  .shop-hero__inner {
    max-width: 62rem;
  }

  .shop-hero .eyebrow {
    margin-bottom: 1.5rem;
  }

  .shop-hero__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.4vw + 0.75rem, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-700);
    max-width: 58ch;
    margin-top: 1.75rem;
  }

  /* ---- Prints ---- */
  .prints {
    padding-block: var(--spacing-section);
  }

  .prints__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .prints__inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .prints__body .eyebrow {
    margin-bottom: 0.75rem;
  }

  .prints__body h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .prints__lede {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-ink-700);
    line-height: 1.65;
    max-width: 52ch;
    margin-bottom: 2rem;
  }

  .prints__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .prints__note {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
    max-width: 48ch;
    margin: 0;
  }

  .prints__aside {
    display: flex;
    justify-content: center;
  }

  .prints__mock {
    padding: 2rem;
    max-width: 24rem;
    width: 100%;
    background-color: var(--color-paper-50);
  }

  .prints__mock-swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 9rem;
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }

  .prints__mock-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }

  .prints__mock-meta {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    margin: 0;
  }

  /* ---- Books wrapper ---- */
  .shop-books {
    background-color: var(--color-paper-100);
    border-block: 1px solid var(--color-border);
  }

  /* ---- Tools wrapper ---- */
  .shop-tools {
    background-color: var(--color-paper-50);
    border-bottom: 1px solid var(--color-border);
  }

  /* ---- Closing note ---- */
  .shop-note {
    background-color: var(--color-paper-50);
  }

  .shop-note__inner {
    max-width: 60ch;
    padding-block: 2rem;
  }

  .shop-note__inner p {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-ink-700);
    margin-bottom: 1.25rem;
  }

  .shop-note .eyebrow {
    margin-bottom: 1rem;
  }

  .shop-note__sign {
    font-style: italic;
    color: var(--color-ink-500);
    margin-top: 2rem;
  }
</style>
