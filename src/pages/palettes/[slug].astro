---
import BaseLayout from "@layouts/BaseLayout.astro";
import PaletteCard from "@components/PaletteCard.astro";
import ExportPalette from "@components/ExportPalette.astro";
import BundleCta from "@components/BundleCta.astro";
import FurtherReading from "@components/FurtherReading.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";
import ContrastMatrix from "@components/ContrastMatrix.astro";
import ShareBar from "@components/ShareBar.astro";
import { FURTHER_READING, ART_SUPPLIES } from "@/config/monetization";
import { allPalettes, paletteBySlug, relatedPalettes } from "@data/palettes";
import { commonColors, contexts, pairingPaths, redmean } from "@data/pairings";
import { collectionsForPalette, paletteSetForCollection } from "@data/collections";
import { pillarForCollection } from "@data/pillarMap";
import { bestTextColorOn, contrastRatio } from "@/lib/color";

export async function getStaticPaths() {
  return allPalettes().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const palette = paletteBySlug(slug ?? "");

if (!palette) {
  return Astro.redirect("/404");
}

const related = relatedPalettes(palette, 3);
const paletteCollections = collectionsForPalette(palette).slice(0, 4);

// "More from [primary collection]" — pull up to 6 sibling palettes from the
// first collection this palette belongs to. Different axis from `related`
// (which is hue-similarity) — this is collection-membership. Compounds
// thematic browsing across the 69-collection map.
const primaryCollection = paletteCollections[0] ?? null;
const collectionSiblings = primaryCollection
  ? paletteSetForCollection(primaryCollection)
      .filter((p) => p.slug !== palette.slug)
      .slice(0, 6)
  : [];

// Pillar-article cross-link — if any of this palette's collections maps to a
// pillar, surface it. Tries collections in order until one matches. Compounds
// /palettes → /learn discovery alongside the existing /collections + /colors
// → /learn paths.
const collectionPillar =
  paletteCollections
    .map((c) => pillarForCollection(c.slug))
    .find((p): p is NonNullable<typeof p> => p !== null) ?? null;

// Fallback for the 348 Wada plates (mostly outside collections): route each
// plate to the most relevant original-research pillar by its own properties,
// so every palette page carries a /learn cross-link (hub-and-spoke).
const wadaPillar = palette.tags?.includes("wada")
  ? palette.moods.includes("solemn") || palette.moods.includes("serene")
    ? {
        href: "/learn/wada-palettes-by-mood/",
        title: "Wada Palettes by Mood and Season: Grouping the 348 Plates",
        lede: "This plate sits in one of the dictionary's rare value-extreme groups. See all 348 combinations grouped by mood — dark, pale, warm, cool — and by season.",
      }
    : palette.colors.length === 2
      ? {
          href: "/learn/wada-color-psychology/",
          title: "Color Psychology in Wada's System: What 348 Plates Are Built to Feel Like",
          lede: "Two-color plates are Wada's signature discipline. What the pairing format — and the warm-against-cool move — does to a viewer, measured across the archive.",
        }
      : {
          href: "/learn/color-data-analysis/",
          title: "What 348 Palettes Reveal: A Data Analysis of Sanzo Wada's Dictionary",
          lede: "The most-used colors, which hues dominate, and how many of the 348 historical combinations are legible enough for screen text — measured from the archive.",
        }
  : null;

const pillar = collectionPillar ?? wadaPillar;

// Deterministic book rotation — different palette pages show different books
// so impressions are distributed across the full FurtherReading inventory.
// Hash the slug to a stable offset into the book list.
const bookOffset =
  palette.slug
    .split("")
    .reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % FURTHER_READING.length;

// Same idea for the studio shelf, but seeded off the slug length as well so
// the two rotations don't move in lockstep (a reader browsing several plates
// should meet the whole catalogue, not the same pairing every time).
const supplyOffset =
  (palette.slug.split("").reduce((sum, ch) => sum + ch.charCodeAt(0), 0) +
    palette.slug.length) %
  ART_SUPPLIES.length;

const title = palette.title + (palette.titleJa ? ` (${palette.titleJa})` : "");
// Bing WMT r118 (2026-07-14): 19 palette pages flagged for too-short meta
// descriptions — the poetic summary alone can be <60ch. When short, extend it
// with facts computed from the palette itself (names + hexes + what the page has).
const _colorBits = palette.colors
  .slice(0, 3)
  .map((c) => `${c.nameRomaji ?? c.hex} (${c.hex})`)
  .join(", ");
const description =
  palette.summary.length >= 110
    ? palette.summary
    : `${palette.summary} A ${palette.colors.length}-color combination — ${_colorBits}${palette.colors.length > 3 ? " and more" : ""} — with hex and RGB values, contrast checks and pairing guidance.`;
const pageUrl = new URL(`/palettes/${palette.slug}`, Astro.site).toString();
const ogImage = `/og/${palette.slug}.png`;

// Moved from ShareBar.astro when it was generalised (2026-09-06) — provenance
// branching stays here because it's genuinely palette-specific: only the 348
// Wada plates may claim the 1933 dictionary; the 30 editorial palettes are
// original compositions (see /methodology).
const shareTitle = palette.titleJa ? `${palette.title} (${palette.titleJa})` : palette.title;
const shareHexList = palette.colors.map((c) => c.hex).join("  ");
const isWadaPlate = (palette.tags ?? []).includes("wada") || /^wada-\d+-/.test(palette.slug);
const shareProvenance = isWadaPlate
  ? `a plate from Sanzo Wada's 1933 Dictionary of Color Combinations`
  : `a ${palette.era}-era-inspired editorial palette from colorcombinations.org`;
const shareTweetText = `${shareTitle} — ${shareProvenance}\n${shareHexList}\n#ColorPalette #DesignInspiration #JapaneseColors`;
const sharePinterestMedia = new URL(ogImage, Astro.site).toString();

// Per-combination "Historical context" — unique, fact-derived prose so each
// palette page carries page-specific content (plate #, the actual colours,
// hue, mood, era, and a computed contrast finding) instead of a shared
// boilerplate paragraph. Every fact derives from the dataset — nothing invented.
const plateMatch = palette.slug.match(/^wada-(\d+)-/);
// Provenance gate. The 348 Wada plates carry the `wada-NNN-` slug prefix AND the
// "wada" tag (the two agree on all 378 palettes); the 30 editorial palettes carry
// neither. EVERY provenance claim below branches on this: the editorial set is an
// original composition and is NOT from the 1933 dictionary — see /methodology,
// "They are not derived from the Wada source."
const isWada = plateMatch !== null || (palette.tags ?? []).includes("wada");
const plateLabel = plateMatch
  ? `Plate ${Number(plateMatch[1])} of Wada's 348`
  : "This editorial combination";
const colorNames = palette.colors.map((c) => c.nameRomaji ?? c.hex);
const colorList =
  colorNames.length <= 1
    ? colorNames[0] ?? ""
    : `${colorNames.slice(0, -1).join(", ")} and ${colorNames[colorNames.length - 1]}`;
const eraLabel = palette.era.charAt(0).toUpperCase() + palette.era.slice(1);
// Strongest (highest-contrast) pair, computed from the actual hex values.
let bestPair = { a: palette.colors[0], b: palette.colors[0], ratio: 0 };
for (let i = 0; i < palette.colors.length; i++) {
  for (let j = i + 1; j < palette.colors.length; j++) {
    const r = contrastRatio(palette.colors[i].hex, palette.colors[j].hex);
    if (r > bestPair.ratio)
      bestPair = { a: palette.colors[i], b: palette.colors[j], ratio: r };
  }
}
const bestRatio = bestPair.ratio.toFixed(2);

// ---- "Colors that go with…" cross-links (internal-link equity → the 520 pairing pages) ----
// For each hex in this palette, find the nearest COMMON color (redmean perceptual
// distance) and, IF it's a genuine same-family match AND that color has built
// pairing pages, link to one. Zero fabrication: a link only appears when a palette
// hex really is that common color; only contexts that actually build are linked
// (derived from pairingPaths(), the same source getStaticPaths uses). Dedupes by
// common color so a palette maps to a handful of distinct pairing pages.
const PAIRING_MATCH_THRESHOLD = 95; // redmean units — the engine's "same family" cutoff
const CONTEXT_PREFERENCE = ["living-room", "bedroom", "walls", "an-outfit", "clothes"];
const _builtContextsByColor = new Map<string, string[]>();
for (const p of pairingPaths()) {
  const arr = _builtContextsByColor.get(p.color) ?? [];
  arr.push(p.context);
  _builtContextsByColor.set(p.color, arr);
}
const _seenPairColor = new Set<string>();
const pairingCrossLinks: { name: string; slug: string; context: string; ctxLabel: string }[] = [];
for (const c of palette.colors) {
  let best: { slug: string; name: string; d: number } | null = null;
  for (const cc of commonColors) {
    const d = redmean(c.hex, cc.hex);
    if (best === null || d < best.d) best = { slug: cc.slug, name: cc.name, d };
  }
  if (!best || best.d > PAIRING_MATCH_THRESHOLD) continue; // not genuinely that color
  if (_seenPairColor.has(best.slug)) continue;
  const built = _builtContextsByColor.get(best.slug);
  if (!built || built.length === 0) continue; // only link pages that exist
  _seenPairColor.add(best.slug);
  const ctxSlug = CONTEXT_PREFERENCE.find((x) => built.includes(x)) ?? built[0];
  const ctxLabel = contexts.find((x) => x.slug === ctxSlug)?.label ?? ctxSlug.replace(/-/g, " ");
  pairingCrossLinks.push({ name: best.name, slug: best.slug, context: ctxSlug, ctxLabel });
}
const pairingCrossLinksTop = pairingCrossLinks.slice(0, 5);
const wcagVerdict =
  bestPair.ratio >= 7
    ? "clearing the WCAG AAA bar for body text"
    : bestPair.ratio >= 4.5
      ? "meeting the WCAG AA bar for body text"
      : bestPair.ratio >= 3
        ? "usable for large text but not body copy"
        : "below the WCAG text-contrast floor";
const useGuidance =
  bestPair.ratio >= 4.5
    ? "so it holds up for text-on-colour layouts as well as decorative use"
    : "so it reads best in decorative blocks rather than text pairings";
const pairNameA = bestPair.a.nameRomaji ?? bestPair.a.hex;
const pairNameB = bestPair.b.nameRomaji ?? bestPair.b.hex;

const keywords = [
  palette.title,
  `${palette.era} era`,
  `${palette.dominantHue} palette`,
  "color combination",
  "Japanese color",
  "Sanzo Wada",
  ...(palette.tags ?? []),
  ...palette.colors.flatMap((c) => [c.nameRomaji, c.nameJa].filter(Boolean) as string[]),
];

// Freshness signals for LLM citation + Google Freshness (Aleyda #9).
// datePublished: first site publication. dateModified: current build.
// Source: Sanzo Wada, A Dictionary of Color Combinations (1933).
const SITE_FIRST_PUBLISHED = "2026-04-10T00:00:00Z";
// Human-readable form of the constant above — derived, never typed, so the prose
// and the JSON-LD can never drift apart.
const FIRST_PUBLISHED_LABEL = new Date(SITE_FIRST_PUBLISHED).toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const BUILD_DATE = new Date().toISOString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: palette.title,
    alternateName: palette.titleJa,
    description: palette.summary,
    url: new URL(`/palettes/${palette.slug}`, Astro.site).toString(),
    abstract: palette.description,
    keywords: keywords.join(", "),
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
    ...(isWada ? { dateCreated: "1933-01-01" } : { dateCreated: SITE_FIRST_PUBLISHED }),
    inLanguage: "en",
    ...(isWada
      ? {
          isBasedOn: {
            "@type": "Book",
            name: "A Dictionary of Color Combinations",
            author: { "@type": "Person", name: "Sanzo Wada" },
            datePublished: "1933",
            publisher: "Seigensha Art Publishing (2010 reprint)",
          },
        }
      : {
          creator: {
            "@type": "Organization",
            name: "The Dictionary of Color Combinations",
            url: "https://colorcombinations.org",
          },
        }),
    license: "https://creativecommons.org/licenses/by/4.0/",
    publisher: {
      "@type": "Organization",
      name: "The Dictionary of Color Combinations",
      url: "https://colorcombinations.org",
    },
    about: palette.colors.map((c) => ({
      "@type": "Thing",
      name: c.nameRomaji ?? c.hex,
      description: c.meaning,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Browse",
        item: new URL("/browse", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: palette.title,
      },
    ],
  },
  // FAQPage + Speakable per rules/seo-geo-mastery.md Part 14.
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${new URL(`/palettes/${palette.slug}`, Astro.site).toString()}#faq`,
    mainEntity: [
      {
        "@type": "Question",
        name: `What colors are in the "${palette.title}" palette?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `${palette.title}${palette.titleJa ? ` (${palette.titleJa})` : ""} contains ${palette.colors.length} colors: ${palette.colors.map((c) => `${c.nameRomaji ?? c.hex} (${c.hex})`).join(", ")}. ${isWada ? `From Sanzo Wada's "A Dictionary of Color Combinations" (1933).` : `An original editorial palette by colorcombinations.org, using traditional Japanese colour names.`}`,
        },
      },
      {
        "@type": "Question",
        name: `When was the "${palette.title}" palette created?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: isWada
            ? `This palette is from Sanzo Wada's 1933 reference work "A Dictionary of Color Combinations" (Seigensha Art Publishing 2010 reprint). The source work is in the public domain.`
            : `This palette was composed by the editors of colorcombinations.org and first published in ${FIRST_PUBLISHED_LABEL}. It uses traditional Japanese colour names associated with the ${palette.era} era; it is not a plate from Sanzo Wada's 1933 dictionary.`,
        },
      },
      {
        "@type": "Question",
        name: `What style or era does the "${palette.title}" palette belong to?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `${palette.title} is associated with the ${palette.era} era and emphasizes ${palette.dominantHue} tones. ${palette.summary}`,
        },
      },
      {
        "@type": "Question",
        name: `Can I use the "${palette.title}" palette in my own design?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: isWada
            ? `Yes. The source palette by Sanzo Wada (1933) is in the public domain. This page's curation and metadata are CC BY 4.0 licensed — attribution to colorcombinations.org appreciated but not required for the colors themselves.`
            : `Yes. This editorial palette and its metadata are CC BY 4.0 licensed — attribution to colorcombinations.org appreciated; the hex values themselves are facts and free to use.`,
        },
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${new URL(`/palettes/${palette.slug}`, Astro.site).toString()}#speakable`,
    speakable: { "@type": "SpeakableSpecification", cssSelector: [".cc-palette-intro"] },
  },
];
---

<BaseLayout
  adContent
  title={title}
  description={description}
  keywords={keywords}
  image={ogImage}
  jsonAlternate={`/api/palettes/${palette.slug}.json`}
  type="article"
  jsonLd={jsonLd}
>
  {/* ============ BREADCRUMB ============ */}
  <nav class="breadcrumb container-wide" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/browse">Browse</a></li>
      <li aria-hidden="true">›</li>
      <li aria-current="page">{palette.title}</li>
    </ol>
  </nav>

  {/* ============ HERO ============ */}
  <section class="palette-hero">
    <div class="container-wide palette-hero__inner">
      <div class="palette-hero__meta">
        <p class="eyebrow">
          {palette.era.charAt(0).toUpperCase() + palette.era.slice(1)} era
          · {palette.moods.join(" · ")}
        </p>
        <h1 class="display-hero text-balance">
          {palette.title}
          {palette.titleJa && (
            <span class="palette-hero__ja title-ja">{palette.titleJa}</span>
          )}
        </h1>
        <p class="palette-hero__summary cc-palette-intro">{palette.summary}</p>
      </div>
    </div>
  </section>

  {/* ============ SWATCHES ============ */}
  <section class="swatch-section">
    <div class="container-wide">
      <div class="swatch-row" style={`--swatch-count: ${palette.colors.length};`}>
        {palette.colors.map((color) => {
          const textTone = bestTextColorOn(color.hex);
          const colorSlug = (color.nameRomaji ?? color.hex)
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/(^-|-$)/g, "");
          return (
            <div
              class={`swatch-block swatch-block--${textTone}`}
              style={`background-color: ${color.hex};`}
            >
              <div class="swatch-block__inner">
                {color.nameJa && <p class="swatch-block__ja">{color.nameJa}</p>}
                {color.nameRomaji && (
                  <p class="swatch-block__romaji">
                    <a href={`/colors/${colorSlug}/`} class={`swatch-link swatch-link--${textTone}`}>{color.nameRomaji}</a>
                  </p>
                )}
                <p class="swatch-block__hex">
                  <code>{color.hex}</code>
                </p>
                {color.meaning && <p class="swatch-block__meaning">{color.meaning}</p>}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ============ QUICK SHARE STRIP ============ */}
  <div class="container-wide">
    <div class="quick-share" data-palette-slug={palette.slug}>
      <button
        type="button"
        class="quick-share__btn"
        id="copy-hex-all"
        data-hexes={palette.colors.map((c) => c.hex).join(", ")}
        data-event="copy_hex_all"
        aria-label="Copy all hex values for this palette"
      >
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
          <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" stroke="currentColor" stroke-width="1.25" fill="none"/>
        </svg>
        Copy hex values
      </button>
      <a
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${palette.title}${palette.titleJa ? ` (${palette.titleJa})` : ""} — ${isWada ? `a plate from Sanzo Wada's 1933 Dictionary of Color Combinations` : `a ${palette.era}-era-inspired editorial palette from colorcombinations.org`}\n${palette.colors.map((c) => c.hex).join("  ")}\n#ColorPalette #DesignInspiration #JapaneseColors`)}&url=${encodeURIComponent(`https://colorcombinations.org/palettes/${palette.slug}/`)}`}
        class="quick-share__btn quick-share__btn--tweet"
        target="_blank"
        rel="noopener"
        data-event="quick_share_twitter"
        aria-label="Share on Twitter/X"
      >
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M12.3 2h2.1l-4.6 5.3L15 14h-4.2L7.5 9.7 3.7 14H1.6l4.9-5.6L1.3 2h4.3l3 4 3.7-4zm-.7 10.7h1.2L4.6 3.2H3.3l8.3 9.5z" />
        </svg>
        Share
      </a>
      <button
        type="button"
        class="quick-share__btn quick-share__btn--download"
        id="download-share-card"
        data-slug={palette.slug}
        data-title={palette.title}
        data-title-ja={palette.titleJa ?? ""}
        data-era={palette.era}
        data-colors={JSON.stringify(palette.colors.map((c) => ({ hex: c.hex, name: c.nameRomaji ?? c.nameJa ?? "" })))}
        data-event="download_share_card"
        aria-label="Download 1200×630 share card image"
      >
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 2v8M5 7l3 3 3-3M2 12h12" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Save image
      </button>
      <span class="quick-share__status" aria-live="polite" role="status"></span>
    </div>
  </div>

  {/* ============ BODY + EXPORT ============ */}
  <section class="section">
    <div class="container-wide palette-body">
      <article class="palette-body__prose prose">
        <h2>About this combination</h2>
        <p>{palette.description}</p>

        {palette.usage && palette.usage.length > 0 && (
          <>
            <h2>Where it works</h2>
            <ul>
              {palette.usage.map((u) => <li>{u}</li>)}
            </ul>
          </>
        )}

        <h2>Historical context</h2>
        <p>
          {isWada ? (
            <>
              {plateLabel} anchors {colorList} in the {palette.dominantHue} family —
              a {palette.colors.length}-colour grouping with a {palette.moods.join(", ")}
              {" "}character, recorded in Sanzo Wada's 1933
              <em> Dictionary of Color Combinations</em> (six volumes; Seigensha Art
              Publishing 2010 reprint), and in the public domain by age.
            </>
          ) : (
            <>
              {plateLabel} anchors {colorList} in the {palette.dominantHue} family —
              a {palette.colors.length}-colour grouping with a {palette.moods.join(", ")}
              {" "}character. It is an original composition by the editors of
              colorcombinations.org, built with Wada's method from traditional Japanese
              {" "}<em>shikisai</em> colour names associated with the {eraLabel} era; it is
              not one of the 348 plates in Wada's 1933
              <em> Dictionary of Color Combinations</em>.
            </>
          )}
          {palette.colors.length >= 2 && (
            <>
              {" "}Its strongest pairing — {pairNameA} on {pairNameB} — reaches a
              contrast ratio of {bestRatio}:1, {wcagVerdict}, {useGuidance}.
            </>
          )}
        </p>

        {/*
          PEAK-INTENT BUY BLOCK. Placement is the point: the reader has just
          read the plate and has the hex codes; "what do I do with these" is
          the question they actually hold at this line. It used to sit in the
          sidebar as a rotating two-of-ten shelf, below the fold, which on many
          pages surfaced two of the cheapest items in the catalogue.

          This is a MOVE, not an addition — the sidebar shelf is gone, so the
          page carries the same number of commercial blocks as before, at
          better placement and with all three destinations guaranteed a slot.
          Density stays inside the museum-identity constraint in
          src/config/monetization.ts (no ad network, one tasteful block).
        */}
        <div class="palette-destination">
          <PaintThisPalette
            title={`Taking ${palette.title} off the screen`}
            intro="A hex code is an instruction to a screen, not a colour. Where this palette is going decides what it needs next."
            offset={supplyOffset}
            variant="destination"
          />
        </div>
      </article>

      <aside class="palette-body__aside" aria-label="Export and metadata">
        <ExportPalette palette={palette} />

        <div class="palette-meta plate">
          <h3>Details</h3>
          <dl>
            <dt>Era</dt>
            <dd>{palette.era.charAt(0).toUpperCase() + palette.era.slice(1)}</dd>
            <dt>Dominant hue</dt>
            <dd>{palette.dominantHue}</dd>
            <dt>Moods</dt>
            <dd>{palette.moods.join(", ")}</dd>
            <dt>Colors</dt>
            <dd>{palette.colors.length}</dd>
          </dl>
        </div>

        <ContrastMatrix palette={palette} />

        <ShareBar title={shareTitle} url={pageUrl} tweetText={shareTweetText} pinterestMedia={sharePinterestMedia} />

        <div class="palette-library plate">
          <FurtherReading
      pageClass="palette"
            title="Go deeper on colour"
            intro={`The books behind a palette like ${palette.title} — colour theory, history and reference designers keep close.`}
            limit={1}
            offset={bookOffset}
            variant="sidebar"
          />
        </div>
      </aside>
