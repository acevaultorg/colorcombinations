---
/**
 * /embed/[slug] — iframe-embeddable palette swatch strip (320×80px).
 * No header, no footer, minimal HTML. Designed for `<iframe>` embeds on
 * third-party sites. Each strip links back to the full palette page.
 *
 * Usage:
 *   <iframe src="https://colorcombinations.org/embed/kurenai-kon/"
 *           width="320" height="80" frameborder="0"
 *           style="border-radius:6px;overflow:hidden;"
 *           title="Crimson & Navy color palette — colorcombinations.org">
 *   </iframe>
 */
import { allPalettes, paletteBySlug } from "@data/palettes";
import { bestTextColorOn } from "@/lib/color";

export async function getStaticPaths() {
  return allPalettes().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const palette = paletteBySlug(slug ?? "");

if (!palette) {
  return Astro.redirect("/404");
}

const paletteUrl = `https://colorcombinations.org/palettes/${palette.slug}/`;
const hexList = palette.colors.map((c) => c.hex).join(" · ");
const title = `${palette.title} color palette — colorcombinations.org`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 320px;
        height: 80px;
        overflow: hidden;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #fff;
      }

      a.embed-wrap {
        display: flex;
        flex-direction: column;
        width: 320px;
        height: 80px;
        text-decoration: none;
        color: inherit;
        overflow: hidden;
        border-radius: 4px;
      }

      .swatch-row {
        display: flex;
        flex: 1;
        min-height: 0;
      }

      .swatch {
        flex: 1;
        display: flex;
        align-items: flex-end;
        padding: 0 4px 3px;
        overflow: hidden;
        transition: flex 0.15s ease;
      }

      .swatch:hover {
        flex: 1.6;
      }

      .swatch__hex {
        font-size: 8px;
        line-height: 1;
        font-family: "SF Mono", "Fira Mono", monospace;
        opacity: 0.85;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: clip;
      }

      .swatch--light .swatch__hex {
        color: rgba(0, 0, 0, 0.7);
      }

      .swatch--dark .swatch__hex {
        color: rgba(255, 255, 255, 0.85);
      }

      .embed-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 7px;
        height: 18px;
        background: #fff;
        border-top: 1px solid #f0ede8;
        flex-shrink: 0;
      }

      .embed-footer__title {
        font-size: 9px;
        color: #555;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 210px;
        font-weight: 500;
      }

      .embed-footer__brand {
        font-size: 8px;
        color: #999;
        white-space: nowrap;
        letter-spacing: 0.02em;
      }
    </style>
  </head>
  <body>
    <a
      class="embed-wrap"
      href={paletteUrl}
      target="_blank"
      rel="noopener noreferrer"
      title={`${palette.title} — ${hexList}`}
      aria-label={`View ${palette.title} palette on colorcombinations.org`}
    >
      <div class="swatch-row">
        {
          palette.colors.map((color) => {
            const tone = bestTextColorOn(color.hex);
            return (
              <div
                class={`swatch swatch--${tone}`}
                style={`background-color:${color.hex};`}
              >
                <span class="swatch__hex">{color.hex}</span>
              </div>
            );
          })
        }
      </div>
      <div class="embed-footer" id="embed-footer">
        <span class="embed-footer__title" id="embed-title">{palette.title}</span>
        <span class="embed-footer__brand">colorcombinations.org</span>
      </div>
    </a>

    {/* Pro Embed — reads ?k=[license] to hide attribution. Optional ?t=[text]
        replaces the palette title with custom agency text. Weak-auth v1:
        license key is a shared-secret URL token from Gumroad, not signed.
        Upgrade path in v2: Cloudflare Function to verify against Gumroad API. */}
    <script>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var licenseKey = params.get("k");
          var customTitle = params.get("t");
          if (licenseKey && licenseKey.length >= 6) {
            var footer = document.getElementById("embed-footer");
            if (footer) footer.style.display = "none";
            document.body.style.height = "62px";
            document.documentElement.style.height = "62px";
            var wrap = document.querySelector("a.embed-wrap") as HTMLAnchorElement | null;
            if (wrap) wrap.style.height = "62px";
          }
          if (customTitle) {
            var titleEl = document.getElementById("embed-title");
            if (titleEl) titleEl.textContent = customTitle.slice(0, 60);
          }
        } catch (e) { /* noop */ }
      })();
    </script>
  </body>
</html>
