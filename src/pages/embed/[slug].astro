---
import EmbedLayout from "@layouts/EmbedLayout.astro";
import { palettes } from "@data/palettes";

export async function getStaticPaths() {
  return palettes.map((p) => ({
    params: { slug: p.slug },
    props: { palette: p },
  }));
}

const { palette } = Astro.props;
const siteUrl = "https://colorcombinations.org";
const paletteUrl = `${siteUrl}/palettes/${palette.slug}/`;
---

<EmbedLayout
  title={palette.title}
  description={palette.summary}
>
  <section class="card">
    <header class="card__head">
      <h1 class="card__title">
        {palette.title}
        {palette.titleJa && <span class="card__title-ja" lang="ja">— {palette.titleJa}</span>}
      </h1>
      <p class="card__summary">{palette.summary}</p>
    </header>

    <div class="card__swatches" role="list" aria-label={`${palette.colors.length} colors`}>
      {palette.colors.map((c) => (
        <div class="swatch" role="listitem" style={`background-color: ${c.hex};`}>
          <div class="swatch__meta">
            <span class="swatch__hex">{c.hex}</span>
            {c.nameRomaji && <span class="swatch__name">{c.nameRomaji}</span>}
          </div>
        </div>
      ))}
    </div>

    <footer class="card__foot">
      <a href={paletteUrl} target="_blank" rel="noopener">
        View on colorcombinations.org →
      </a>
    </footer>
  </section>
</EmbedLayout>

<style>
  .card {
    max-width: 100%;
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--bg);
  }

  .card__head {
    margin-bottom: 0.75rem;
  }

  .card__title {
    font-family: "EB Garamond", Georgia, serif;
    font-size: 1.0625rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .card__title-ja {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .card__summary {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
    margin: 0;
  }

  .card__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(60px, 1fr));
    gap: 4px;
    margin: 0.75rem 0;
    border-radius: 3px;
    overflow: hidden;
  }

  .swatch {
    aspect-ratio: 1;
    position: relative;
    border: 1px solid rgba(20, 20, 20, 0.08);
    border-radius: 2px;
  }

  .swatch__meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2px 4px;
    background: rgba(250, 247, 239, 0.92);
    font-size: 0.625rem;
    font-family: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.1;
  }

  .swatch__hex {
    font-weight: 500;
  }

  .swatch__name {
    font-family: "Inter", sans-serif;
    font-size: 0.5625rem;
    color: var(--muted);
  }

  .card__foot {
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
  }

  .card__foot a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .card__foot a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141414;
      --ink: #faf7ef;
      --muted: #bcbcbe;
      --border: #2b2b2b;
    }

    .swatch__meta {
      background: rgba(20, 20, 20, 0.9);
    }
  }
</style>
