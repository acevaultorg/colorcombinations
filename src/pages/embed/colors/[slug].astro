---
/**
 * /embed/colors/[slug] — iframe-embeddable single-color card (360×180px).
 *
 * Shows the color's swatch (large), hex, name, Japanese name, meaning, and
 * palette count. Entire card links back to /colors/[slug]/ on
 * colorcombinations.org. Designed for design-theory blog posts,
 * color-study reference pages, and online color palette write-ups.
 *
 * Usage:
 *   <iframe src="https://colorcombinations.org/embed/colors/kurenai/"
 *           width="360" height="180" frameborder="0"
 *           style="border-radius:8px;overflow:hidden;"
 *           title="Kurenai (紅) — colorcombinations.org">
 *   </iframe>
 */
import { allColors, colorBySlug } from "@/data/colors";

export async function getStaticPaths() {
  return allColors().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const color = colorBySlug(slug ?? "");

if (!color) {
  return Astro.redirect("/404");
}

// Luminance-aware text color on the swatch
function textColorOn(hex: string): string {
  const r = parseInt(hex.slice(1, 3), 16) / 255;
  const g = parseInt(hex.slice(3, 5), 16) / 255;
  const b = parseInt(hex.slice(5, 7), 16) / 255;
  const toLinear = (c: number): number =>
    c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  const lum =
    0.2126 * toLinear(r) + 0.7152 * toLinear(g) + 0.0722 * toLinear(b);
  return lum > 0.55 ? "dark" : "light";
}

const tone = textColorOn(color.hex);
const colorUrl = `https://colorcombinations.org/colors/${color.slug}/`;
const title = `${color.name}${color.nameJa ? ` (${color.nameJa})` : ""} — colorcombinations.org`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <style define:vars={{ swatch: color.hex }}>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 360px;
        height: 180px;
        overflow: hidden;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #fff;
      }

      a.embed-wrap {
        display: flex;
        width: 360px;
        height: 180px;
        text-decoration: none;
        color: inherit;
        overflow: hidden;
        border-radius: 6px;
      }

      .swatch {
        width: 180px;
        height: 180px;
        background: var(--swatch);
        flex-shrink: 0;
        position: relative;
      }

      .swatch__hex {
        position: absolute;
        bottom: 10px;
        left: 12px;
        font-size: 11px;
        font-family: "SF Mono", "Fira Mono", ui-monospace, monospace;
        letter-spacing: 0.02em;
      }

      .swatch--dark .swatch__hex {
        color: rgba(0, 0, 0, 0.78);
      }

      .swatch--light .swatch__hex {
        color: rgba(255, 255, 255, 0.9);
      }

      .meta {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 18px 16px 14px;
        background: #fff;
        min-width: 0;
      }

      .meta__eyebrow {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: #9A2A2A;
      }

      .meta__name {
        font-family: "Georgia", "EB Garamond", serif;
        font-size: 22px;
        font-weight: 500;
        color: #141414;
        margin-top: 4px;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .meta__name-ja {
        font-size: 13px;
        color: #8a8a8a;
        margin-top: 2px;
      }

      .meta__meaning {
        font-size: 11px;
        color: #6b6b6b;
        margin-top: 8px;
        line-height: 1.35;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }

      .meta__foot {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 9px;
        color: #9a9a9a;
        letter-spacing: 0.02em;
      }

      .meta__count {
        color: #6b6b6b;
      }
    </style>
  </head>
  <body>
    <a
      class="embed-wrap"
      href={colorUrl}
      target="_blank"
      rel="noopener noreferrer"
      title={`${color.name}${color.nameJa ? ` (${color.nameJa})` : ""} — ${color.hex}`}
      aria-label={`View ${color.name} on colorcombinations.org`}
    >
      <div class={`swatch swatch--${tone}`}>
        <span class="swatch__hex">{color.hex.toUpperCase()}</span>
      </div>
      <div class="meta">
        <span class="meta__eyebrow">COLOR</span>
        <span class="meta__name">{color.name}</span>
        {color.nameJa && <span class="meta__name-ja">{color.nameJa}</span>}
        {color.meaning && <p class="meta__meaning">{color.meaning}</p>}
        <div class="meta__foot">
          <span class="meta__count">{color.paletteCount} palette{color.paletteCount === 1 ? "" : "s"}</span>
          <span>colorcombinations.org</span>
        </div>
      </div>
    </a>
  </body>
</html>
