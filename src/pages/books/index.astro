---
/**
 * /books — the shelf.
 *
 * The hub half of the books surface: it routes to the per-book pages rather
 * than straight out to Amazon. Hubs acquire, entity pages convert — sending a
 * browsing reader to a retailer before they know which book they want is how a
 * click gets spent on the wrong page.
 *
 * The existing FurtherReading component (on /about, /shop and the palette
 * sidebar) is deliberately untouched: those placements are inside a running
 * 28-day measurement window comparing the book shelf against the art-supply
 * shelf. This route is additive, so it doesn't disturb that reading.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { FURTHER_READING, bookCover } from "@/config/monetization";

const title = "The shelf — books on colour";
const description =
  "The books this archive keeps on its shelf: Sanzo Wada's two dictionaries, Albers, Finlay, St. Clair and the working references behind them. What each one is for, and what this archive already gives you free.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Books on colour — the Dictionary of Color Combinations shelf",
  description,
  numberOfItems: FURTHER_READING.length,
  itemListElement: FURTHER_READING.map((book, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/books/${book.slug}/`, Astro.site).toString(),
    name: book.title,
  })),
};

/* AD POLICY — these pages deliberately do NOT pass `adContent` to BaseLayout.
 *
 * They are 75-215 words (median 94), and `revenue-maximizer` forbids display
 * ads on pages under 250 words of unique content (thin-content signal to the
 * ad network). Mediavine Journey approved this site 2026-09-04, so the
 * new-publisher review risk is live.
 *
 * Do NOT "fix" this by padding the pages. The zero-fabrication rule in this
 * file's header is correct: measured 2026-09-06, Open Library carries
 * publisher/year/page-count for 13/13 of the ISBNs in FURTHER_READING but
 * description 0/13 and excerpts 0/13. No source reaches 250 words, so the
 * honest fix is to stop serving in-content ads here, not to invent prose.
 *
 * Cost measured, not assumed: /books/ is 164 of 16,228 pageviews = 1.01%.
 * The Amazon CTA is untouched -- this is the site's best AI-converting template
 * (42.2% of AI-channel Amazon clicks) and that path must not be disturbed.
 * Same mechanism /privacy/, /terms/, /contact/, /about/ and 404 already use. */

---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  keywords={["books on color", "color theory books", "Sanzo Wada", "design books"]}
>
  <div class="shelf">
    <header class="shelf__head">
      <p class="eyebrow">Library</p>
      <h1 class="text-balance">The shelf</h1>
      <p class="shelf__intro">
        Eleven books on colour — the two Wada dictionaries this archive is built
        from, and the references that sit next to them on a working desk. Each
        has its own page explaining what it's for and, where it applies, what
        this archive already holds free.
      </p>
    </header>

    <ul class="shelf__list" role="list">
      {FURTHER_READING.map((book) => {
        const coverUrl = bookCover(book, "M");
        const initials = book.title
          .split(/\s+/)
          .slice(0, 2)
          .map((w) => w[0])
          .join("")
          .toUpperCase();

        return (
          <li class="shelf__item">
            <a href={`/books/${book.slug}/`} class="shelf__link">
              <span class="shelf__cover">
                {coverUrl ? (
                  <img
                    src={coverUrl}
                    alt={`${book.title} by ${book.author} — book cover`}
                    width="200"
                    height="300"
                    loading="lazy"
                    decoding="async"
                    onerror="this.classList.add('is-missing')"
                    onload="if (this.naturalWidth < 10) this.classList.add('is-missing')"
                  />
                ) : null}
                <span class="shelf__cover-fallback" aria-hidden="true">
                  {initials}
                </span>
              </span>
              <span class="shelf__meta">
                <span class="shelf__author">{book.author}</span>
                <span class="shelf__title">{book.title}</span>
                <span class="shelf__note">{book.note}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <p class="shelf__disclosure">
      Book pages carry Amazon Associates affiliate links. Your price is
      unchanged; as an Amazon Associate we earn from qualifying purchases.
    </p>
  </div>
</BaseLayout>

<style>
  .shelf {
    max-width: var(--content-width, 72rem);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter, 1.25rem);
    padding-block: var(--spacing-section, 3rem);
  }

  .shelf__head {
    max-width: 60ch;
    margin-bottom: 3rem;
  }

  .shelf__head h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 3vw + 1rem, 3rem);
    line-height: 1.1;
    margin: 0.5rem 0 1rem;
  }

  .shelf__intro {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-700);
    margin: 0;
  }

  .shelf__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .shelf__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .shelf__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .shelf__link {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 1.25rem;
    height: 100%;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-plate);
  }

  .shelf__link:hover {
    border-color: var(--color-accent-500);
  }

  .shelf__cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-paper-100);
  }

  .shelf__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
  }

  .shelf__cover img.is-missing {
    display: none;
  }

  .shelf__cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-ink-500);
    background: linear-gradient(
      135deg,
      var(--color-paper-100) 0%,
      var(--color-paper-200) 100%
    );
    z-index: 1;
  }

  .shelf__meta {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .shelf__author {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    margin-bottom: 0.25rem;
  }

  .shelf__title {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-ink-900);
    margin-bottom: 0.375rem;
  }

  .shelf__note {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-ink-500);
  }

  .shelf__disclosure {
    margin-top: 2.5rem;
    font-size: 0.75rem;
    font-style: italic;
    color: var(--color-ink-400);
    max-width: 60ch;
    line-height: 1.5;
  }
</style>
