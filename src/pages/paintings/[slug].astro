---
import BaseLayout from "@layouts/BaseLayout.astro";
import ExportPalette from "@components/ExportPalette.astro";
import ContrastMatrix from "@components/ContrastMatrix.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";
import FurtherReading from "@components/FurtherReading.astro";
import { allPaintings, paintingBySlug, relatedPaintings } from "@data/paintings";
import { paintingAsPalette, sharePct } from "@/lib/painting";
import { bestTextColorOn } from "@/lib/color";
import sizes from "@data/painting-image-sizes.json";

export async function getStaticPaths() {
  return allPaintings().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const painting = paintingBySlug(slug ?? "");
if (!painting) return Astro.redirect("/404");

const asPalette = paintingAsPalette(painting);
const related = relatedPaintings(painting, 3);
const dims = (sizes as Record<string, { w: number; h: number }>)[painting.slug];
const idx = allPaintings().findIndex((p) => p.slug === painting.slug);

const title = `${painting.title} Colour Palette — ${painting.artist} | Hex Codes`;
const description =
  `${painting.colors.length} hex codes sampled from ${painting.artist}'s ${painting.title} (${painting.year}), ` +
  `with WCAG contrast, CSS and Tailwind export` +
  (painting.pigments.length ? `, and the pigments the artist actually used.` : `.`);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "VisualArtwork",
    name: painting.title,
    creator: { "@type": "Person", name: painting.artist },
    dateCreated: painting.year,
    artMedium: "Painting",
    locationCreated: undefined,
    isPartOf: painting.museum,
    url: new URL(`/paintings/${painting.slug}/`, Astro.site).href,
    image: new URL(`/paintings/${painting.slug}.jpg`, Astro.site).href,
    // The palette is the value this page adds on top of the artwork record.
    additionalProperty: painting.colors.map((c) => ({
      "@type": "PropertyValue",
      name: "Palette colour",
      value: c.hex,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Painting palettes", item: new URL("/paintings/", Astro.site).href },
      { "@type": "ListItem", position: 3, name: painting.title },
    ],
  },
];
import { contentDate } from "@/lib/contentDate";
/* Honest article:modified_time — BaseLayout omits it entirely rather than
 * defaulting to the build clock, so pages with a real date pass one. */
const CONTENT_MODIFIED = contentDate("src/pages/paintings/[slug].astro", "src/data/paintings.ts");
---

<BaseLayout
  adContent
  title={title}
  description={description}
  type="article"
  modifiedTime={CONTENT_MODIFIED}
  image={`/paintings/${painting.slug}.jpg`}
  jsonLd={jsonLd}
  keywords={[
    `${painting.title} color palette`,
    `${painting.artist} colors`,
    `${painting.title} hex codes`,
    "painting color palette",
  ]}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">/</span>
    <a href="/paintings/">Painting palettes</a> <span aria-hidden="true">/</span>
    <span aria-current="page">{painting.title}</span>
  </nav>

  <article class="painting">
    <header class="painting__head">
      <p class="eyebrow">{painting.artist} · {painting.year}</p>
      <h1 class="text-balance">{painting.title}</h1>
      <p class="painting__summary text-balance">{painting.summary}</p>
      <p class="painting__where">{painting.museum}</p>
    </header>

    <!-- Direct answer first: the hex codes are what the page was opened for. -->
    <section class="swatches" aria-label="Palette">
      <ol class="swatches__row" role="list">
        {painting.colors.map((c) => (
          <li
            class="swatch"
            style={`background:${c.hex};color:${bestTextColorOn(c.hex as `#${string}`) === "light" ? "#fff" : "#111"}`}
          >
            <button class="swatch__copy" type="button" data-hex={c.hex} aria-label={`Copy ${c.hex}`}>
              <span class="swatch__hex">{c.hex}</span>
              <span class="swatch__meta">
                {sharePct(c.share)} of canvas
                {c.role === "accent" && <span class="swatch__role"> · accent</span>}
              </span>
            </button>
          </li>
        ))}
      </ol>
      <p class="swatches__note">
        Tap any swatch to copy. <strong>Ground</strong> colours are the three largest areas of the
        canvas; <strong>accent</strong> colours are chosen for intensity and may cover very little —
        which is exactly why they carry the painting. Percentages are each colour's share of the
        whole canvas, so these six will not add up to 100%: they are six of the 26 distinct colour
        regions measured, not a division of the surface.
        <a href="/paintings/methodology/">How these were sampled</a>
      </p>
    </section>

    <figure class="painting__figure">
      <img
        src={`/paintings/${painting.slug}.jpg`}
        alt={`${painting.title} by ${painting.artist}, ${painting.year}`}
        width={dims?.w ?? 900}
        height={dims?.h ?? 700}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        {painting.artist}, <cite>{painting.title}</cite> ({painting.year}). {painting.museum}.
        <a href={painting.image.commonsPage} rel="noopener nofollow" target="_blank">
          {painting.image.license}
        </a>
      </figcaption>
    </figure>

    <section class="prose">
      {painting.story.map((para) => <p>{para}</p>)}
    </section>

    {painting.pigments.length > 0 && (
      <section class="pigments">
        <h2>What the artist actually used</h2>
        <dl class="pigments__list">
          {painting.pigments.map((pig) => (
            <div class="pigments__item">
              <dt>{pig.name}</dt>
              <dd>{pig.note}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {painting.shift && (
      <section class="shift">
        <h2>Has the colour changed?</h2>
        <p>{painting.shift}</p>
      </section>
    )}

    {painting.sources.length > 0 && (
      <section class="sources">
        <h2>Sources</h2>
        <ul role="list">
          {painting.sources.map((s) => (
            <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    <ContrastMatrix palette={asPalette} />
    <ExportPalette palette={asPalette} />

    <!-- Monetisation sits after the reader has the hex codes in hand — the point
         at which someone studying a palette is most likely to be about to make
         something. Offset rotates the shelf so different paintings lead with
         different tools. -->
    <PaintThisPalette
      offset={idx}
      intro="These are the materials a colour study actually gets made with."
    />

    {related.length > 0 && (
      <nav class="related" aria-label="Related paintings">
        <h2>Closest palettes in the collection</h2>
        <ul role="list" class="related__grid">
          {related.map((r) => (
            <li>
              <a href={`/paintings/${r.slug}/`}>
                <span class="related__chips" aria-hidden="true">
                  {r.colors.slice(0, 5).map((c) => (
                    <span style={`background:${c.hex}`}></span>
                  ))}
                </span>
                <strong>{r.title}</strong>
                <em>{r.artist}</em>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <FurtherReading
      pageClass="painting" limit={3} />
  </article>
</BaseLayout>

<script>
  // Copy-to-clipboard, delegated so it costs one listener regardless of swatch count.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLElement>(".swatch__copy");
    if (!btn) return;
    const hex = btn.dataset.hex;
    if (!hex) return;
    navigator.clipboard?.writeText(hex).then(() => {
      const label = btn.querySelector(".swatch__hex");
      if (!label) return;
      const prev = label.textContent;
      label.textContent = "copied";
      setTimeout(() => { label.textContent = prev; }, 900);
    });
  });
</script>

<style>
  .crumbs { font-size: .8rem; opacity: .7; margin-bottom: 1.5rem; display: flex; gap: .4rem; flex-wrap: wrap; }
  .crumbs a { color: inherit; }

  .painting__head { margin-bottom: 2rem; }
  .painting__summary { font-size: 1.15rem; line-height: 1.6; margin-top: .75rem; }
  .painting__where { font-size: .85rem; opacity: .7; margin-top: .5rem; }

  .swatches { margin: 2rem 0; }
  .swatches__row { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 0; border-radius: 10px; overflow: hidden; list-style: none; padding: 0; margin: 0; }
  .swatch { position: relative; }
  .swatch__copy { all: unset; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-end; gap: .15rem; width: 100%; min-height: 132px; padding: .75rem; cursor: pointer; font: inherit; color: inherit; }
  .swatch__copy:focus-visible { outline: 3px solid currentColor; outline-offset: -6px; }
  .swatch__hex { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .82rem; font-weight: 600; letter-spacing: .02em; }
  .swatch__meta { font-size: .7rem; opacity: .85; }
  .swatches__note { font-size: .82rem; opacity: .8; margin-top: .75rem; line-height: 1.6; }

  .painting__figure { margin: 2.5rem 0; }
  .painting__figure img { width: 100%; height: auto; border-radius: 10px; display: block; }
  .painting__figure figcaption { font-size: .78rem; opacity: .7; margin-top: .6rem; line-height: 1.5; }

  .prose p { line-height: 1.75; margin-bottom: 1.1rem; }

  .pigments, .shift, .sources { margin: 2.5rem 0; }
  .pigments__list { margin-top: 1rem; }
  .pigments__item { padding: .85rem 0; border-top: 1px solid rgb(0 0 0 / .1); }
  .pigments__item dt { font-weight: 600; margin-bottom: .2rem; }
  .pigments__item dd { margin: 0; opacity: .85; line-height: 1.6; }
  .shift p { line-height: 1.75; }
  .sources li { margin-bottom: .4rem; font-size: .88rem; }

  .related { margin: 3rem 0; }
  .related__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; list-style: none; padding: 0; }
  .related__grid a { display: block; text-decoration: none; color: inherit; }
  .related__chips { display: flex; height: 42px; border-radius: 7px; overflow: hidden; margin-bottom: .5rem; }
  .related__chips span { flex: 1; }
  .related__grid strong { display: block; font-size: .95rem; }
  .related__grid em { font-size: .8rem; opacity: .7; font-style: normal; }

  @media (max-width: 480px) {
    .swatches__row { grid-template-columns: repeat(2, 1fr); }
    .swatch__copy { min-height: 96px; }
  }
</style>
