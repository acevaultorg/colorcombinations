---
import BaseLayout from "@layouts/BaseLayout.astro";
import PaletteCard from "@components/PaletteCard.astro";
import BundleCta from "@components/BundleCta.astro";
import ShareActions from "@components/ShareActions.astro";
import {
  collections,
  collectionBySlug,
  paletteSetForCollection,
} from "@/data/collections";

export function getStaticPaths() {
  return collections.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const collection = collectionBySlug(slug ?? "");

if (!collection) {
  return Astro.redirect("/404");
}

const palettes = paletteSetForCollection(collection);
const total = palettes.length;

// Pillar-article cross-link — when a collection has a matching /learn pillar,
// surface it as a "From the editorial" callout. Compounds internal-link
// density between thematic palettes and long-form context.
import { pillarForCollection } from "@data/pillarMap";
const pillar = pillarForCollection(collection.slug);

const title = collection.title;
const description = collection.description.replace(/<[^>]+>/g, "");

// Freshness signals for LLM citation + Google Freshness (Aleyda #9).
const SITE_FIRST_PUBLISHED = "2026-04-10T00:00:00Z";
const BUILD_DATE = new Date().toISOString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: new URL(`/collections/${collection.slug}`, Astro.site).toString(),
    isPartOf: {
      "@type": "WebSite",
      name: "The Dictionary of Color Combinations",
      url: Astro.site?.toString(),
    },
    numberOfItems: total,
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
    inLanguage: "en",
    license: "https://creativecommons.org/licenses/by/4.0/",
    publisher: {
      "@type": "Organization",
      name: "The Dictionary of Color Combinations",
      url: "https://colorcombinations.org",
    },
    hasPart: palettes.map((p) => ({
      "@type": "CreativeWork",
      name: p.title,
      url: new URL(`/palettes/${p.slug}`, Astro.site).toString(),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Collections",
        item: new URL("/collections", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: collection.title,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={collection.keywords}
  image={`/og/collections/${collection.slug}.svg`}
  type="article"
  jsonAlternate={`/api/collections/${collection.slug}.json`}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb container-wide" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/collections">Collections</a></li>
      <li aria-hidden="true">›</li>
      <li aria-current="page">{collection.title}</li>
    </ol>
  </nav>

  <section class="collection-hero">
    <div class="container-wide collection-hero__inner">
      <div
        class="collection-hero__accent"
        style={`background-color:${collection.accentHex}`}
        aria-hidden="true"
      ></div>
      <p class="eyebrow">Collection · {total} palettes</p>
      <h1 class="display-hero text-balance">{collection.title}</h1>
      <p class="collection-hero__tagline">{collection.tagline}</p>
      <div class="collection-hero__description" set:html={collection.description}></div>
      <ShareActions
        title={collection.title}
        url={new URL(`/collections/${collection.slug}`, Astro.site).toString()}
        image={new URL(`/og/collections/${collection.slug}.svg`, Astro.site).toString()}
        description={`${collection.title} — ${collection.tagline}`}
        heading="Share this collection"
      />
    </div>
  </section>

  <section class="collection-grid-section">
    <div class="container-wide">
      <div class="palette-grid" role="list">
        {palettes.map((palette) => (
          <div role="listitem">
            <PaletteCard palette={palette} headingLevel="h2" />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ EMBED WIDGET ============ */}
  <section class="section collection-embed-section" aria-labelledby="collection-embed-heading">
    <div class="container-wide collection-embed-inner">
      <div class="collection-embed-copy">
        <h2 id="collection-embed-heading" class="collection-embed-heading">
          Embed this collection
        </h2>
        <p class="collection-embed-desc">
          Drop a preview of this collection into any blog post, Notion page,
          or design review. Each palette links back to its full detail page.
        </p>
        <div class="collection-embed-snippet-wrap">
          <code class="collection-embed-snippet" id="collection-embed-code-block">{`<iframe src="https://colorcombinations.org/embed/collection/${collection.slug}/" width="560" height="320" frameborder="0" style="border-radius:8px;overflow:hidden;" title="${collection.title} — colorcombinations.org"></iframe>`}</code>
          <button
            type="button"
            class="collection-embed-copy-btn"
            id="copy-collection-embed-code"
            data-code={`<iframe src="https://colorcombinations.org/embed/collection/${collection.slug}/" width="560" height="320" frameborder="0" style="border-radius:8px;overflow:hidden;" title="${collection.title} — colorcombinations.org"></iframe>`}
            aria-label="Copy embed code"
          >
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
              <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" stroke="currentColor" stroke-width="1.25" fill="none"/>
            </svg>
            Copy code
          </button>
          <span class="collection-embed-copy-status" aria-live="polite" role="status"></span>
        </div>
      </div>
      <div class="collection-embed-preview" aria-label="Embed preview">
        <p class="collection-embed-preview-label">Preview</p>
        <iframe
          src={`/embed/collection/${collection.slug}/`}
          width="560"
          height="320"
          frameborder="0"
          style="border-radius:8px;overflow:hidden;display:block;max-width:100%;"
          title={`${collection.title} collection preview`}
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  {/* Pillar article cross-link — only on collections that have a matching /learn/ pillar */}
  {pillar && (
    <section class="collection-pillar section">
      <div class="container-wide">
        <a href={pillar.href} class="collection-pillar__link">
          <p class="collection-pillar__eyebrow">From the editorial · Long read</p>
          <h2 class="collection-pillar__title">{pillar.title}</h2>
          <p class="collection-pillar__lede">{pillar.lede}</p>
          <span class="collection-pillar__more">Read the article →</span>
        </a>
      </div>
    </section>
  )}

  {/* Other collections — cross-linking for SEO + navigation */}
  <section class="collection-related section">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">Continue exploring</p>
        <h2>Other collections</h2>
      </header>
      <ul class="collection-related__list" role="list">
        {collections
          .filter((c) => c.slug !== collection.slug)
          .slice(0, 4)
          .map((c) => (
            <li>
              <a href={`/collections/${c.slug}`} class="collection-related__link">
                <span
                  class="collection-related__dot"
                  style={`background-color:${c.accentHex}`}
                  aria-hidden="true"
                ></span>
                <span class="collection-related__meta">
                  <span class="collection-related__title">{c.title}</span>
                  <span class="collection-related__tagline">{c.tagline}</span>
                </span>
              </a>
            </li>
          ))}
      </ul>
    </div>
  </section>

  <BundleCta variant="medium" />
</BaseLayout>

<script>
  const embedCopyBtn = document.querySelector<HTMLButtonElement>("#copy-collection-embed-code");
  const embedStatus = document.querySelector<HTMLSpanElement>(".collection-embed-copy-status");
  embedCopyBtn?.addEventListener("click", async () => {
    const code = embedCopyBtn.dataset.code ?? "";
    try {
      await navigator.clipboard.writeText(code);
      if (embedStatus) {
        embedStatus.textContent = "✓ Copied!";
        window.setTimeout(() => {
          if (embedStatus.textContent === "✓ Copied!") embedStatus.textContent = "";
        }, 2000);
      }
    } catch {
      if (embedStatus) embedStatus.textContent = "Select + copy manually";
    }
  });
</script>

<style>
  .breadcrumb {
    padding-top: 1.5rem;
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-ink-500);
  }

  .breadcrumb a {
    color: var(--color-ink-500);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb li[aria-current="page"] {
    color: var(--color-ink-900);
  }

  /* ============ HERO ============ */

  .collection-hero {
    padding-top: 2rem;
    padding-bottom: clamp(2rem, 5vw, 4rem);
    position: relative;
  }

  .collection-hero__inner {
    max-width: 62rem;
    position: relative;
  }

  .collection-hero__accent {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 2rem;
    border: 1px solid var(--color-border);
  }

  .collection-hero .eyebrow {
    margin-bottom: 1rem;
  }

  .collection-hero__tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.4vw + 0.75rem, 1.375rem);
    font-style: italic;
    line-height: 1.55;
    color: var(--color-ink-700);
    margin-top: 1.5rem;
    max-width: 58ch;
  }

  .collection-hero__description {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-700);
    margin-top: 1.5rem;
    max-width: 58ch;
  }

  .collection-hero__description em {
    font-style: italic;
    color: var(--color-ink-900);
  }

  /* ============ GRID ============ */

  .collection-grid-section {
    padding-bottom: 4rem;
  }

  .palette-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(1, 1fr);
  }

  @media (min-width: 640px) {
    .palette-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .palette-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .palette-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ============ EMBED SECTION ============ */

  .collection-embed-section {
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 0;
  }

  .collection-embed-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .collection-embed-inner {
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 3rem;
    }
  }

  .collection-embed-heading {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }

  .collection-embed-desc {
    font-size: 0.9375rem;
    color: var(--color-ink-600);
    margin: 0 0 1.25rem;
    max-width: 50ch;
  }

  .collection-embed-snippet-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }

  .collection-embed-snippet {
    display: block;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    padding: 0.75rem 1rem;
    background: var(--color-paper-100);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-ink-800);
    white-space: pre-wrap;
    word-break: break-all;
    user-select: all;
    margin-bottom: 0.25rem;
  }

  .collection-embed-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.4375rem 0.875rem;
    border: 1px solid var(--color-ink-300);
    background: var(--color-bg-elevated);
    color: var(--color-ink-700);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
    white-space: nowrap;
  }

  .collection-embed-copy-btn:hover {
    border-color: var(--color-ink-700);
    color: var(--color-ink-900);
  }

  .collection-embed-copy-btn svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .collection-embed-copy-status {
    font-size: 0.75rem;
    color: var(--color-accent-500);
    font-weight: 500;
    min-width: 4rem;
  }

  .collection-embed-preview-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-500);
    margin: 0 0 0.625rem;
  }

  /* ============ PILLAR ARTICLE CROSS-LINK ============ */

  .collection-pillar {
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 0;
  }

  .collection-pillar__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .collection-pillar__eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-500);
    font-weight: 600;
    margin: 0 0 0.625rem;
  }

  .collection-pillar__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2vw + 1rem, 2rem);
    line-height: 1.2;
    margin: 0 0 0.75rem;
    color: var(--color-ink-900);
    max-width: 32ch;
  }

  .collection-pillar__lede {
    font-size: 1.0625rem;
    color: var(--color-ink-700);
    line-height: 1.5;
    margin: 0 0 1rem;
    max-width: 60ch;
  }

  .collection-pillar__more {
    color: var(--color-accent-500);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .collection-pillar__link:hover .collection-pillar__title {
    color: var(--color-accent-700);
  }

  /* ============ OTHER COLLECTIONS ============ */

  .collection-related {
    background-color: var(--color-paper-100);
    border-top: 1px solid var(--color-border);
  }

  .section-head {
    max-width: 58ch;
    margin-bottom: 2rem;
  }

  .section-head .eyebrow {
    margin-bottom: 0.75rem;
  }

  .section-head h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2vw + 1rem, 2rem);
    line-height: 1.15;
    margin: 0;
  }

  .collection-related__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .collection-related__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .collection-related__link {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease;
  }

  .collection-related__link:hover {
    border-color: var(--color-ink-900);
  }

  .collection-related__dot {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .collection-related__meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .collection-related__title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-ink-900);
  }

  .collection-related__tagline {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
    margin-top: 0.125rem;
    font-style: italic;
    font-family: var(--font-serif);
  }
</style>
