---
import BaseLayout from "@layouts/BaseLayout.astro";
import PaletteCard from "@components/PaletteCard.astro";
import FurtherReading from "@components/FurtherReading.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";
import BundleCta from "@components/BundleCta.astro";
import ShareActions from "@components/ShareActions.astro";
import {
  collections,
  collectionBySlug,
  paletteSetForCollection,
} from "@/data/collections";

export function getStaticPaths() {
  return collections.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const collection = collectionBySlug(slug ?? "");

if (!collection) {
  return Astro.redirect("/404");
}

const palettes = paletteSetForCollection(collection);
const total = palettes.length;

/* "Other collections" = the two neighbours on each side in collections.ts
 * (wrapping), not the first 4 of the list. 2026-09-28, queue-g: the old
 * `.filter(≠self).slice(0, 4)` sent all 68 sibling links to websites/branding/
 * autumn/spring, so 50+ collections were linked only from /collections/ —
 * including the ones Bing actually shows (y2k 848 impr, art-deco 281, gothic
 * 213, art-nouveau 161; 113d to 2026-09-25). Neighbours in the list are
 * thematically close (the aesthetic collections sit together), and every
 * collection now gets exactly 4 sibling links in. */
const selfIndex = collections.findIndex((c) => c.slug === collection.slug);
const relatedCollections = [-2, -1, 1, 2]
  .map((d) => collections[(selfIndex + d + collections.length) % collections.length])
  .filter((c, i, arr) => c.slug !== collection.slug && arr.findIndex((x) => x.slug === c.slug) === i);

/**
 * Sample up to 6 representative hexes for the share-card canvas. Walk
 * through the first ~3 palettes pulling 2 colors each so the strip
 * reads as a coherent set rather than a single palette duplicated. Dedupe
 * exact-match hexes so a 6-swatch strip never repeats.
 */
const downloadSwatches: { hex: string; name?: string }[] = [];
const seenHex = new Set<string>();
const targetCount = 6;
outer: for (const p of palettes.slice(0, 6)) {
  for (const c of p.colors) {
    const key = c.hex.toLowerCase();
    if (seenHex.has(key)) continue;
    seenHex.add(key);
    downloadSwatches.push({ hex: c.hex, name: c.nameRomaji ?? c.nameJa });
    if (downloadSwatches.length >= targetCount) break outer;
  }
}
// Always lead with the collection accent so the card carries the brand.
if (downloadSwatches.length === 0 || downloadSwatches[0].hex.toLowerCase() !== collection.accentHex.toLowerCase()) {
  downloadSwatches.unshift({ hex: collection.accentHex });
  if (downloadSwatches.length > targetCount) downloadSwatches.length = targetCount;
}

// Pillar-article cross-link — when a collection has a matching /learn pillar,
// surface it as a "From the editorial" callout. Compounds internal-link
// density between thematic palettes and long-form context.
import { pillarForCollection, TRENDS_FALLBACK } from "@data/pillarMap";
// Fall back to the colour-trends editorial when this collection has no /learn
// pillar (51 of 69). Link-concentration test — see TRENDS_FALLBACK in pillarMap.ts
// for the measurement, the success metric and why this is not in pillarForCollection().
const pillar = pillarForCollection(collection.slug) ?? TRENDS_FALLBACK;

// `collection.title` also renders the H1 (below) and the embed-snippet label, so
// the search title gets its own optional field rather than overloading this one.
// Falls back to collection.title when seoTitle is absent — every other collection
// is unchanged. 2026-08-24, Bing CTR test.
const title = collection.seoTitle ?? collection.title;
const description = collection.description.replace(/<[^>]+>/g, "");
// Search-result snippet (2026-09-30). The long intro above ran 304–866 chars as the
// meta description on all 69 collections, so search engines showed an arbitrary
// cut of it or rewrote it. The snippet leads with what the page holds — built only
// from the tagline and the real palette count — and stays near 160.
const snippetCore = `${collection.tagline} ${total} palette${total === 1 ? "" : "s"} with hex codes`;
const snippetSource = ", based on Sanzo Wada's 1933 color dictionary.";
const metaDescription =
  /wada/i.test(collection.tagline) || snippetCore.length + snippetSource.length > 160
    ? `${snippetCore}.`
    : `${snippetCore}${snippetSource}`;

// Freshness signals for LLM citation + Google Freshness (Aleyda #9).
const SITE_FIRST_PUBLISHED = "2026-04-10T00:00:00Z";
/* NO USER-VISIBLE "updated <date>" HERE (2026-09-06).
 * The hero byline used to render `updated {BUILD_DATE}`, which told every
 * reader the collection had been updated TODAY — on every deploy, for a
 * fixed 1933 Sanzo Wada dataset that had not changed. That is a false
 * freshness claim in the half a human actually reads, the inverse of the
 * schema/byline contradiction fixed in 75dcb84.
 *
 * Removed rather than replaced: none of the 10 files in src/data carries a
 * date/curation field (checked), so there is no honest per-collection date
 * to substitute, and inventing one for 70 collections would be fabrication.
 * Same reasoning src/pages/books/[slug].astro already applies at its own
 * line 80. Do NOT re-add a build-clock date here.
 *
 * BUILD_DATE still feeds `dateModified` in the schema below — that is the
 * wider 18-template question, sized and left deliberately open in TaskPeace
 * card mtpuh2vxd18d63, not something to change piecemeal in this file. */
import { contentDate } from "@/lib/contentDate";
/* Honest dateModified: the newest git commit date of this template and
 * the data it renders, NOT the build clock. See src/lib/contentDate.ts. */
const BUILD_DATE = contentDate("src/pages/collections/[slug].astro", "src/data/collections.ts");

// Named human author (E-E-A-T / GEO "Credible" + "Recognizable"). Same @id as the
// trends page so the entity is one Person site-wide. Task mtjaxsmk36hi9v, 2026-09-02.
const SITE_URL = "https://colorcombinations.org/";
const AUTHOR = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}#person-paulo-de-vries`,
  name: "Paulo de Vries",
  jobTitle: "Founder + editor, The Dictionary of Color Combinations",
  url: `${SITE_URL}about/`,
  worksFor: { "@id": `${SITE_URL}#organization` },
  sameAs: ["https://paulodevries.com/", "https://www.linkedin.com/in/paulomichaeldevries"],
};

/**
 * FAQ — SINGLE SOURCE for both the FAQPage schema below AND the visible <section>
 * at the bottom of this page. They must not drift apart.
 *
 * Why (2026-09-22): this template shipped FAQPage JSON-LD that rendered NOWHERE —
 * measured live on 5 non-adjacent collections (autumn, branding, websites, summer,
 * green), 4/4 questions absent from the rendered HTML on every one, while
 * /palettes/[slug] (4/4) and /trends/color-trends-2026 (6/6) rendered theirs
 * correctly. Same defect and same remedy as the 2026-09-06 §E46/§E47/§E48 pass,
 * which measured 1,364 of 1,529 crawled pages shipping unrendered FAQPage and
 * fixed /palettes/[slug] + /colors/[slug] (82922e1) — this template was simply
 * never reached by it.
 *
 * Rendering rather than deleting, per that pass's recorded decision: FAQ rich
 * results were deprecated 2026-05-07, so the schema's only remaining purpose is
 * AI extraction, and AI extractors read RENDERED content. The answers here are
 * substantive and computed per collection (count, curation basis, licence,
 * provenance), so they earn their place as visible copy.
 */
const collectionFaq: { q: string; a: string }[] = [
  {
    q: `What is in the "${collection.title}" collection?`,
    a: `${collection.title} is a curated collection of ${total} historical color palettes from Sanzo Wada's "A Dictionary of Color Combinations" (1933). ${collection.tagline}`,
  },
  {
    q: `How was the "${collection.title}" collection curated?`,
    a: `Editorial curation by colorcombinations.org. ${description} Palettes are grouped by thematic resonance — mood, era, or visual language — not algorithmic similarity.`,
  },
  {
    q: `Can I embed or share the "${collection.title}" collection?`,
    a: `Yes. Use the embed iframe (560×320) shown on the page for blogs, Notion pages, or design reviews. Each embedded palette links back to its full detail page. Share image (1200×630) auto-generated per collection. License: CC BY 4.0.`,
  },
  {
    q: `Where does the "${collection.title}" source material come from?`,
    a: `Source: Sanzo Wada, "A Dictionary of Color Combinations" (1933, Seigensha Art Publishing 2010 reprint). The Wada catalog is in the public domain. Curation, descriptions, and groupings here are CC BY 4.0 licensed.`,
  },
];

const jsonLd = [
  AUTHOR,
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: new URL(`/collections/${collection.slug}`, Astro.site).toString(),
    author: { "@id": `${SITE_URL}#person-paulo-de-vries` },
    isPartOf: {
      "@type": "WebSite",
      name: "The Dictionary of Color Combinations",
      url: Astro.site?.toString(),
    },
    numberOfItems: total,
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
    inLanguage: "en",
    license: "https://creativecommons.org/licenses/by/4.0/",
    publisher: {
      "@type": "Organization",
      name: "The Dictionary of Color Combinations",
      url: "https://colorcombinations.org",
    },
    hasPart: palettes.map((p) => ({
      "@type": "CreativeWork",
      name: p.title,
      url: new URL(`/palettes/${p.slug}`, Astro.site).toString(),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Collections",
        item: new URL("/collections", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: collection.title,
      },
    ],
  },
  // FAQPage + Speakable per rules/seo-geo-mastery.md Part 14.
  // mainEntity is derived from `collectionFaq` — the SAME array the visible
  // <section> at the bottom of this page renders, so the markup matches the
  // rendered content by construction and cannot silently drift (§E46).
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${new URL(`/collections/${collection.slug}`, Astro.site).toString()}#faq`,
    mainEntity: collectionFaq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${new URL(`/collections/${collection.slug}`, Astro.site).toString()}#speakable`,
    speakable: { "@type": "SpeakableSpecification", cssSelector: [".cc-collection-intro"] },
  },
];
---

<BaseLayout
  adContent
  title={title}
  description={metaDescription}
  keywords={collection.keywords}
  image={`/og/collections/${collection.slug}.png`}
  type="article"
  modifiedTime={BUILD_DATE}
  jsonAlternate={`/api/collections/${collection.slug}.json`}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb container-wide" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/collections/">Collections</a></li>
      <li aria-hidden="true">›</li>
      <li aria-current="page">{collection.title}</li>
    </ol>
  </nav>

  <section class="collection-hero">
    <div class="container-wide collection-hero__inner">
      <div
        class="collection-hero__accent"
        style={`background-color:${collection.accentHex}`}
        aria-hidden="true"
      ></div>
      <p class="eyebrow">Collection · {total} palettes</p>
      <h1 class="display-hero text-balance">{collection.title}</h1>
      <p class="collection-hero__tagline cc-collection-intro">{collection.tagline}</p>
      <p class="collection-hero__byline">
        Curated by <a href="/about/" rel="author">Paulo de Vries</a> · from Sanzo Wada's 1933
        <em>Dictionary of Color Combinations</em>
      </p>
      <div class="collection-hero__description" set:html={collection.description}></div>
      <ShareActions
        title={collection.title}
        url={new URL(`/collections/${collection.slug}`, Astro.site).toString()}
        image={new URL(`/og/collections/${collection.slug}.png`, Astro.site).toString()}
        description={`${collection.title} — ${collection.tagline}`}
        heading="Share this collection"
        download={{
          kind: "collection",
          slug: collection.slug,
          title: collection.title,
          tagline: collection.tagline,
          count: total,
          swatches: downloadSwatches,
        }}
      />
    </div>
  </section>

  <section class="collection-grid-section">
    <div class="container-wide">
      <div class="palette-grid" role="list">
        {palettes.map((palette) => (
          <div role="listitem">
            <PaletteCard palette={palette} headingLevel="h2" />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Studio shelf (2026-08-29, task mtdn38qeek38cv) — see index.astro for the
      full rationale. Same narrowed scope: home + browse + collections only.

      MOVED TO PEAK INTENT 2026-09-03. It used to sit at the very bottom of this
      725-line page: below the pillar, below BundleCta, below FurtherReading —
      and, decisively, BELOW the "Other collections" block, which is an exit
      affordance. Every reader who took that exit never saw the shelf at all.
      It now renders directly after the palette grid, the line where the reader
      is actually holding the collection's colours.

      Sized on measurement, not on a guess: the full GA4 30d pull over all 1,320
      paths (n=1320, untruncated — the default 15-row response hides exactly this
      and the probe says so in its own truncation_note) puts /collections/ at
      1,600 pageviews across 71 pages = 22.5 pv/path, the HIGHEST of any
      multi-page surface on the site — 2.5x /palettes/ (8.9) and 1.8x /colors/
      (12.5).

      VARIANT DELIBERATELY UNCHANGED. `full` with no `limit` returns the whole
      ART_SUPPLIES array, so this surface already shows all ten items including
      the high-basket print and calibrate groups — it never had the
      "arbitrary two of ten" defect that `variant="destination"` was built to
      fix on /colors/ and /palettes/. Switching it here would CUT coverage from
      ten items to three. The measured defect was placement; only placement is
      changed.

      A MOVE, not an addition — the bottom instance is removed, so commercial
      density on the page is unchanged. */}
  <section class="container-narrow collection-destination">
    <PaintThisPalette
      pageClass="collection-shelf"
      title="Off the screen"
      intro={`You have the ${collection.title.toLowerCase()} in front of you. These are the materials a colour study like this actually gets made with.`}
    />
  </section>

  {/* ============ EMBED WIDGET ============ */}
  <section class="section collection-embed-section" aria-labelledby="collection-embed-heading">
    <div class="container-wide collection-embed-inner">
      <div class="collection-embed-copy">
        <h2 id="collection-embed-heading" class="collection-embed-heading">
          Embed this collection
        </h2>
        <p class="collection-embed-desc">
          Drop a preview of this collection into any blog post, Notion page,
          or design review. Each palette links back to its full detail page.
        </p>
        <div class="collection-embed-snippet-wrap">
          <code class="collection-embed-snippet" id="collection-embed-code-block">{`<iframe src="https://colorcombinations.org/embed/collection/${collection.slug}/" width="560" height="320" frameborder="0" style="border-radius:8px;overflow:hidden;" title="${collection.title} — colorcombinations.org"></iframe>`}</code>
          <button
            type="button"
            class="collection-embed-copy-btn"
            id="copy-collection-embed-code"
            data-code={`<iframe src="https://colorcombinations.org/embed/collection/${collection.slug}/" width="560" height="320" frameborder="0" style="border-radius:8px;overflow:hidden;" title="${collection.title} — colorcombinations.org"></iframe>`}
            aria-label="Copy embed code"
          >
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
              <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" stroke="currentColor" stroke-width="1.25" fill="none"/>
            </svg>
            Copy code
          </button>
          <span class="collection-embed-copy-status" aria-live="polite" role="status"></span>
        </div>
      </div>
      <div class="collection-embed-preview" aria-label="Embed preview">
        <p class="collection-embed-preview-label">Preview</p>
        <iframe
          src={`/embed/collection/${collection.slug}/`}
          width="560"
          height="320"
          frameborder="0"
          style="border-radius:8px;overflow:hidden;display:block;max-width:100%;"
          title={`${collection.title} collection preview`}
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  {/* Pillar article cross-link — only on collections that have a matching /learn/ pillar */}
  {pillar && (
    <section class="collection-pillar section">
      <div class="container-wide">
        <a href={pillar.href} class="collection-pillar__link">
          <p class="collection-pillar__eyebrow">From the editorial · Long read</p>
          <h2 class="collection-pillar__title">{pillar.title}</h2>
          <p class="collection-pillar__lede">{pillar.lede}</p>
          <span class="collection-pillar__more">Read the article →</span>
        </a>
      </div>
    </section>
  )}

  {/* Japanese colour series — only on /collections/japanese/ (1,700 Bing AI
      citations/30d, the site's strongest Japanese-colour page). Added
      2026-09-28 with the blues/greens/purples siblings of /learn/japanese-reds/. */}
  {collection.slug === "japanese" && (
    <section class="collection-series section">
      <div class="container-wide">
        <p class="collection-pillar__eyebrow">The named Japanese colours</p>
        <ul class="collection-series__list">
          <li><a href="/learn/japanese-reds/">The Four Reds: kurenai, akane, shu, entan</a></li>
          <li><a href="/learn/japanese-blues/">Japanese Blues: ai, kon, hanada, asagi, ruri, gunjō</a></li>
          <li><a href="/learn/japanese-greens/">Japanese Greens: tokiwa, moegi, wakatake, matcha, seiji</a></li>
          <li><a href="/learn/japanese-purples/">Japanese Purples: murasaki, edo-murasaki, kikyō, fuji</a></li>
          <li><a href="/learn/japanese-color-glossary/">Japanese Color Glossary: 20 traditional names</a></li>
        </ul>
      </div>
    </section>
  )}

  {/* Other collections — cross-linking for SEO + navigation */}
  <section class="collection-related section">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">Continue exploring</p>
        <h2>Other collections</h2>
      </header>
      <ul class="collection-related__list" role="list">
        {relatedCollections.map((c) => (
            <li>
              <a href={`/collections/${c.slug}/`} class="collection-related__link">
                <span
                  class="collection-related__dot"
                  style={`background-color:${c.accentHex}`}
                  aria-hidden="true"
                ></span>
                <span class="collection-related__meta">
                  <span class="collection-related__title">{c.title}</span>
                  <span class="collection-related__tagline">{c.tagline}</span>
                </span>
              </a>
            </li>
          ))}
      </ul>
    </div>
  </section>

  <BundleCta variant="medium" />

  <section class="container-narrow">
    <FurtherReading
      pageClass="collection"
      title="Colour books worth owning"
      intro="The theory and reference behind palettes like this — recommended on Amazon."
      limit={3}
      offset={collection.featuredBookOffset ?? 3}
    />
  </section>

  {/* FAQ — renders `collectionFaq`, the SAME array that feeds the FAQPage schema in
       the frontmatter. Visible text matches the schema by construction; never build
       one without the other (§E46). Placed last so it pushes no CTA further down. */}
  <section class="section collection-faq-section" aria-labelledby="collection-faq-heading">
    <div class="container-narrow">
      <h2 id="collection-faq-heading" class="collection-faq__title">Questions about {collection.title}</h2>
      <dl class="collection-faq__list">
        {collectionFaq.map((f) => (
          <div class="collection-faq__item">
            <dt class="collection-faq__q">{f.q}</dt>
            <dd class="collection-faq__a">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* The studio shelf used to render here, at the page bottom. It now sits
      directly after the palette grid — see the rationale at that call site. */}
</BaseLayout>

<script>
  const embedCopyBtn = document.querySelector<HTMLButtonElement>("#copy-collection-embed-code");
  const embedStatus = document.querySelector<HTMLSpanElement>(".collection-embed-copy-status");
  embedCopyBtn?.addEventListener("click", async () => {
    const code = embedCopyBtn.dataset.code ?? "";
    try {
      await navigator.clipboard.writeText(code);
      if (embedStatus) {
        embedStatus.textContent = "✓ Copied!";
        window.setTimeout(() => {
          if (embedStatus.textContent === "✓ Copied!") embedStatus.textContent = "";
        }, 2000);
      }
    } catch {
      if (embedStatus) embedStatus.textContent = "Select + copy manually";
    }
  });
</script>

<style>
  /* FAQ block — mirrors the verified `.palette-faq__*` rules on /palettes/[slug]
     (§E48) so the two surfaces read identically. Static content at the page
     bottom: no JS, no lazy load, nothing above it moves, so it contributes zero
     CLS (the ads-density freeze RG-MV-COLOR-EVENT-DRIVEN-20260926 requires
     p75 CLS <= 0.10 preserved). Touches no .mv-content and no ad slot. */
  .collection-faq__title { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.9rem; color: var(--color-ink-900, #1a1714); }
  .collection-faq__list { margin: 0; }
  .collection-faq__item + .collection-faq__item { margin-top: 0.9rem; }
  .collection-faq__q { font-weight: 600; font-size: 0.95rem; color: var(--color-ink-900, #1a1714); }
  .collection-faq__a { margin: 0.25rem 0 0; font-size: 0.9rem; line-height: 1.55; color: var(--color-ink-500, #8a8378); }

  /* Studio shelf at peak intent. It previously sat last on the page, where the
     surrounding sections supplied their own padding; mid-flow between the
     palette grid and the embed section it needs its own. Matches the
     `.color-destination` / `.palette-destination` rule on the two surfaces that
     already made this move. */
  .collection-destination {
    margin-block: 3rem;
  }

  .collection-hero__byline { font-size: 0.85rem; opacity: 0.75; margin: 0.5rem 0 0; }
  .collection-hero__byline a { color: inherit; text-decoration: underline; text-underline-offset: 0.15em; }

  .breadcrumb {
    padding-top: 1.5rem;
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-ink-500);
  }

  .breadcrumb a {
    color: var(--color-ink-500);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb li[aria-current="page"] {
    color: var(--color-ink-900);
  }

  /* ============ HERO ============ */

  .collection-hero {
    padding-top: 2rem;
    padding-bottom: clamp(2rem, 5vw, 4rem);
    position: relative;
  }

  .collection-hero__inner {
    max-width: 62rem;
    position: relative;
  }

  .collection-hero__accent {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: 2rem;
    border: 1px solid var(--color-border);
  }

  .collection-hero .eyebrow {
    margin-bottom: 1rem;
  }

  .collection-hero__tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.4vw + 0.75rem, 1.375rem);
    font-style: italic;
    line-height: 1.55;
    color: var(--color-ink-700);
    margin-top: 1.5rem;
    max-width: 58ch;
  }

  .collection-hero__description {
    font-family: var(--font-serif);
