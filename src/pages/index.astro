---
import BaseLayout from "@layouts/BaseLayout.astro";
import PaletteCard from "@components/PaletteCard.astro";
import EmailCapture from "@components/EmailCapture.astro";
import BundleCta from "@components/BundleCta.astro";
import { featuredPalettes, allPalettes, wadaCatalog } from "@data/palettes";
import { collections, paletteSetForCollection } from "@data/collections";

const featured = featuredPalettes();
const totalCount = allPalettes().length;
const wadaCount = wadaCatalog().length;

const featuredCollections = ["websites", "branding", "autumn", "summer", "green", "minimalist"]
  .map(slug => collections.find(c => c.slug === slug))
  .filter(Boolean)
  .map(c => ({
    ...c!,
    previewColors: paletteSetForCollection(c!).slice(0, 3).flatMap(p => p.colors.slice(0, 2).map(col => col.hex)).slice(0, 5),
  }));

const title = "The Dictionary of Color Combinations";
const description = `All ${wadaCount} combinations from Sanzo Wada's 1933 Dictionary of Color Combinations, free to browse, copy, and use. Plus ${totalCount - wadaCount} editorial deep-dives into the Japanese shikisai tradition.`;

const keywords = [
  "color combinations",
  "color palettes",
  "Sanzo Wada",
  "Japanese colors",
  "design reference",
  "traditional colors",
  "Wada color dictionary",
  "historical palettes",
  "design inspiration",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: title,
  url: Astro.site?.toString() ?? "https://colorcombinations.org",
  description,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${Astro.site}browse?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout title={title} description={description} keywords={keywords} image="/og/index.svg" jsonLd={jsonLd}>
  {/* ==================== HERO ==================== */}
  <section class="hero section">
    <div class="container-wide hero__inner">
      <p class="eyebrow">Sanzo Wada, 1933 — the complete dictionary</p>
      <h1 class="display-hero text-balance">
        All <em>{wadaCount}</em> historical color combinations, free for working designers.
      </h1>
      <p class="hero__lede">
        The complete catalog of Sanzo Wada's 1933 <em>Dictionary of Color Combinations</em> — every plate, every hex value, every pairing — plus {totalCount - wadaCount} editorial deep-dives rooted in traditional Japanese shikisai. Free to browse, copy, and export.
      </p>
      <div class="hero__cta">
        <a href="/browse" class="btn btn-primary">Browse all {totalCount} combinations</a>
        <a href="#featured" class="btn btn-secondary">See editorial picks</a>
      </div>
    </div>
  </section>

  {/* ==================== FEATURED ==================== */}
  <section class="featured section" id="featured">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">Editorial picks</p>
        <h2 class="text-balance">Eight palettes to start with.</h2>
        <p class="section-lede">
          A cross-section of the editorial set — from Heian court crimson to Edo merchant indigo — chosen because they work in real design projects today. The full {wadaCount}-plate Wada catalog waits behind the browse button.
        </p>
      </header>

      <div class="palette-grid" role="list">
        {featured.map((palette) => (
          <div role="listitem">
            <PaletteCard palette={palette} headingLevel="h3" />
          </div>
        ))}
      </div>

      <div class="featured__footer">
        <a href="/browse" class="btn btn-secondary">See all {totalCount} combinations →</a>
      </div>
    </div>
  </section>

  {/* ==================== COLLECTIONS ==================== */}
  <section class="themes section">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">Browse by theme</p>
        <h2 class="text-balance">Palettes for every creative purpose.</h2>
        <p class="section-lede">
          Seventeen curated collections — from website palettes to sunset colors to the full Heian tradition. Every combination drawn from the same 378-plate archive.
        </p>
      </header>

      <ul class="themes-grid" role="list">
        {featuredCollections.map((col) => (
          <li role="listitem">
            <a href={`/collections/${col.slug}/`} class="theme-card">
              <div class="theme-card__swatches" aria-hidden="true">
                {col.previewColors.map((hex) => (
                  <span style={`background:${hex}`}></span>
                ))}
              </div>
              <div class="theme-card__body">
                <p class="theme-card__title">{col.title}</p>
                <p class="theme-card__tagline">{col.tagline}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="themes__footer">
        <a href="/collections" class="btn btn-secondary">All 17 collections →</a>
      </div>
    </div>
  </section>

  {/* ==================== HOW IT WORKS ==================== */}
  <section class="how section">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">How to use this</p>
        <h2 class="text-balance">Built for the way designers actually work.</h2>
      </header>

      <div class="how__grid">
        <div class="how__item">
          <p class="how__number">01</p>
          <h3>Browse the full catalog</h3>
          <p>Every plate from Wada's 1933 dictionary, plus editorial picks. Filter by era, hue, or mood — no login, no rate limit.</p>
        </div>
        <div class="how__item">
          <p class="how__number">02</p>
          <h3>Copy the format you need</h3>
          <p>Hex codes, Tailwind config, CSS variables, or raw JSON. One click, no signup.</p>
        </div>
        <div class="how__item">
          <p class="how__number">03</p>
          <h3>Build with history</h3>
          <p>Every combination documented, numbered, and traceable back to its place in the original six-volume work.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ==================== LEARN — pillar articles ==================== */}
  <section class="learn-feature section" aria-labelledby="learn-feature-heading">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">Learn</p>
        <h2 id="learn-feature-heading" class="text-balance">Working guides for designers.</h2>
        <p class="section-lede">
          Long-form articles on color theory, palette use, and the
          Japanese tradition behind the dictionary. Each piece links to
          specific palettes you can drop into a project today.
        </p>
      </header>
      <ul class="learn-feature__list" role="list">
        <li>
          <a href="/learn/heian-court-color-theory/" class="learn-feature__card">
            <p class="learn-feature__eyebrow">Color theory · 5 min</p>
            <h3 class="learn-feature__title">Heian Court Color Theory</h3>
            <p class="learn-feature__desc">
              How the Heian imperial court systematised colour into
              layered-robe combinations, forbidden pigments, and a
              12-month seasonal calendar.
            </p>
          </a>
        </li>
        <li>
          <a href="/learn/japanese-reds/" class="learn-feature__card">
            <p class="learn-feature__eyebrow">Color theory · 5 min</p>
            <h3 class="learn-feature__title">The Four Reds: Kurenai, Akane, Shu, Entan</h3>
            <p class="learn-feature__desc">
              Why the tradition distinguishes safflower crimson from
              madder from vermilion from lead red — and which to reach
              for when the brief asks for "a Japanese red."
            </p>
          </a>
        </li>
        <li>
          <a href="/learn/wabi-sabi-color-theory/" class="learn-feature__card">
            <p class="learn-feature__eyebrow">Color theory · 5 min</p>
            <h3 class="learn-feature__title">Wabi-Sabi Color Theory</h3>
            <p class="learn-feature__desc">
              What it actually means for color when a tradition values
              age over newness, asymmetry over balance, and imperfection
              over polish.
            </p>
          </a>
        </li>
        <li>
          <a href="/learn/japandi-color-theory/" class="learn-feature__card">
            <p class="learn-feature__eyebrow">Color theory · 5 min</p>
            <h3 class="learn-feature__title">Japandi Color Theory</h3>
            <p class="learn-feature__desc">
              How Japanese and Scandinavian traditions converge — and
              which palettes from the Wada dictionary actually fit the
              Japandi brief.
            </p>
          </a>
        </li>
        <li>
          <a href="/learn/scandinavian-color-theory/" class="learn-feature__card">
            <p class="learn-feature__eyebrow">Color theory · 5 min</p>
            <h3 class="learn-feature__title">Scandinavian Color Theory</h3>
            <p class="learn-feature__desc">
              What Scandinavian color is beyond IKEA-white — Nordic
              modernism, the hygge divergence, and which palettes from
              the dictionary actually fit.
            </p>
          </a>
        </li>
      </ul>
      <p class="learn-feature__more">
        <a href="/learn/">All articles →</a>
      </p>
    </div>
  </section>

  {/* ==================== BUNDLE ==================== */}
  <BundleCta variant="medium" />

  {/* ==================== NEWSLETTER ==================== */}
  <EmailCapture class="section" />
</BaseLayout>

<style>
  /* ========== HERO ========== */
  .hero {
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }

  .hero__inner {
    max-width: 62rem;
  }

  .hero .eyebrow {
    margin-bottom: 1.5rem;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--color-accent-500);
  }

  .hero__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.4vw + 0.75rem, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-700);
    max-width: 58ch;
    margin-top: 1.75rem;
    margin-bottom: 2.25rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ========== SECTION HEADERS ========== */
  .section-head {
    max-width: 58ch;
    margin-bottom: 3rem;
  }

  .section-head .eyebrow {
    margin-bottom: 0.75rem;
  }

  .section-head h2 {
    margin-bottom: 1rem;
  }

  .section-lede {
    color: var(--color-ink-500);
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 52ch;
  }

  /* ========== PALETTE GRID ========== */
  .palette-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(1, 1fr);
  }

  @media (min-width: 640px) {
    .palette-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .palette-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .palette-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .featured__footer {
    margin-top: 3rem;
    text-align: center;
  }

  /* ========== THEMES / COLLECTIONS ========== */
  .themes {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .themes-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(1, 1fr);
    margin-top: 2.5rem;
  }

  @media (min-width: 560px) {
    .themes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .themes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .theme-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }

  .theme-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-ink-900);
    box-shadow: var(--shadow-plate);
  }

  .theme-card__swatches {
    display: flex;
    height: 4.5rem;
  }

  .theme-card__swatches span {
    flex: 1;
  }

  .theme-card__body {
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .theme-card__title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-ink-900);
    margin: 0;
    line-height: 1.3;
  }

  .theme-card__tagline {
    font-size: 0.875rem;
    color: var(--color-ink-600);
    margin: 0;
    line-height: 1.45;
  }

  .themes__footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  /* ========== HOW IT WORKS ========== */
  .how {
    background-color: var(--color-paper-100);
    border-block: 1px solid var(--color-border);
  }

  .how__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(1, 1fr);
  }

  @media (min-width: 720px) {
    .how__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .how__item h3 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    margin: 0.75rem 0 0.75rem;
  }

  .how__item p {
    color: var(--color-ink-700);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 34ch;
  }

  .how__number {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-500);
    margin: 0;
  }

  /* ============ LEARN FEATURE ============ */

  .learn-feature {
    background: var(--color-paper-100);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .learn-feature__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .learn-feature__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .learn-feature__card {
    display: block;
    height: 100%;
    padding: 1.5rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease;
  }

  .learn-feature__card:hover {
    border-color: var(--color-ink-900);
  }

  .learn-feature__eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-500);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .learn-feature__title {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.25vw + 0.875rem, 1.375rem);
    line-height: 1.2;
    margin: 0 0 0.625rem;
    color: var(--color-ink-900);
  }

  .learn-feature__desc {
    font-size: 0.9375rem;
    color: var(--color-ink-700);
    line-height: 1.5;
    margin: 0;
  }

  .learn-feature__more {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.9375rem;
  }

  .learn-feature__more a {
    color: var(--color-accent-500);
    font-weight: 500;
    text-decoration: none;
  }

  .learn-feature__more a:hover {
    text-decoration: underline;
  }
</style>
