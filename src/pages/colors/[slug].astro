<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = "Copied!";
        btn.classList.add("copied");
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove("copied");
        }, 1500);
      } catch {
        // Fallback for older browsers
        const input = document.createElement("input");
        input.value = text;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        document.body.removeChild(input);
      }
    });
  });

  // Color embed copy-code button
  const colorEmbedCopyBtn = document.querySelector<HTMLButtonElement>("#copy-color-embed-code");
  const colorEmbedStatus = document.querySelector<HTMLSpanElement>(".color-embed-copy-status");
  colorEmbedCopyBtn?.addEventListener("click", async () => {
    const code = colorEmbedCopyBtn.dataset.code ?? "";
    try {
      await navigator.clipboard.writeText(code);
      if (colorEmbedStatus) {
        colorEmbedStatus.textContent = "✓ Copied!";
        window.setTimeout(() => {
          if (colorEmbedStatus.textContent === "✓ Copied!") colorEmbedStatus.textContent = "";
        }, 2000);
      }
    } catch {
      if (colorEmbedStatus) colorEmbedStatus.textContent = "Select + copy manually";
    }
  });
</script>

