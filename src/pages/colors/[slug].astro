---
import BaseLayout from "@layouts/BaseLayout.astro";
import PaletteCard from "@components/PaletteCard.astro";
import ColorHarmony from "@components/ColorHarmony.astro";
import FurtherReading from "@components/FurtherReading.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";
import HeroSourceBook from "@components/HeroSourceBook.astro";
import BundleCta from "@components/BundleCta.astro";
import StickyBuyBar from "@components/StickyBuyBar.astro";
import ShareActions from "@components/ShareActions.astro";
import { FURTHER_READING, ART_SUPPLIES } from "@/config/monetization";
import { allColors, colorBySlug, palettesForColor } from "@data/colors";
import { commonColors, contexts, palettesFor, MIN_PALETTES } from "@data/pairings";
import { COLOR_STORIES } from "@data/colorStories";
import { bestTextColorOn, contrastRatio } from "@/lib/color";
import { fmt } from "@/lib/colorConvert";
import type { HexColor } from "@/types/palette";

// 6 of 210 named-colour slugs (blue, brown, green, orange, red, yellow) collide
// with the 9-member hue list in colors/[hue]/index.astro, which mounts at the
// same bare /colors/[hue-or-slug]/ shape and wins Astro's route-priority
// resolution (directory route beats dynamic file route) -- every prior build
// already emitted "Could not render /colors/blue ... conflicts with higher
// priority route /colors/[hue]" for these 6, so they were already dead output.
// None of the 6 has a hand-written COLOR_STORIES entry (that set is fixed at
// the 20 canonical Japanese names in colorStories.ts), so nothing unique is
// lost by not attempting them -- this just stops a futile, warned-about build
// for pages that could never render anyway. See TaskPrio mtpju7edkbygfv.
export function getStaticPaths() {
  // Astro extracts + runs getStaticPaths in an isolated context at build time --
  // a module-scope const declared alongside it is NOT guaranteed to survive that
  // extraction (confirmed: shipped that way first, broke CI with "HUE_COLLISION_
  // SLUGS is not defined" inside the compiled _slug_.astro.mjs). Keep the set
  // self-contained inside the function instead.
  const HUE_COLLISION_SLUGS = new Set(["red", "orange", "yellow", "brown", "pink", "green", "blue", "purple", "neutral"]);
  return allColors()
    .filter((c) => !HUE_COLLISION_SLUGS.has(c.slug))
    .map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const color = colorBySlug(slug ?? "");

if (!color) {
  return Astro.redirect("/404");
}

const palettes = palettesForColor(color);

// Cross-link into the "colors that go with" hub when this color's slug also
// exists as a commonColor with a live hub (10 of 210 /colors/ pages qualify —
// the two datasets are largely disjoint: Wada-archive Japanese names vs.
// modern paint names — this only fires on the real overlap, e.g. black/blue/
// green/khaki, never invents a link for a color with no matching hub).
const pairingHub = commonColors.find((c) => c.slug === color.slug);
const pairingHubLive =
  pairingHub && contexts.some((ctx) => palettesFor(pairingHub.hex, ctx).length >= MIN_PALETTES);
const textColor = bestTextColorOn(color.hex);

// Contrast examples: what this color looks like against white and black
const onWhite = contrastRatio(color.hex, "#FFFFFF" as HexColor);
const onBlack = contrastRatio(color.hex, "#000000" as HexColor);

// ---- Computed color profile — genuine per-color information-gain for the
// ~211 colours without a hand-written story. Every value derives from the hex
// or the archive cross-reference; nothing is invented.
const _r = parseInt(color.hex.slice(1, 3), 16);
const _g = parseInt(color.hex.slice(3, 5), 16);
const _b = parseInt(color.hex.slice(5, 7), 16);
const _rn = _r / 255, _gn = _g / 255, _bn = _b / 255;
// Print/CSS colour spaces. These were already implemented and unit-exercised in
// lib/colorConvert (the converter tools use them) but had never been surfaced on
// a content page — /colors/ showed only Hex + RGB. Deterministic from the hex,
// so this is derived information-gain, not invented content.
// CMYK is deliberately labelled an approximation: colorConvert's own comment
// calls it "naive, screen-approximation" — it is not an ICC/profiled separation,
// and this catalogue is read by print people who would otherwise trust it.
const _rgb = { r: _r, g: _g, b: _b };
const cmykStr = fmt.cmyk(_rgb);
const oklchStr = fmt.oklch(_rgb);
const hslStr = fmt.hsl(_rgb);
const _max = Math.max(_rn, _gn, _bn), _min = Math.min(_rn, _gn, _bn);
const _lum = (_max + _min) / 2;
const _delta = _max - _min;
let _hue = 0;
if (_delta !== 0) {
  if (_max === _rn) _hue = ((_gn - _bn) / _delta) % 6;
  else if (_max === _gn) _hue = (_bn - _rn) / _delta + 2;
  else _hue = (_rn - _gn) / _delta + 4;
  _hue = Math.round(_hue * 60);
  if (_hue < 0) _hue += 360;
}
const _sat = _delta === 0 ? 0 : _delta / (1 - Math.abs(2 * _lum - 1));
const hsl = { h: _hue, s: Math.round(_sat * 100), l: Math.round(_lum * 100) };
const lightnessWord = hsl.l >= 70 ? "light" : hsl.l >= 40 ? "mid-tone" : "deep";
const satWord = hsl.s >= 60 ? "vivid" : hsl.s >= 25 ? "muted" : "near-neutral";
const maxContrast = Math.max(onWhite, onBlack);
const bestBg = onWhite >= onBlack ? "white" : "dark";
const usageWord =
  maxContrast >= 4.5
    ? "body text, headings, and UI labels"
    : maxContrast >= 3
      ? "large headings and accents — but not body copy"
      : "decorative fills, borders, and backgrounds rather than text";
// Most frequent companions across the archive (dataset-derived pairing).
const pairCounts = new Map<string, { name: string; n: number }>();
for (const p of palettes) {
  for (const c of p.colors) {
    if (c.hex.toLowerCase() === color.hex.toLowerCase()) continue;
    const key = c.hex.toLowerCase();
    const e = pairCounts.get(key) ?? { name: c.nameRomaji ?? c.hex, n: 0 };
    e.n += 1;
    pairCounts.set(key, e);
  }
}
const topPairs = [...pairCounts.values()].sort((a, b) => b.n - a.n).slice(0, 3);
const pairText =
  topPairs.length === 1
    ? topPairs[0].name
    : topPairs.map((t) => t.name).slice(0, -1).join(", ") +
      (topPairs.length > 1 ? ` and ${topPairs[topPairs.length - 1].name}` : "");

// Deterministic book rotation
const bookOffset =
  color.slug
    .split("")
    .reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % FURTHER_READING.length;

// Deterministic supply rotation. Seeded off the same slug but shifted by its length
// so it does NOT move in lockstep with bookOffset — a reader working through several
// colours should meet the whole catalogue, not the same pairing every time.
const supplyOffset =
  (color.slug.split("").reduce((sum, ch) => sum + ch.charCodeAt(0), 0) +
    color.slug.length) %
  ART_SUPPLIES.length;

const displayName = color.name + (color.nameJa ? ` (${color.nameJa})` : "");
const title = displayName;
const description = color.meaning
  ? `${color.name} — ${color.meaning}. Hex ${color.hex}. Found in ${color.paletteCount} historical color combination${color.paletteCount === 1 ? "" : "s"} from Sanzo Wada's 1933 dictionary.`
  : `${color.name} — hex ${color.hex}. Found in ${color.paletteCount} historical color combination${color.paletteCount === 1 ? "" : "s"} from Sanzo Wada's 1933 Dictionary of Color Combinations.`;

const keywords = [
  color.name,
  color.nameJa,
  color.hex,
  `${color.name} hex`,
  `${color.name} color`,
  `${color.hue} color`,
  "Sanzo Wada",
  "color combination",
  "Japanese color",
].filter(Boolean) as string[];

// Freshness signals for LLM citation + Google Freshness (Aleyda #9).
const SITE_FIRST_PUBLISHED = "2026-04-10T00:00:00Z";
import { contentDate } from "@/lib/contentDate";
/* Honest dateModified: the newest git commit date of this template and
 * the data it renders, NOT the build clock. See src/lib/contentDate.ts. */
const BUILD_DATE = contentDate("src/pages/colors/[slug].astro", "src/data/colorStories.ts", "src/data/colors.ts", "src/data/pairings.ts");

// Pillar-article cross-link map. When a named color anchors a pillar
// article, surface that pillar inline so /colors traffic compounds into
// /learn pillar reads. Anchor jumps the reader straight to the relevant
// section when one exists (e.g. /learn/japanese-reds/#kurenai).
type PillarLink = {
  slug: "japanese-reds" | "wabi-sabi-color-theory" | "japandi-color-theory";
  title: string;
  eyebrow: string;
  blurb: string;
  anchor?: string;
};

const PILLAR_MAP: Record<string, PillarLink> = {
  kurenai: { slug: "japanese-reds", title: "The Four Reds: Kurenai, Akane, Shu, Entan", eyebrow: "The named pigments", blurb: "Why Japanese tradition distinguishes safflower crimson from madder from vermilion from lead red.", anchor: "kurenai" },
  akane: { slug: "japanese-reds", title: "The Four Reds: Kurenai, Akane, Shu, Entan", eyebrow: "The named pigments", blurb: "Why Japanese tradition distinguishes safflower crimson from madder from vermilion from lead red.", anchor: "akane" },
  shu: { slug: "japanese-reds", title: "The Four Reds: Kurenai, Akane, Shu, Entan", eyebrow: "The named pigments", blurb: "Why Japanese tradition distinguishes safflower crimson from madder from vermilion from lead red.", anchor: "shu" },
  entan: { slug: "japanese-reds", title: "The Four Reds: Kurenai, Akane, Shu, Entan", eyebrow: "The named pigments", blurb: "Why Japanese tradition distinguishes safflower crimson from madder from vermilion from lead red.", anchor: "entan" },
  tobi: { slug: "wabi-sabi-color-theory", title: "Wabi-Sabi Color Theory", eyebrow: "The source philosophy", blurb: "What wabi-sabi actually is in colour, and which Wada palettes fit the brief." },
  kogecha: { slug: "wabi-sabi-color-theory", title: "Wabi-Sabi Color Theory", eyebrow: "The source philosophy", blurb: "What wabi-sabi actually is in colour, and which Wada palettes fit the brief." },
  sumi: { slug: "wabi-sabi-color-theory", title: "Wabi-Sabi Color Theory", eyebrow: "The source philosophy", blurb: "What wabi-sabi actually is in colour, and which Wada palettes fit the brief." },
  gofun: { slug: "wabi-sabi-color-theory", title: "Wabi-Sabi Color Theory", eyebrow: "The source philosophy", blurb: "What wabi-sabi actually is in colour, and which Wada palettes fit the brief." },
  seiji: { slug: "japandi-color-theory", title: "Japandi Color Theory", eyebrow: "The modern fusion", blurb: "Where Japanese restraint and Scandinavian light converge — and which Wada palettes hit the brief." },
  hanada: { slug: "japandi-color-theory", title: "Japandi Color Theory", eyebrow: "The modern fusion", blurb: "Where Japanese restraint and Scandinavian light converge — and which Wada palettes hit the brief." },
  kaki: { slug: "japandi-color-theory", title: "Japandi Color Theory", eyebrow: "The modern fusion", blurb: "Where Japanese restraint and Scandinavian light converge — and which Wada palettes hit the brief." },
  kinari: { slug: "japandi-color-theory", title: "Japandi Color Theory", eyebrow: "The modern fusion", blurb: "Where Japanese restraint and Scandinavian light converge — and which Wada palettes hit the brief." },
};

const pillar: PillarLink | undefined = PILLAR_MAP[color.slug];
const pillarHref = pillar
  ? `/learn/${pillar.slug}/${pillar.anchor ? `#${pillar.anchor}` : ""}`
  : null;

// Editorial color story (when one exists for this slug). Surfaces ~150-200
// words of authoritative context per named color — pigment origin,
// register, modern usage. Improves LLM citation-fit on detail pages.
const story = COLOR_STORIES[color.slug];

/**
 * FAQ — SINGLE SOURCE for both the FAQPage schema below AND the visible <section>
 * near the bottom of this page. They must not drift apart.
 *
 * Why this array exists (2026-09-06, §E46): the FAQPage schema was previously built
 * inline here and rendered NOWHERE. Measured across all 1,529 crawled pages, 1,364
 * of them shipped FAQPage JSON-LD whose Q&A appeared in no visible HTML — this
 * template's 204 pages among them. Google's general structured-data guidelines
 * require markup to match visible page content ("every question and answer in the
 * JSON-LD must appear in visible HTML"), and FAQ rich results were deprecated
 * 2026-05-07, so the schema's only remaining purpose is AI extraction — and AI
 * extractors read RENDERED content. Invisible answers helped nobody.
 *
 * The answers are genuinely substantive (computed WCAG ratios, hex, provenance,
 * licensing), which is why the fix is to RENDER them rather than delete the block.
 *
 * Pattern copied from colors-that-go-with/[color]/index.astro, the one template on
 * this site that already did it correctly ("visible text matches schema").
 */
const colorFaq: { q: string; a: string }[] = [
  {
    q: `What is the hex code for ${color.name}?`,
    a: `${color.name}${color.nameJa ? ` (${color.nameJa})` : ""} is ${color.hex}. ${color.meaning ?? ""} It appears in ${color.paletteCount} historical color combination${color.paletteCount === 1 ? "" : "s"} from Sanzo Wada's 1933 "A Dictionary of Color Combinations".`.trim(),
  },
  {
    q: `What does ${color.name} look like on white and black backgrounds?`,
    a: `${color.name} (${color.hex}) has a WCAG contrast ratio of ${onWhite.toFixed(2)}:1 against white (#FFFFFF) and ${onBlack.toFixed(2)}:1 against black (#000000). WCAG AA requires 4.5:1 for normal text and 3:1 for large text.`,
  },
  {
    q: `Where does the color ${color.name} come from?`,
    a: `${color.name} is documented in Sanzo Wada's "A Dictionary of Color Combinations" (1933, Seigensha Art Publishing 2010 reprint). Wada catalogued ${color.hue} pigments and historical Japanese color terms. The source work is in the public domain.`,
  },
  {
    q: `Can I use ${color.name} in my own design or brand?`,
    a: `Yes. The color name and hex value (${color.hex}) are factual data — not copyrightable. Our curation and descriptions are CC BY 4.0 licensed.`,
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: color.name,
    alternateName: color.nameJa,
    description,
    url: new URL(`/colors/${color.slug}`, Astro.site).toString(),
    keywords: keywords.join(", "),
    color: color.hex,
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
    inLanguage: "en",
    license: "https://creativecommons.org/licenses/by/4.0/",
    publisher: {
      "@type": "Organization",
      name: "The Dictionary of Color Combinations",
      url: "https://colorcombinations.org",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Colors",
        item: new URL("/colors", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: color.name,
      },
    ],
  },
  // FAQPage + Speakable per rules/seo-geo-mastery.md Part 14.
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${new URL(`/colors/${color.slug}`, Astro.site).toString()}#faq`,
    mainEntity: colorFaq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${new URL(`/colors/${color.slug}`, Astro.site).toString()}#speakable`,
    speakable: { "@type": "SpeakableSpecification", cssSelector: [".cc-color-intro"] },
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} image={`/og/colors/${color.slug}.png`} type="article" modifiedTime={BUILD_DATE} jsonAlternate={`/api/colors/${color.slug}.json`} jsonLd={jsonLd} adContent>
  <nav class="breadcrumb container-wide" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">&#x203A;</li>
      <li><a href="/colors/">Colors</a></li>
      <li aria-hidden="true">&#x203A;</li>
      <li aria-current="page">{color.name}</li>
    </ol>
  </nav>

  <section class="color-hero">
    <div class="container-wide color-hero__inner">
      <div
        class="color-hero__swatch"
        style={`background-color:${color.hex}`}
        role="img"
        aria-label={`Color swatch: ${color.name} ${color.hex}`}
      >
        <span class={`color-hero__hex ${textColor === "dark" ? "text-dark" : "text-light"}`}>
          {color.hex}
        </span>
      </div>

      <div class="color-hero__info">
        <p class="eyebrow">{color.hue} &middot; {color.paletteCount} palette{color.paletteCount === 1 ? "" : "s"}</p>
        <h1 class="display-hero text-balance">{color.name}</h1>
        {color.nameJa && <p class="color-hero__ja">{color.nameJa}</p>}
        {color.meaning && <p class="color-hero__meaning cc-color-intro">{color.meaning}</p>}
        <HeroSourceBook
          lead={color.paletteSlugs.some((s) => s.startsWith("wada-")) ? `${color.name} is one of the colors Sanzo Wada used in his 1933 book.` : "Most colors in this archive come from one 1933 book."}
          surface="colors-hero"
        />
        <ShareActions
          title={`${color.name}${color.nameJa ? ` (${color.nameJa})` : ""}`}
          url={new URL(`/colors/${color.slug}`, Astro.site).toString()}
          image={new URL(`/og/colors/${color.slug}.png`, Astro.site).toString()}
          description={color.meaning ? `${color.name} (${color.hex}) — ${color.meaning}` : `${color.name} (${color.hex})`}
          heading="Share this color"
          download={{
            kind: "color",
            slug: color.slug,
            name: color.name,
            nameJa: color.nameJa,
            hex: color.hex,
            hue: color.hue,
          }}
        />
      </div>
    </div>
  </section>

  {/* Computed color profile — direct-answer-first (AEO), unique per colour.
      Fills the ~211 colours that have no hand-written story with genuine,
      fact-derived value: HSL, a readability interpretation, and archive pairing. */}
  <section class="color-profile section" aria-labelledby="color-profile-heading">
    <div class="container-narrow">
      <h2 id="color-profile-heading" class="color-profile__heading">About {color.name}</h2>
      <p class="color-profile__lead">
        {color.name}{color.nameJa ? ` (${color.nameJa})` : ""} is a {lightnessWord},{" "}
        {satWord} {color.hue} tone. Its hex value is <code>{color.hex}</code> — that is
        RGB&nbsp;{_r},&nbsp;{_g},&nbsp;{_b}, or HSL&nbsp;{hsl.h}°,&nbsp;{hsl.s}%,&nbsp;{hsl.l}%.
        {color.meaning ? ` ${color.meaning}.` : ""}
      </p>
      <p>
        It holds {maxContrast.toFixed(1)}:1 contrast against {bestBg}, so {color.name} works
        best for {usageWord}. (On white it scores {onWhite.toFixed(1)}:1; on black {onBlack.toFixed(1)}:1.)
      </p>
      {topPairs.length > 0 && (
        <p>
          Across Sanzo Wada's 1933 <em>Dictionary of Color Combinations</em>, {color.name} appears
          in {color.paletteCount} combination{color.paletteCount === 1 ? "" : "s"} — most often
          paired with {pairText}.
        </p>
      )}
    </div>
  </section>

  {story && (
    <section class="color-story-section section" aria-labelledby="color-story-heading">
      <div class="container-narrow">
        <h2 id="color-story-heading" class="color-story-heading">The story of {color.name}</h2>
        {story.paragraphs.map((p) => (
          <p class="color-story-p" set:html={p} />
        ))}
        {story.workingNote && (
          <p class="color-story-working">
            <span class="color-story-working-label">Working note:</span>{" "}
            <span set:html={story.workingNote} />
          </p>
        )}
        <p class="color-story-glossary-cta">
          <a href={`/learn/japanese-color-glossary/#${color.slug}/`}>
            See {color.name} in the Japanese Color Glossary →
          </a>
        </p>
        <p class="color-story-glossary-cta">
          <a href="/learn/color-data-analysis/">
            How often colors like this recur across the 348 plates — the data analysis →
          </a>
        </p>
      </div>
    </section>
  )}

  <div class="container-narrow">
    <ColorHarmony hex={color.hex} name={color.name} />
  </div>

  {/*
    PEAK-INTENT BUY BLOCK — same move already shipped on /palettes/[slug].
    Placed directly after ColorHarmony because that is the line where the reader
    is holding hex codes (the harmony swatches) and the question "what do I do
    with these" is the one they actually have. It used to sit in the sidebar as a
    rotating two-of-ten shelf, which on many pages surfaced two of the cheapest
    items in the catalogue and neither high-basket group.

    Sized on measurement, not on a guess: GA4 30d over all 1,320 paths puts
    /colors/[slug] at 2,057 pageviews (12.9%) across 212 pages — the second
    largest programmatic surface after /palettes/[slug] (3,261 pv, 20.5%). A
    first read of the same probe returned only its top 15 rows and made this
    bucket look like zero; the full pull is what this placement rests on.

    A MOVE, not an addition — the sidebar block is gone, so commercial density on
    the page is unchanged.
  */}
  <div class="container-narrow color-destination">
    <PaintThisPalette
      title={`Taking ${color.name} off the screen`}
      intro="A hex code is an instruction to a screen, not a colour. Where this one is going decides what it needs next."
      offset={supplyOffset}
      variant="destination"
      pageClass="color-destination"
    />
  </div>

  <section class="color-details section">
    <div class="container-wide color-details__grid">
      <div class="color-details__main">
        <h2 class="section-title">Palettes with {color.name}</h2>
        <p class="color-details__intro">
          {color.name} appears in {color.paletteCount} combination{color.paletteCount === 1 ? "" : "s"} from
          the archive. {color.paletteCount > 1 ? "Each pairing reveals how the same color shifts character depending on its neighbours." : ""}
          For how usage like this compares across the whole dictionary, see
          <a href="/learn/color-data-analysis/">the data analysis of all 348 plates</a>.
        </p>
        <div class="palette-grid" role="list">
          {palettes.map((palette) => (
            <div role="listitem">
              <PaletteCard palette={palette} headingLevel="h3" />
            </div>
          ))}
        </div>
      </div>

      <aside class="color-details__sidebar">
        <div class="color-spec">
          <h2 class="spec-title">Specifications</h2>
          <dl class="spec-list">
            <div class="spec-row">
              <dt>Hex</dt>
              <dd><code>{color.hex}</code></dd>
            </div>
            <div class="spec-row">
              <dt>RGB</dt>
              <dd><code>{parseInt(color.hex.slice(1, 3), 16)}, {parseInt(color.hex.slice(3, 5), 16)}, {parseInt(color.hex.slice(5, 7), 16)}</code></dd>
            </div>
            <div class="spec-row">
              <dt>HSL</dt>
              <dd><code>{hsl.h}°, {hsl.s}%, {hsl.l}%</code></dd>
            </div>
            <div class="spec-row">
              <dt>CMYK <span class="spec-approx">approx.</span></dt>
              <dd><code>{cmykStr.replace(/^cmyk\(|\)$/g, "")}</code></dd>
            </div>
            <div class="spec-row">
              <dt>OKLCH</dt>
              <dd><code>{oklchStr.replace(/^oklch\(|\)$/g, "")}</code></dd>
            </div>
            <div class="spec-row">
              <dt>Hue family</dt>
              <dd><a href={`/colors/hue/${color.hue}/`} class="hue-family-link">{color.hue}</a></dd>
            </div>
            <div class="spec-row">
              <dt>On white</dt>
              <dd>{onWhite.toFixed(1)}:1 {onWhite >= 4.5 ? "AA" : onWhite >= 3 ? "AA large" : "decorative"}</dd>
            </div>
            <div class="spec-row">
              <dt>On black</dt>
              <dd>{onBlack.toFixed(1)}:1 {onBlack >= 4.5 ? "AA" : onBlack >= 3 ? "AA large" : "decorative"}</dd>
            </div>
            <div class="spec-row">
              <dt>Palettes</dt>
              <dd>{color.paletteCount}</dd>
            </div>
          </dl>
        </div>

        <div class="color-copy">
