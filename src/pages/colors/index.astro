---
import BaseLayout from "@layouts/BaseLayout.astro";
import AskAmili from "@components/AskAmili.astro";
import FurtherReading from "@components/FurtherReading.astro";
import ShelfCallout from "@components/ShelfCallout.astro";
import HeroSourceBook from "@components/HeroSourceBook.astro";
import { allColors, colorsByHue, type ColorEntry } from "@data/colors";
import { bestTextColorOn } from "@/lib/color";

const colors = allColors();
const grouped = colorsByHue();
const total = colors.length;
/*
 * PROVENANCE SPLIT — computed, never typed.
 *
 * Only the colors that appear in at least one of the 348 `wada-NNN-` plates come
 * from Sanzo Wada's 1933 dictionary; the rest are traditional Japanese shikisai
 * names used only in our 30 editorial palettes, which /methodology states plainly
 * are "not derived from the Wada source". Calling all 210 "Wada's dictionary"
 * was a provenance claim the data does not support.
 */
const wadaTotal = colors.filter((c) => c.paletteSlugs.some((s) => s.startsWith("wada-"))).length;
const editorialTotal = total - wadaTotal;

/*
 * TITLE — Bing CTR test, 2026-08-24 (TaskPeace mt79i08wgdw5ln).
 *
 * Was the bare "Color Dictionary", earning 1.50% CTR at Bing position 4.9 where
 * the homepage earns 6.93% at 4.1. Generic, and it named neither the count nor
 * the source.
 *
 * The site's own best-converting Bing queries point straight at the fix:
 * "japanese dictionary of color combinations" pulls 10.73% CTR and "a dictionary
 * of color combinations" 6.43%. The audience is looking for Sanzo Wada
 * specifically — so the title should say so, and say how much is here.
 *
 * Count is computed from the archive, never typed.
 */
const title = `${wadaTotal} Wada Dictionary Colors + ${editorialTotal} Editorial — ${total} Named Colors`;
const description = `All ${total} named colors in the archive: the ${wadaTotal} colors of Sanzo Wada's 1933 Dictionary of Color Combinations plus ${editorialTotal} traditional Japanese shikisai names from our 30 editorial palettes. Browse by hue, see hex values, and find every palette that uses each color.`;

const hueOrder = ["red", "orange", "yellow", "brown", "pink", "green", "blue", "purple", "neutral"] as const;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: new URL("/colors", Astro.site).toString(),
    isPartOf: {
      "@type": "WebSite",
      name: "The Dictionary of Color Combinations",
      url: Astro.site?.toString(),
    },
    numberOfItems: total,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Colors",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} image="/og/colors.png" jsonLd={jsonLd} adContent>
  <section class="colors-hero">
    <div class="container-wide colors-hero__inner">
      <p class="eyebrow">{total} named colors · {wadaTotal} from Wada's dictionary · {editorialTotal} editorial</p>
      <h1 class="display-hero text-balance">Color Dictionary.</h1>
      <AskAmili />
      <p class="colors-hero__lede">
        Every named color in the archive — the {wadaTotal} colors Sanzo Wada used across the 348
        plates of his 1933 <em>Dictionary of Color Combinations</em> (Seigensha Art Publishing 2010
        reprint), plus {editorialTotal} traditional Japanese colour names from our 30 editorial
        palettes. Each entry links to every palette that uses it.
      </p>
      <HeroSourceBook
        lead={`${wadaTotal} of these ${total} colors come from one 1933 book.`}
        surface="colors-index-hero"
      />
      <aside class="colors-hero__glossary">
        <p class="colors-hero__glossary-eyebrow">Reference</p>
        <p class="colors-hero__glossary-text">
          Looking for the canonical traditional Japanese names with their pigment origin and meaning?
          Read the
          <a href="/learn/japanese-color-glossary/">Japanese Color Glossary</a> — 20 names with
          80-150 word entries, anchored for jump-linking.
        </p>
      </aside>
    </div>
  </section>

  <section class="colors-filter section">
    <div class="container-wide">
      <div class="filter-bar" role="toolbar" aria-label="Filter by hue family">
        <button class="filter-pill is-active" data-hue="all">All ({total})</button>
        {hueOrder.map((hue) => {
          const group = grouped.get(hue);
          if (!group || group.length === 0) return null;
          return (
            <button class="filter-pill" data-hue={hue}>
              {hue.charAt(0).toUpperCase() + hue.slice(1)} ({group.length})
            </button>
          );
        })}
      </div>
    </div>
  </section>

  {/* 2026-09-05 — moved ABOVE the grid, same fix as browse.astro (commit
      b51c559). MEASURED on the live page before the move: the callout markup
      sat at 84.2% of the document body while this page's own Clarity median
      scroll depth is 36.5% (2026-09-02, 74 sessions) — so the "deliberate,
      visually distinct entry point" ShelfCallout.astro was built to be
      (2026-08-15 doc comment) was unreachable for the median visitor here too.
      The hue-family nav, FurtherReading and the Studio shelf below are
      untouched: this raises one lightweight callout, not the shelf. */}
  <ShelfCallout
    href="/shop/color-reference-library/"
    eyebrow="Named references"
    title="Looking for a specific book?"
    blurb="Wada's dictionary, the Albers classic, a Munsell field guide, Pantone's design history, and the 1821 dictionary that came a century before Wada's — six references, chosen deliberately."
    cta="See the color reference library"
  />

  <section class="colors-grid-section section">
    <div class="container-wide">
      <div class="colors-grid" role="list" id="color-grid">
        {colors.map((color) => {
          const text = bestTextColorOn(color.hex);
          return (
            <a
              href={`/colors/${color.slug}/`}
              class="color-tile"
              data-hue={color.hue}
              role="listitem"
              aria-label={`${color.name} — ${color.hex}, in ${color.paletteCount} palette${color.paletteCount === 1 ? "" : "s"}`}
            >
              <div
                class="color-tile__swatch"
                style={`background-color:${color.hex}`}
              >
                <span class={`color-tile__hex ${text === "dark" ? "text-dark" : "text-light"}`}>
                  {color.hex}
                </span>
              </div>
              <div class="color-tile__info">
                <span class="color-tile__name">{color.name}</span>
                {color.nameJa && <span class="color-tile__ja">{color.nameJa}</span>}
                <span class="color-tile__count">{color.paletteCount} palette{color.paletteCount === 1 ? "" : "s"}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ==================== HUE FAMILY LINKS ==================== */}
  <nav class="hue-families section" aria-label="Browse by hue family">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">Browse by hue family</p>
        <h2 class="text-balance">Explore the full spectrum.</h2>
        <p class="section-lede">Each hue family page shows every named color and palette combination in that color range.</p>
      </header>
      <ul class="hue-family-grid" role="list">
        {hueOrder.map((hue) => {
          const group = grouped.get(hue);
          if (!group || group.length === 0) return null;
          const sampleColor = group[0];
          return (
            <li>
              <a href={`/colors/${hue}/`} class="hue-family-card">
                <span class="hue-family-card__dot" style={`background:${sampleColor.hex}`} aria-hidden="true"></span>
                <span class="hue-family-card__label">{hue.charAt(0).toUpperCase() + hue.slice(1)}</span>
                <span class="hue-family-card__count">{group.length} colors</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>

  <section class="container-narrow">
    <FurtherReading
      pageClass="colors-index"
      title="Books on colour"
      intro="Where these colours come from — histories and field guides to the individual hues. Recommended on Amazon."
      limit={3}
      offset={6}
    />
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
  const tiles = document.querySelectorAll<HTMLElement>(".color-tile");

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => p.classList.remove("is-active"));
      pill.classList.add("is-active");

      const hue = pill.dataset.hue;
      tiles.forEach((tile) => {
        if (hue === "all" || tile.dataset.hue === hue) {
          tile.style.display = "";
        } else {
          tile.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  .colors-hero {
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .colors-hero__inner {
    max-width: 62rem;
  }

  .colors-hero .eyebrow {
    margin-bottom: 1.5rem;
  }

  .colors-hero__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.4vw + 0.75rem, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-700);
    max-width: 58ch;
    margin-top: 1.75rem;
  }

  .colors-hero__glossary {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-500);
    border-radius: var(--radius-sm);
    max-width: 65ch;
  }

  .colors-hero__glossary-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-500);
    margin: 0 0 0.375rem;
  }

  .colors-hero__glossary-text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-800);
    margin: 0;
  }

  .colors-hero__glossary-text a {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    font-weight: 500;
  }

  .colors-hero__glossary-text a:hover {
    color: var(--color-accent-700);
  }

  /* ============ FILTER BAR ============ */

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-paper-50);
    color: var(--color-ink-700);
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease, background 150ms ease;
    letter-spacing: 0.02em;
    text-transform: capitalize;
  }

  .filter-pill:hover {
    border-color: var(--color-ink-900);
    color: var(--color-ink-900);
  }

  .filter-pill.is-active {
    background: var(--color-ink-900);
    color: var(--color-paper-50);
    border-color: var(--color-ink-900);
  }

  /* ============ GRID ============ */

  .colors-grid-section {
    padding-top: 0;
  }

  .colors-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .colors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 960px) {
    .colors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .colors-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .color-tile {
    display: block;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-plate);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .color-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-plate-hover);
  }

  .color-tile:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 4px;
  }

  .color-tile__swatch {
    aspect-ratio: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0.5rem;
  }

  .color-tile__hex {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .text-dark { color: rgba(0, 0, 0, 0.55); }
  .text-light { color: rgba(255, 255, 255, 0.7); }

  .color-tile__info {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .color-tile__name {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-900);
    line-height: 1.25;
  }

  .color-tile__ja {
    font-size: 0.75rem;
    color: var(--color-ink-500);
    font-family: var(--font-serif);
  }

  .color-tile__count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-400);
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  /* ==================== HUE FAMILIES ==================== */
  .hue-family-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-sm);
  }
  .hue-family-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .hue-family-card:hover {
    border-color: var(--color-accent, #5a5a5a);
    background: var(--color-surface);
  }
  .hue-family-card__dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hue-family-card__label {
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .hue-family-card__count {
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-left: auto;
  }
</style>
