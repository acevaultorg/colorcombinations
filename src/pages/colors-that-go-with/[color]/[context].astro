---
import BaseLayout from "@layouts/BaseLayout.astro";
import FurtherReading from "@components/FurtherReading.astro";
import BundleCta from "@components/BundleCta.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";
import { ART_SUPPLIES } from "@/config/monetization";
import { bestTextColorOn, contrastRatio, hexToRgb } from "@/lib/color";
import type { HexColor } from "@/types/palette";
import {
  commonColors,
  commonColorBySlug,
  contexts,
  contextBySlug,
  palettesFor,
  pairingPaths,
} from "@data/pairings";

export function getStaticPaths() {
  return pairingPaths().map((p) => ({ params: { color: p.color, context: p.context } }));
}

const { color: colorSlug, context: ctxSlug } = Astro.params;
const color = commonColorBySlug(colorSlug ?? "");
const ctx = contextBySlug(ctxSlug ?? "");
if (!color || !ctx) return Astro.redirect("/404");

const matches = palettesFor(color.hex, ctx).slice(0, 8);

// Deterministic supply rotation, same idiom as /colors/[slug] and /palettes/[slug].
// Seeded off BOTH slugs so the 703 pages in this class do not all lead with the same
// tool — a reader moving between contexts for one colour should meet the catalogue.
const supplyOffset =
  (`${color.slug}${ctx.slug}`.split("").reduce((sum, ch) => sum + ch.charCodeAt(0), 0)) %
  ART_SUPPLIES.length;

// ---- Partner families derived from the ACTUAL archive (the citable moat) ----
function hsl(hex: string) {
  const h = hex.replace("#", "");
  let [r, g, b] = [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)].map((v) => v / 255);
  const max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min;
  const l = (max + min) / 2;
  let hue = 0, s = 0;
  if (d !== 0) {
    s = d / (1 - Math.abs(2 * l - 1));
    if (max === r) hue = ((g - b) / d) % 6;
    else if (max === g) hue = (b - r) / d + 2;
    else hue = (r - g) / d + 4;
    hue = Math.round(hue * 60); if (hue < 0) hue += 360;
  }
  return { hue, s, l };
}
function family(hex: string): string {
  const { hue, s, l } = hsl(hex);
  if (l > 0.82 && s < 0.22) return "soft cream & off-white";
  if (l < 0.2) return "deep charcoal";
  if (s < 0.14) return "warm greige & grey";
  if ((hue >= 20 && hue < 45) && l < 0.45 && s < 0.55) return "soft brown";
  if (hue < 18 || hue >= 340) return "muted red";
  if (hue < 45) return "terracotta & clay";
  if (hue < 70) return "ochre & gold";
  if (hue < 160) return "green";
  if (hue < 200) return "teal";
  if (hue < 255) return "slate & blue";
  if (hue < 292) return "muted violet";
  return "dusty rose";
}
const famCount = new Map<string, number>();
for (const m of matches) {
  for (const p of m.partners) {
    const f = family(p);
    famCount.set(f, (famCount.get(f) ?? 0) + 1);
  }
}
const topFamilies = [...famCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map((e) => e[0]);
const partnerSentence =
  topFamilies.length >= 2
    ? `${topFamilies.slice(0, -1).join(", ")}, and ${topFamilies[topFamilies.length - 1]}`
    : topFamilies[0] ?? "warm neutrals";

// ---- Factual colour reference + pairing rationale (all computed from the hex — zero fabrication) ----
const rgb = hexToRgb(color.hex);
const { hue: cHue, s: cS, l: cL } = hsl(color.hex);
const sPct = Math.round(cS * 100);
const lPct = Math.round(cL * 100);
const _r = rgb.r / 255, _g = rgb.g / 255, _b = rgb.b / 255;
const _k = 1 - Math.max(_r, _g, _b);
const cmyk = _k >= 0.999
  ? { c: 0, m: 0, y: 0, k: 100 }
  : {
      c: Math.round(((1 - _r - _k) / (1 - _k)) * 100),
      m: Math.round(((1 - _g - _k) / (1 - _k)) * 100),
      y: Math.round(((1 - _b - _k) / (1 - _k)) * 100),
      k: Math.round(_k * 100),
    };
const temperature = cS < 0.12 ? "neutral" : (cHue < 75 || cHue >= 300) ? "warm" : (cHue >= 140 && cHue < 260) ? "cool" : "balanced";
const lightWord = cL > 0.7 ? "light and airy" : cL > 0.45 ? "mid-toned" : "deep and grounding";
const satWord = cS < 0.2 ? "nearly neutral" : cS < 0.5 ? "gently muted" : "saturated";
const textOn = bestTextColorOn(color.hex);
const cr = Math.round(contrastRatio(color.hex, textOn === "dark" ? "#1c1917" : "#fafaf9") * 10) / 10;
const wcag = cr >= 7 ? "AAA" : cr >= 4.5 ? "AA" : cr >= 3 ? "AA for large text" : "below AA (decorative use)";
const balanceNeed =
  temperature === "warm" ? "cool and neutral partners that temper its warmth"
  : temperature === "cool" ? "warm and neutral partners that add the warmth it lacks"
  : temperature === "neutral" ? "one accent with real hue, plus quiet tonal neighbours"
  : "both warmer and cooler neighbours";
const valueNeed = cL < 0.4 ? "lighter" : cL > 0.7 ? "deeper" : "both lighter and deeper";
const mood0 = (ctx.favorMoods && ctx.favorMoods[0]) ? ctx.favorMoods[0] : "considered";

// ---- SEO ----
const h1 = `Colors that go with ${color.name} for ${ctx.label}`;
const title = `Colors That Go With ${color.name} for ${ctx.label.replace(/^(a|an) /, "")}`;
const answer = `${color.name} (${color.hex}) — ${color.descriptor} — pairs best with ${partnerSentence}. ${ctx.tip} ${topFamilies[0] ?? "a warm neutral"}, drawn from ${matches.length} historically-grounded combinations below.`;
const description = `What colors go with ${color.name.toLowerCase()} for ${ctx.label}? ${color.name} pairs with ${partnerSentence}. ${matches.length} curated combinations from the 1933 Dictionary of Color Combinations, with hex codes.`;

const canonical = `/colors-that-go-with/${color.slug}/${ctx.slug}/`;
const siblings = contexts.filter((c) => c.slug !== ctx.slug);
const otherColors = commonColors.filter((c) => c.slug !== color.slug).slice(0, 7);

const faq = [
  { q: `What colors go with ${color.name.toLowerCase()} for ${ctx.label}?`, a: answer },
  { q: `What is the hex code for ${color.name.toLowerCase()}?`, a: `${color.name} is ${color.hex} — ${color.descriptor}.` },
  { q: `Does ${color.name.toLowerCase()} go with white?`, a: `Yes. ${color.name} reads clean against soft white and cream; for contrast, add one of: ${topFamilies.join(", ")}.` },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://colorcombinations.org/" },
      { "@type": "ListItem", position: 2, name: `Colors that go with ${color.name}` },
      { "@type": "ListItem", position: 3, name: ctx.label, item: `https://colorcombinations.org${canonical}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: h1,
    numberOfItems: matches.length,
    itemListElement: matches.map((m, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `https://colorcombinations.org/palettes/${m.palette.slug}/`,
      name: m.palette.title,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    speakable: { "@type": "SpeakableSpecification", cssSelector: [".answer"] },
    url: `https://colorcombinations.org${canonical}`,
  },
];
---

<BaseLayout
  adContent
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  keywords={[`colors that go with ${color.name.toLowerCase()}`, `${color.name.toLowerCase()} ${ctx.label}`, `${color.name.toLowerCase()} color combinations`, `what goes with ${color.name.toLowerCase()}`]}
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-4xl px-5 py-10">
    <nav class="mb-6 text-sm text-stone-500">
      <a href="/" class="hover:underline">Home</a> ›
      <span>Colors that go with {color.name}</span> ›
      <span>{ctx.label}</span>
    </nav>

    <header class="mb-8">
      <div class="flex items-center gap-4">
        <span
          class="inline-block h-16 w-16 shrink-0 rounded-xl shadow-inner ring-1 ring-black/10"
          style={`background:${color.hex}`}
          aria-hidden="true"
        ></span>
        <div>
          <h1 class="text-3xl font-semibold tracking-tight text-stone-900">{h1}</h1>
          <p class="mt-1 font-mono text-sm text-stone-500">{color.name} · {color.hex}</p>
        </div>
      </div>
      <p class="answer mt-5 text-lg leading-relaxed text-stone-700">{answer}</p>
      <p class="mt-3 text-sm text-stone-500">{ctx.lens}</p>
    </header>

    <!-- About the colour: factual reference, unique per colour -->
    <section class="mb-8 rounded-xl border border-stone-200 bg-stone-50/70 p-5">
      <h2 class="mb-2 text-lg font-semibold text-stone-900">About {color.name.toLowerCase()}</h2>
      <p class="text-stone-700">
        {color.name} is {color.descriptor} — a {satWord}, {temperature} colour that reads as {lightWord}. As a {temperature}
        tone it looks most resolved next to {balanceNeed}, and it needs {valueNeed} shades nearby for the value contrast the
        eye reads as finished. That balance is what makes it feel {mood0} in {ctx.label}.
      </p>
      <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-4">
        <div><dt class="text-[11px] uppercase tracking-wide text-stone-400">HEX</dt><dd class="font-mono text-stone-800">{color.hex}</dd></div>
        <div><dt class="text-[11px] uppercase tracking-wide text-stone-400">RGB</dt><dd class="font-mono text-stone-800">{rgb.r}, {rgb.g}, {rgb.b}</dd></div>
        <div><dt class="text-[11px] uppercase tracking-wide text-stone-400">HSL</dt><dd class="font-mono text-stone-800">{cHue}°, {sPct}%, {lPct}%</dd></div>
        <div><dt class="text-[11px] uppercase tracking-wide text-stone-400">CMYK</dt><dd class="font-mono text-stone-800">{cmyk.c}, {cmyk.m}, {cmyk.y}, {cmyk.k}</dd></div>
      </dl>
      <p class="mt-3 text-sm text-stone-500">
        Accessibility: put <strong>{textOn}</strong> text on {color.name.toLowerCase()} for {wcag} legibility
        (contrast {cr}:1 against {textOn === "dark" ? "near-black" : "off-white"}).
      </p>
    </section>

    <!-- Why it pairs: colour theory grounded in the archive evidence, unique per colour -->
    <section class="mb-9">
      <h2 class="mb-3 text-lg font-semibold text-stone-900">Why {color.name.toLowerCase()} pairs with {partnerSentence}</h2>
      <p class="mb-4 text-stone-700">
        Across the {matches.length} historical combinations below, {color.name.toLowerCase()} sits most often beside
        {partnerSentence}. That tracks with colour theory: a {temperature}, {lightWord.split(" ")[0]} tone like this one
        wants {balanceNeed} so the scheme feels intentional rather than flat, and {valueNeed} partners supply the
        light-to-dark range the eye needs. {ctx.lens}
      </p>
      <ul class="flex flex-wrap gap-2">
        {topFamilies.map((f) => (
          <li class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-sm text-stone-700">{f}</li>
        ))}
      </ul>
    </section>

    <!-- Context guidance woven with the colour, unique per colour + setting -->
    <section class="mb-10 rounded-xl border border-stone-200 p-5">
      <h2 class="mb-2 text-lg font-semibold text-stone-900">Using {color.name.toLowerCase()} in {ctx.label}</h2>
      <p class="text-stone-700">
        {ctx.tip} {topFamilies.slice(0, 2).join(" and ") || "a warm neutral"}. Because {color.name.toLowerCase()} is
        {" "}{lightWord}, {cL < 0.45
          ? `keep it to anchor pieces or a single feature area and let ${topFamilies[0] ?? "a light neutral"} carry the larger surfaces`
          : `it can cover larger surfaces, with ${topFamilies[topFamilies.length - 1] ?? "a deeper tone"} added for depth`}.
      </p>
    </section>

    <!-- Curated combinations from the archive -->
    <section>
      <h2 class="mb-4 text-lg font-semibold text-stone-900">
        {matches.length} combinations with {color.name.toLowerCase()}, from the 1933 Dictionary
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {matches.map((m) => {
          const all = [m.matchHex, ...m.partners] as HexColor[];
          return (
            <a
              href={`/palettes/${m.palette.slug}/`}
              class="group block overflow-hidden rounded-xl border border-stone-200 transition hover:shadow-md"
            >
              <div class="flex h-20">
                {all.map((hx) => (
                  <span
                    class="relative flex-1"
                    style={`background:${hx}`}
                    title={hx}
                  >
                    {hx === m.matchHex && (
                      <span
                        class="absolute inset-x-0 bottom-0 text-center text-[9px] font-semibold uppercase tracking-wide"
                        style={`color:${bestTextColorOn(hx) === "dark" ? "#1c1917" : "#fafaf9"}`}
                      >{color.name}</span>
                    )}
                  </span>
                ))}
              </div>
              <div class="p-3">
                <p class="text-sm font-medium text-stone-900 group-hover:underline">{m.palette.title}</p>
                <p class="mt-0.5 line-clamp-2 text-xs text-stone-500">{m.palette.summary}</p>
                <p class="mt-1 font-mono text-[10px] text-stone-400">{all.join("  ")}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Sibling contexts: same color, other uses (internal linking engine) -->
    <section class="mt-12 border-t border-stone-200 pt-6">
      <h2 class="mb-3 text-base font-semibold text-stone-900">{color.name} in other settings</h2>
      <div class="flex flex-wrap gap-2">
        {siblings.map((c) => (
          <a
            href={`/colors-that-go-with/${color.slug}/${c.slug}/`}
            class="rounded-lg border border-stone-200 px-3 py-1.5 text-sm text-stone-700 hover:border-stone-400"
          >{color.name} for {c.label}</a>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="mb-3 text-base font-semibold text-stone-900">Other colors</h2>
      <div class="flex flex-wrap gap-2">
        {otherColors.map((c) => (
          <a
            href={`/colors-that-go-with/${c.slug}/${ctx.slug}/`}
            class="flex items-center gap-2 rounded-lg border border-stone-200 px-3 py-1.5 text-sm text-stone-700 hover:border-stone-400"
          >
            <span class="inline-block h-3 w-3 rounded-full" style={`background:${c.hex}`}></span>
            {c.name} for {ctx.label}
          </a>
        ))}
      </div>
    </section>

    {/* Intent-matched supplies BEFORE the book shelf. Measured 2026-08-29: this page
        class is 703 URLs (48% of the sitemap) and produced 861 entrances / 915 views
        with ZERO Amazon clicks in 30d, while every section that already carries
        PaintThisPalette converts (/shop 387, /home 15.1, /browse 10.5, /collections 9.0,
        /colors 6.0, /palettes 4.0 clicks per 1k views). It was the ONLY page class
        without it. The component's own note has the reason: the reader "is usually
        about to MAKE something, not to buy an out-of-print import" — and these pages
        offered only the colour-theory books, identically, whether the page said
        "for a bedroom" or "for an outfit". */}
    <div class="mt-10">
      <PaintThisPalette
        title="Work with this pairing"
        intro={`You have the hex codes for ${color.name} ${ctx.label === "clothes" ? "in clothes" : `for ${ctx.label}`}. These are the materials a colour study like this actually gets made with.`}
        limit={2}
        offset={supplyOffset}
      />
      <BundleCta />
      <FurtherReading
      pageClass="colors-that-go-with"
        title="Go deeper on colour"
        intro={`The colour-theory books behind pairings like ${color.name} — history, reference and the science of what works together.`}
      />
    </div>
  </main>
</BaseLayout>
