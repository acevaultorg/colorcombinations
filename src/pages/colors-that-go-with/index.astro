---
import FurtherReading from "@components/FurtherReading.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { commonColors, contexts, palettesFor, MIN_PALETTES } from "@data/pairings";

// Group available context pages under each color (quality-guarded).
const groups = commonColors
  .map((color) => ({
    color,
    ctxs: contexts.filter((ctx) => palettesFor(color.hex, ctx).length >= MIN_PALETTES),
  }))
  .filter((g) => g.ctxs.length > 0);

// Title, description and schema built from the list this page renders (2026-09-30).
// The old title ("Colors That Go With — pairing guides by color & setting") did not
// read as the question people type, and the only schema was a bare CollectionPage.
const guideCount = groups.length;
const title = `What Colors Go Together? ${guideCount} Pairing Guides`;
const description = `Pick a color — sage green, navy, terracotta, mustard and ${guideCount - 4} more — and see what goes with it, by setting: walls, weddings, clothes, kitchens.`;

const pageUrl = "https://colorcombinations.org/colors-that-go-with/";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: pageUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://colorcombinations.org/" },
      { "@type": "ListItem", position: 2, name: "Colors that go with", item: pageUrl },
    ],
  },
  // Same order, names and URLs as the h2 links below — the schema lists only what the page shows.
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Colors that go with — pairing guides",
    numberOfItems: guideCount,
    itemListElement: groups.map(({ color }, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `Colors that go with ${color.name}`,
      url: `${pageUrl}${color.slug}/`,
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical="/colors-that-go-with/" jsonLd={jsonLd} alternates={[{ hreflang: "en", href: "/colors-that-go-with/" }, { hreflang: "de", href: "/de/farben-kombinieren/" }, { hreflang: "x-default", href: "/colors-that-go-with/" }]} adContent>
  <main class="mx-auto max-w-4xl px-5 py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-stone-900">Colors that go with…</h1>
      <p class="mt-2 max-w-2xl text-stone-600">
        Practical pairing guides — pick a color and a setting. Every page answers it with real,
        historically-grounded combinations from Sanzo Wada's 1933 <em>Dictionary of Color
        Combinations</em>, with copyable hex codes.
      </p>
      <p class="mt-4 text-sm"><a class="underline" href="/tools/complementary-colors/">Find complementary colors with the interactive color wheel →</a></p>
    </header>

    <div class="space-y-8">
      {groups.map(({ color, ctxs }) => (
        <section>
          <h2 class="mb-3 flex items-center gap-2 text-lg font-semibold text-stone-900">
            <span class="inline-block h-5 w-5 rounded-md ring-1 ring-black/10" style={`background:${color.hex}`}></span>
            <a href={`/colors-that-go-with/${color.slug}/`} class="hover:underline">Colors that go with {color.name}</a>
          </h2>
          <div class="flex flex-wrap gap-2">
            {ctxs.map((ctx) => (
              <a
                href={`/colors-that-go-with/${color.slug}/${ctx.slug}/`}
                class="rounded-lg border border-stone-200 px-3 py-1.5 text-sm text-stone-700 hover:border-stone-400"
              >{color.name} for {ctx.label}</a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <p>Paid links below. As an Amazon Associate we earn from qualifying purchases.</p>
  <FurtherReading limit={2} title="Colour references for your next project" intro="Compare the original references behind this archive. Check the contents, edition and format before choosing a book." pageClass="pairing-index" />
</BaseLayout>
