  "What Scandinavian color tradition actually is — beyond IKEA-white — and which palettes from Sanzo Wada's 1933 dictionary read as Nordic when you remove the surface ornament.";

const keywords = [
  "scandinavian color theory",
  "nordic color palette",
  "hygge color theory",
  "scandinavian color scheme",
  "nordic minimalism colors",
  "scandinavian interior color palette",
  "hygge palette",
  "wabi-sabi vs hygge",
];

const SITE_FIRST_PUBLISHED = "2026-04-25T00:00:00Z";
const BUILD_DATE = new Date().toISOString();
const siteUrl = "https://colorcombinations.org/";
const articleUrl = `${siteUrl}learn/scandinavian-color-theory/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    url: articleUrl,
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
    inLanguage: "en",
    keywords: keywords.join(", "),
    articleSection: "Color theory",
    wordCount: 760,
    author: {
