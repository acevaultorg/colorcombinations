---
/**
 * /learn — Section landing page for long-form pillar articles.
 *
 * Hosts 13 articles as of 2026-09-06 (was 1 at authoring time — this
 * comment had gone stale). As more articles ship, they get indexed
 * here. Schema.org Blog with every article as blogPost ItemList —
 * Knowledge-Graph-eligible.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import PaintThisPalette from "@components/PaintThisPalette.astro";

const title = "Learn";
const description =
  "Long-form articles on color theory, palette use, and the Japanese tradition behind the dictionary. Working guides for designers, with named pigments and concrete palette references.";

const articles = [
  {
    href: "/learn/ridgway-color-names/",
    title: "Why Wada's Colors Have Names Like Hay's Russet: Ridgway's 1912 Color Standards",
    eyebrow: "Guide · Color names",
    description:
      "We matched all 159 English color names in Wada's dictionary against Robert Ridgway's 1912 Color Standards and Color Nomenclature. Most are his names, misprints included.",
    publishedDate: "2026-10-07",
    readingTime: "4 min",
    tags: ["History", "Reference", "Data"],
  },
  {
    href: "/learn/color-dictionaries/",
    title: "The Famous Color Dictionaries, From Werner's 1814 Nomenclature to Sanzo Wada",
    eyebrow: "Guide · Reference books",
    description:
      "Six color dictionaries side by side: Werner (1814), Maerz and Paul (1930), Wada (1933–34), the ISCC–NBS names (1955) and two modern designer's books. What each holds and which you can still buy.",
    publishedDate: "2026-10-07",
    readingTime: "5 min",
    tags: ["Books", "History", "Reference"],
  },
  {
    href: "/learn/why-painting-colours-shift/",
    title: "The Yellow Problem: Why Painting Colours Are Not What the Artist Mixed",
    eyebrow: "Pigments · Paintings",
    description:
      "Chrome yellow browns, zinc yellow darkens to ochre, cadmium yellow turns off-white. Three famous paintings, three chemical failures, and what that means when you sample a palette from art.",
    publishedDate: "2026-08-06",
    readingTime: "6 min",
    tags: ["Pigments", "Paintings", "Color theory"],
  },
  {
    href: "/learn/wada-palettes-by-mood/",
    title: "Wada Palettes by Mood and Season: Grouping the 348 Plates",
    eyebrow: "Original research · Data",
    description:
      "All 348 historical combinations grouped by computed mood — dark, pale, warm, cool, two-color, four-color — and by a practical seasonal reading, with example plates for each group.",
    publishedDate: "2026-07-23",
    readingTime: "6 min",
    tags: ["Data", "Original research", "Seasons"],
  },
  {
    href: "/learn/wada-color-psychology/",
    title: "Color Psychology in Wada's System: What 348 Plates Are Built to Feel Like",
    eyebrow: "Original research · Color theory",
    description:
      "How often Wada sets warm against cool inside one plate, why the archive lives in the mid-tones, and what the two-color discipline does to a viewer — the psychology, measured from the archive.",
    publishedDate: "2026-07-23",
    readingTime: "6 min",
    tags: ["Color theory", "Original research", "Psychology"],
  },
  {
    href: "/color-psychology/",
    title: "Color Psychology: An Honest, Designer's Guide",
    eyebrow: "Guide · Color theory",
    description:
      "What colors actually communicate in design — the cultural and contextual associations behind red, blue, green and the rest, honestly framed as associations rather than hard psychological law, and grounded in real palette practice.",
    publishedDate: "2026-06-21",
    readingTime: "7 min",
    tags: ["Color theory", "Design", "Psychology"],
  },
  {
    href: "/learn/color-data-analysis/",
    title: "What 348 Palettes Reveal: A Data Analysis of Sanzo Wada's Dictionary",
    eyebrow: "Original research · Data",
    description:
      "We measured the full 348-combination set: the most-used colors, which hues dominate, how many colors a combination holds, and how many are legible enough for screen text. Original analysis, computed from the archive itself.",
    publishedDate: "2026-06-01",
    readingTime: "6 min",
    tags: ["Data", "Original research", "Accessibility"],
  },
  {
    href: "/learn/accessible-palettes/",
    title: "Accessible Japanese Palettes: Which Wada Combinations Work for Text",
    eyebrow: "Original research · Accessibility",
    description:
      "Only a minority of Wada's 348 historical palettes hold a WCAG-AA contrast pair strong enough for body text. The full, contrast-sorted shortlist — with the exact pair to use in each.",
    publishedDate: "2026-06-01",
    readingTime: "5 min",
    tags: ["Accessibility", "WCAG", "Original research"],
  },
  {
    href: "/learn/wada-palettes-web-design/",
    title: "How to Use Sanzo Wada Palettes in Web Design",
    eyebrow: "Working guide · Web design",
    description:
      "Take a 1933 historical combination and use it in a real interface — pick for the medium, assign color roles, pass contrast, and ship it as CSS. A working method, with a worked example computed from the archive.",
    publishedDate: "2026-06-01",
    readingTime: "6 min",
    tags: ["Web design", "Working guide", "CSS"],
  },
  {
    href: "/learn/heian-court-color-theory/",
    title: "Heian Court Color Theory: Kasane, Kinjiki, and the Seasonal Palette",
    eyebrow: "Color theory · Long read",
    description:
      "How the Heian imperial court systematised colour into layered-robe combinations (kasane no irome), forbidden pigments (kinjiki), and a 12-month seasonal calendar — with the 1933 Wada palettes that hold the same logic.",
    publishedDate: "2026-04-25",
    readingTime: "5 min",
    tags: ["Heian", "Imperial", "Kasane"],
  },
  {
    href: "/learn/japanese-reds/",
    title: "The Four Reds: Kurenai, Akane, Shu, Entan",
    eyebrow: "Color theory · Long read",
    description:
      "Why Japanese tradition distinguishes safflower crimson from madder from vermilion from lead red — and which to reach for when the brief asks for 'a Japanese red.' Pigments, meaning, and four working palettes.",
    publishedDate: "2026-04-25",
    readingTime: "5 min",
    tags: ["Reds", "Pigments", "Heian"],
  },
  {
    href: "/learn/sanzo-wada/",
    title: "Who Was Sanzo Wada? The Painter Behind the Dictionary",
    eyebrow: "Biography · Reference",
    description:
      "Paris-trained painter, Oscar-winning costume designer for Gate of Hell, founder of Japan's color research institute, and author of the study behind A Dictionary of Color Combinations. His life, a timeline, and his books.",
    publishedDate: "2026-10-07",
    readingTime: "5 min",
    tags: ["Sanzo Wada", "Biography", "History"],
  },
  {
    href: "/learn/japanese-blues/",
    title: "Japanese Blues: Ai, Kon, Hanada, Asagi, Ruri, Gunjō",
    eyebrow: "Color theory · Long read",
    description:
      "Why Japanese has a name for each step of the indigo vat (ai, kon, hanada, asagi) and two more for blues that come from stone (ruri and gunjō). The dyes, what each blue signals, and a working palette per blue.",
    publishedDate: "2026-09-28",
    readingTime: "5 min",
    tags: ["Blues", "Indigo", "Pigments"],
  },
  {
    href: "/learn/japanese-greens/",
    title: "Japanese Greens: Tokiwa, Matsuba, Moegi, Wakatake, Matcha, Seiji",
    eyebrow: "Color theory · Long read",
    description:
      "How Japanese names green by what it grows on: evergreen pine (tokiwa, matsuba), new shoots and young bamboo (moegi, wakatake), tea (matcha) and glaze (seiji). What each green signals, and a working palette per green.",
    publishedDate: "2026-09-28",
    readingTime: "4 min",
    tags: ["Greens", "Pigments", "Japanese"],
  },
  {
    href: "/learn/japanese-purples/",
    title: "Japanese Purples: Murasaki, Edo-murasaki, Kikyō, Fuji",
    eyebrow: "Color theory · Long read",
    description:
      "Why purple was the top court rank in Japan, how Edo's bluish purple differs from classical murasaki, and the two flower purples, kikyō and fuji. What each signals, and a working palette per purple.",
    publishedDate: "2026-09-28",
    readingTime: "4 min",
    tags: ["Purples", "Heian", "Imperial"],
  },
  {
    href: "/learn/wabi-sabi-color-theory/",
    title: "Wabi-Sabi Color Theory: The Beauty of Things That Have Aged",
    eyebrow: "Color theory · Long read",
    description:
      "What it actually means for color when a tradition values age over newness, asymmetry over balance, and imperfection over polish. Tea-room palette, three exemplars, and the anti-patterns to avoid.",
    publishedDate: "2026-04-25",
    readingTime: "5 min",
    tags: ["Wabi-Sabi", "Tea Ceremony", "Japanese"],
  },
  {
    href: "/learn/japandi-color-theory/",
    title: "Japandi Color Theory: Where Restraint Meets Light",
    eyebrow: "Color theory · Long read",
    description:
      "How Japanese and Scandinavian color traditions converge — and which palettes from the Wada dictionary actually fit the Japandi brief. Three working palettes, three anti-patterns, and the three-axis test.",
    publishedDate: "2026-04-25",
    readingTime: "5 min",
    tags: ["Japandi", "Wabi-Sabi", "Scandinavian"],
  },
  {
    href: "/learn/scandinavian-color-theory/",
    title: "Scandinavian Color Theory: A Working Guide",
    eyebrow: "Color theory · Long read",
    description:
      "What Scandinavian color tradition actually is — beyond IKEA-white — plus the hygge divergence, three palettes from the dictionary that fit, and the all-grey trap to avoid.",
    publishedDate: "2026-04-25",
    readingTime: "5 min",
    tags: ["Scandinavian", "Hygge", "Nordic"],
  },
  {
    href: "/learn/japanese-color-glossary/",
    title: "Japanese Color Glossary: 20 Traditional Named Colors",
    eyebrow: "Reference · Glossary",
    description:
      "Twenty canonical traditional Japanese colour names with pigment origin, cultural register, and modern usage. Anchored for jump-linking — single-page reference complementing the per-color detail pages.",
    publishedDate: "2026-04-26",
    readingTime: "12 min",
    tags: ["Glossary", "Reference", "Named colors"],
  },
  {
    href: "/glossary/",
    title: "Color & Design Glossary: 22 Terms Every Palette Page Uses",
    eyebrow: "Reference · Glossary",
    description:
      "Hue, saturation, complementary, triadic, RGB/CMYK, WCAG contrast, and 16 more design-vocabulary terms — with four relational terms illustrated by a real pairing computed from the 348-plate Wada archive, not an invented example.",
    publishedDate: "2026-09-06",
    readingTime: "10 min",
    tags: ["Glossary", "Reference", "Color theory"],
  },
];

// Every page under src/pages/learn/ must be listed above. The list is kept by hand, and
// /learn/why-painting-colours-shift/ sat live for 53 days with no link from this hub (queue-k 2026-09-28).
const learnPages = Object.keys(import.meta.glob("./*/index.astro")).map((p) => `/learn/${p.split("/")[1]}/`);
const unlisted = learnPages.filter((h) => !articles.some((a) => a.href === h));
if (unlisted.length) throw new Error(`learn/index.astro: add these pages to \`articles\`: ${unlisted.join(", ")}`);

const siteUrl = "https://colorcombinations.org/";
const learnUrl = `${siteUrl}learn/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Learn — The Dictionary of Color Combinations",
    description,
    url: learnUrl,
    inLanguage: "en",
    publisher: { "@id": `${siteUrl}#organization` },
    isPartOf: { "@id": `${siteUrl}#website` },
    blogPost: articles.map((a) => ({
      "@type": "BlogPosting",
      headline: a.title,
      url: new URL(a.href, Astro.site).toString(),
      datePublished: a.publishedDate,
      keywords: a.tags.join(", "),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Learn" },
    ],
  },
];
---

<BaseLayout
  adContent
  title={title}
  description={description}
  image="/og/learn.png"
  jsonAlternate="/api/learn.json"
  keywords={[
    "color theory articles",
    "japandi color theory",
    "wabi sabi color guide",
    "japanese color palette guide",
    "design color theory",
  ]}
  jsonLd={jsonLd}
>
  <section class="learn-hero">
    <div class="container-narrow">
      <p class="eyebrow">Learn</p>
      <h1 class="display-hero text-balance">
        Working guides for designers.
      </h1>
      <p class="learn-hero__lede">
        Long-form articles on color theory, palette use, and the Japanese
        tradition behind the dictionary. Each piece links to specific
        palette + collection pages so you can move from idea to
        implementation in one click.
      </p>
      <aside class="learn-hero__order">
        <p class="learn-hero__order-eyebrow">Suggested reading order</p>
        <p class="learn-hero__order-text">
          The five pillars trace one argument across 1,200 years.
          Read in this order if you want the full thread:
          <a href="/learn/heian-court-color-theory/">Heian (the historical foundation)</a>
          <span aria-hidden="true">→</span>
          <a href="/learn/japanese-reds/">The Four Reds (the named pigments)</a>
          <span aria-hidden="true">→</span>
          <a href="/learn/wabi-sabi-color-theory/">Wabi-Sabi (the source philosophy)</a>
          <span aria-hidden="true">→</span>
          <a href="/learn/japandi-color-theory/">Japandi (the modern fusion)</a>
          <span aria-hidden="true">→</span>
          <a href="/learn/scandinavian-color-theory/">Scandinavian (the Western half of the fusion)</a>.
        </p>
      </aside>
    </div>
  </section>

  <section class="section learn-list">
    <div class="container-narrow">
      <ul class="learn-articles" role="list">
        {articles.map((a) => (
          <li>
            <a href={a.href} class="learn-article">
              <p class="learn-article__eyebrow">{a.eyebrow} · {a.readingTime}</p>
              <h2 class="learn-article__title">{a.title}</h2>
              <p class="learn-article__desc">{a.description}</p>
              <div class="learn-article__meta">
                <time datetime={a.publishedDate}>{a.publishedDate}</time>
                <span class="learn-article__tags">
                  {a.tags.map((t, i) => (
                    <>
                      <span>{t}</span>
                      {i < a.tags.length - 1 && <span aria-hidden="true">·</span>}
                    </>
                  ))}
                </span>
                <span class="learn-article__more" aria-hidden="true">Read →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <p class="learn-future">
        More articles coming soon — wabi-sabi color theory, the three
        Japanese reds, brand colors that age well. Subscribe via the
        <a href="/feed.xml">RSS feed</a> or
        <a href="/#newsletter">newsletter</a> to get them as they ship.
      </p>
    </div>
  </section>

  {/* Zero-CTA hub shelf (2026-09-25, card muh0x9j6pjkquk): this hub had ~47 human-channel
      views/30d and no Amazon link at all. Own pageClass so the fleet-aggregate read can separate it. */}
  <section class="container-narrow">
    <PaintThisPalette
      title="Put the theory on paper"
      intro="Colour theory sticks once you mix it by hand. These are the materials a colour study actually gets made with."
      limit={4}
      offset={4}
      pageClass="hub-learn"
    />
  </section>
</BaseLayout>

<style>
  .learn-hero {
    padding: 3rem 0 1.5rem;
  }

  .container-narrow {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .learn-hero__lede {
    font-size: 1.0625rem;
    color: var(--color-ink-700);
    line-height: 1.55;
    margin-top: 1rem;
    max-width: 56ch;
  }

  .learn-hero__order {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-500);
    border-radius: var(--radius-sm);
    max-width: 65ch;
  }

  .learn-hero__order-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-500);
    margin: 0 0 0.5rem;
  }

  .learn-hero__order-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-800);
    margin: 0;
  }

  .learn-hero__order-text a {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    margin: 0 0.125rem;
  }

  .learn-hero__order-text a:hover {
    color: var(--color-accent-700);
  }

  .learn-hero__order-text span[aria-hidden] {
    color: var(--color-ink-300);
    margin: 0 0.25rem;
  }

  .learn-list {
    padding: 1rem 0 4rem;
  }

  .learn-articles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .learn-article {
    display: block;
    padding: 1.75rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .learn-article:hover {
    border-color: var(--color-ink-900);
    box-shadow: 0 1px 0 var(--color-border);
  }

  .learn-article__eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-500);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .learn-article__title {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.5vw + 0.875rem, 1.625rem);
    line-height: 1.2;
    margin: 0 0 0.625rem;
    color: var(--color-ink-900);
  }

  .learn-article__desc {
    font-size: 0.9375rem;
    color: var(--color-ink-700);
    line-height: 1.55;
    margin: 0 0 1rem;
    max-width: 60ch;
  }

  .learn-article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-ink-500);
  }

  .learn-article__tags {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .learn-article__more {
    margin-left: auto;
    color: var(--color-accent-500);
    font-weight: 500;
  }

  .learn-future {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    color: var(--color-ink-700);
    max-width: 60ch;
  }

  .learn-future a {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
