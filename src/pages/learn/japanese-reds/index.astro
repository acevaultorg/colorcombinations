import BundleCta from "@components/BundleCta.astro";
import ShareActions from "@components/ShareActions.astro";
import PillarNav from "@components/PillarNav.astro";

const title = "The Four Reds: Kurenai, Akane, Shu, Entan";
const description =
  "Why Japanese tradition distinguishes safflower crimson from madder from vermilion from lead red — and which to reach for when the brief asks for 'a Japanese red.' The pigments, the meaning, and four working palettes from the 1933 archive.";

const keywords = [
  "japanese red colors",
  "kurenai color",
  "akane color",
  "shu vermilion",
  "entan lead red",
  "japanese red pigments",
  "shikisai red",
  "crimson japanese palette",
];

const SITE_FIRST_PUBLISHED = "2026-04-25T00:00:00Z";
const BUILD_DATE = new Date().toISOString();
const siteUrl = "https://colorcombinations.org/";
const articleUrl = `${siteUrl}learn/japanese-reds/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    url: articleUrl,
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
