 * /learn/japanese-blues/ — Japanese colour series, sibling of /learn/japanese-blues/.
 * Every colour name, kanji and hex comes from the site's own colour data
 * (src/data/colors.ts via the palettes); palettes linked are real /palettes/ slugs.
 * Added 2026-09-28 (card mukgyvplzb3u1j).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import BundleCta from "@components/BundleCta.astro";
import FurtherReading from "@components/FurtherReading.astro";
import ShareActions from "@components/ShareActions.astro";

const title = "Japanese Blues: Ai, Kon, Hanada, Asagi, Ruri, Gunjō";
const description =
  "Why Japanese has a name for each step of the indigo vat (ai, kon, hanada, asagi) and two more for blues that come from stone (ruri and gunjō). The dyes, what each blue signals, and a working palette per blue.";

const keywords = [
  "japanese blue colors",
  "japanese indigo colors",
  "ai indigo color",
  "kon navy japanese",
  "hanada color",
  "asagi color",
  "ruri lapis blue",
  "gunjo ultramarine",
  "traditional japanese blues",
];

const SITE_FIRST_PUBLISHED = "2026-09-28T00:00:00Z";
import { contentDate } from "@/lib/contentDate";
