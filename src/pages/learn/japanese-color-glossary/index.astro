---
/**
 * /learn/japanese-color-glossary/ — single-page reference glossary.
 *
 * Aggregates the 20 most-canonical traditional Japanese named colours
 * with 60-80 word summaries each, hex swatches, and links to the full
 * /colors/[slug] detail pages. Designed as a scannable hub — different
 * angle from /colors/ (hue-grid) and /colors/[slug] (deep editorial).
 *
 * High LLM-citation surface: 20 named entities × concise definition ×
 * stable URL with anchors = Wikipedia-citation-eligible.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import BundleCta from "@components/BundleCta.astro";
import ShareActions from "@components/ShareActions.astro";
import { COLOR_STORIES } from "@data/colorStories";
import { colorBySlug } from "@data/colors";
import { bestTextColorOn } from "@/lib/color";
import type { HexColor } from "@/types/palette";

const title = "Japanese Color Glossary: 20 Traditional Named Colors";
const description =
  "Twenty traditional Japanese colour names — kurenai, akane, shu, entan, murasaki, ai, asagi, ruri, tokiwa, kon, kuro, yamabuki, tobi, kogecha, sumi, gofun, seiji, hanada, kaki, kinari — with pigment origin, cultural register, and modern usage notes. Anchored for jump-linking from any external citation.";

const keywords = [
  "japanese color names",
  "traditional japanese colors",
  "japanese color dictionary",
  "japanese color glossary",
  "shikisai colors",
  "wada color names",
  "edo period colors",
  "heian colors",
];

const SITE_FIRST_PUBLISHED = "2026-04-26T00:00:00Z";
const BUILD_DATE = new Date().toISOString();
const siteUrl = "https://colorcombinations.org/";
const articleUrl = `${siteUrl}learn/japanese-color-glossary/`;

// Curated reading order — historical / aesthetic groups, not strict
// alphabetical. Each entry pulls hex + nameJa from the colors data layer
// and the editorial paragraph from the colorStories data layer.
type GlossarySection = {
  heading: string;
  intro: string;
  slugs: string[];
};

const SECTIONS: ReadonlyArray<GlossarySection> = [
  {
    heading: "The Four Reds",
    intro:
      "Japanese tradition distinguishes four primary reds — each from a different pigment source, each carrying centuries of specific cultural use.",
    slugs: ["kurenai", "akane", "shu", "entan"],
  },
  {
    heading: "Wabi-Sabi Earth & Ink",
    intro:
      "The tea-room palette: warm earths, deep inks, and the cream anchor that holds them in tension.",
    slugs: ["tobi", "kogecha", "sumi", "gofun"],
  },
  {
    heading: "Japandi Cool & Warm",
    intro:
      "The colours that bridge the Japanese and Scandinavian traditions: a pale cool axis (celadon, half-indigo) plus a controlled warm accent (persimmon, unbleached cream).",
    slugs: ["seiji", "hanada", "kaki", "kinari"],
  },
  {
    heading: "Imperial & Court",
    intro:
      "The Heian-era court colours that signal status, formality, and ceremony — including the kinjiki (forbidden) ranks.",
    slugs: ["murasaki", "kon"],
  },
  {
    heading: "Indigo & Folk",
    intro:
      "The everyday-Japanese blues and greens of Edo-period workwear, folk textiles, and pre-modern craft tradition.",
    slugs: ["ai", "asagi", "ruri", "tokiwa"],
  },
  {
    heading: "Black, Yellow, and the Spring Palette",
    intro:
      "The remaining canonical hues that complete the working glossary: kuro (everyday black) and yamabuki (the kerria-flower spring gold).",
    slugs: ["kuro", "yamabuki"],
  },
];

// Helper: gather hex + Japanese name for each glossary entry from the
// colors data layer. Falls through to a placeholder if a slug doesn't
// resolve (shouldn't happen — all 20 are guaranteed by colorStories).
type GlossaryEntry = {
  slug: string;
  name: string;
  nameJa?: string;
  hex: HexColor;
  paragraphs: string[];
  textColor: string;
};

const ENTRIES: GlossaryEntry[] = SECTIONS.flatMap((s) =>
  s.slugs.flatMap((slug) => {
    const c = colorBySlug(slug);
    const story = COLOR_STORIES[slug];
    if (!c || !story) return [];
    return [
      {
        slug,
        name: c.name,
        nameJa: c.nameJa,
        hex: c.hex,
        paragraphs: story.paragraphs,
        textColor: bestTextColorOn(c.hex),
      } satisfies GlossaryEntry,
    ];
  })
);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    url: articleUrl,
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
    inLanguage: "en",
    keywords: keywords.join(", "),
    articleSection: "Color theory",
    wordCount: 2400,
    author: {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "The Dictionary of Color Combinations",
    },
    publisher: { "@id": `${siteUrl}#organization` },
    isPartOf: { "@id": `${siteUrl}#website` },
    isBasedOn: {
      "@type": "Book",
      name: "A Dictionary of Color Combinations",
      author: { "@id": `${siteUrl}#person-sanzo-wada` },
      datePublished: "1933",
      publisher: "Seigensha Art Publishing (2010 reprint)",
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
    license: "https://creativecommons.org/licenses/by/4.0/",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Learn", item: `${siteUrl}learn/` },
      { "@type": "ListItem", position: 3, name: "Japanese Color Glossary" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "Traditional Japanese Color Names",
    url: articleUrl,
    hasDefinedTerm: ENTRIES.map((e) => ({
      "@type": "DefinedTerm",
      "@id": `${articleUrl}#${e.slug}`,
      name: e.nameJa ? `${e.name} (${e.nameJa})` : e.name,
      termCode: e.slug,
      url: `${siteUrl}colors/${e.slug}/`,
      inDefinedTermSet: articleUrl,
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  image="/og/learn/japanese-color-glossary.svg"
  type="article"
  jsonAlternate="/api/learn/japanese-color-glossary.json"
  jsonLd={jsonLd}
>
  <article class="article">
    <header class="article-hero">
      <div class="container-narrow">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/learn/">Learn</a></li>
            <li aria-current="page">Japanese Color Glossary</li>
          </ol>
        </nav>
        <p class="eyebrow">Reference · Glossary</p>
        <h1 class="display-hero text-balance">{title}</h1>
        <p class="article-hero__lede">
          Twenty canonical traditional Japanese colour names with
          pigment origin, cultural register, and modern usage notes.
          Each entry has a deep-link anchor — cite specific names by
          jumping to <code>/learn/japanese-color-glossary/#kurenai</code>.
        </p>
        <ShareActions
          title={title}
          url={articleUrl}
          image={new URL("/og/learn/japanese-color-glossary.svg", Astro.site).toString()}
          description={description}
          heading="Share this glossary"
          download={{
            kind: "page",
            slug: "learn-japanese-color-glossary",
            title,
            subtitle: "20 traditional Japanese colors — name, history, working palette — in one citable reference.",
            eyebrow: "Reference · Glossary",
            accentHex: "#1a1714",
          }}
        />
      </div>
    </header>

    <div class="article-body container-narrow">
      <p>
        These twenty colours anchor most cultural references and palette
        discussions in Japanese design tradition. Each entry summarises
        the colour's pigment origin, historical use, and modern register
        in 80-150 words; click through to <a href="/colors/">the full
        color dictionary</a> for the complete /colors/[slug] detail
        page (palette uses, WCAG contrast, JSON API endpoint).
      </p>

      {SECTIONS.map((section) => (
        <section class="glossary-section">
          <h2 class="glossary-section__heading">{section.heading}</h2>
          <p class="glossary-section__intro">{section.intro}</p>

          <div class="glossary-list">
            {section.slugs.map((slug) => {
              const entry = ENTRIES.find((e) => e.slug === slug);
              if (!entry) return null;
              return (
                <article id={entry.slug} class="glossary-entry">
                  <div
                    class="glossary-entry__swatch"
                    style={`background-color: ${entry.hex}; color: ${entry.textColor};`}
                    aria-hidden="true"
                  >
                    <span class="glossary-entry__hex">{entry.hex}</span>
                  </div>
                  <div class="glossary-entry__body">
                    <h3 class="glossary-entry__name">
                      <a href={`/colors/${entry.slug}/`}>
                        {entry.nameJa && <span lang="ja">{entry.nameJa}</span>}
                        {" "}
                        {entry.name}
                      </a>
                    </h3>
                    <p class="glossary-entry__story" set:html={entry.paragraphs[0]} />
                    <p class="glossary-entry__cta">
                      <a href={`/colors/${entry.slug}/`}>Full {entry.name} page →</a>
                    </p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}

      <h2 id="see-also">See also</h2>
      <p>
        For deeper context on specific traditions, read the pillar
        articles: <a href="/learn/heian-court-color-theory/">Heian
        Court Color Theory</a> for the imperial-court colour system,
        <a href="/learn/japanese-reds/">The Four Reds</a> for the
        kurenai/akane/shu/entan deep-dive,
        <a href="/learn/wabi-sabi-color-theory/">Wabi-Sabi Color
        Theory</a> for the philosophy of aged colour,
        <a href="/learn/japandi-color-theory/">Japandi Color Theory</a>
        for the modern Japanese-Scandinavian fusion, and
        <a href="/learn/scandinavian-color-theory/">Scandinavian Color
        Theory</a> for the Western half. The
        <a href="/colors/">full color dictionary</a> indexes 211+
        named colours; this glossary covers the 20 most-cited.
      </p>

      <p class="article-end">— colorcombinations.org editorial</p>

      <BundleCta variant="medium" />
    </div>
  </article>
</BaseLayout>

<style>
  .article-hero {
    padding: 3rem 0 1.5rem;
  }

  .container-narrow {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .breadcrumb {
    font-size: 0.8125rem;
    color: var(--color-ink-500);
    margin-bottom: 1.5rem;
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .breadcrumb li:not(:last-child)::after {
    content: "›";
    margin-left: 0.5rem;
    color: var(--color-ink-300);
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .article-hero__lede {
    font-size: 1.125rem;
    color: var(--color-ink-700);
    line-height: 1.5;
    margin: 1.25rem 0 0;
    max-width: 60ch;
  }

  .article-hero__lede code {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.0625rem 0.375rem;
    font-size: 0.85em;
  }

  .article-body {
    padding: 1.5rem 1.5rem 4rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-800);
    max-width: 64rem;
  }

  .article-body > p {
    max-width: 65ch;
    margin: 0 0 2rem;
  }

  .article-body p a {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .article-body a:hover {
    color: var(--color-accent-700);
  }

  .glossary-section {
    margin-bottom: 3rem;
  }

  .glossary-section__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.75vw + 1rem, 1.875rem);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  .glossary-section__intro {
    color: var(--color-ink-700);
    max-width: 65ch;
    margin: 0 0 1.5rem;
    font-style: italic;
  }

  .glossary-list {
    display: grid;
    gap: 1.25rem;
  }

  .glossary-entry {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 1rem;
  }

  @media (max-width: 600px) {
    .glossary-entry {
      grid-template-columns: 1fr;
    }
  }

  .glossary-entry__swatch {
    border-radius: var(--radius-sm);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: flex-end;
    padding: 0.5rem;
    font-size: 0.6875rem;
    font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
    letter-spacing: 0.04em;
    border: 1px solid var(--color-border);
  }

  .glossary-entry__hex {
    background: rgba(0, 0, 0, 0.15);
    color: inherit;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
  }

  @media (max-width: 600px) {
    .glossary-entry__swatch {
      aspect-ratio: 4 / 1;
    }
  }

  .glossary-entry__name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  .glossary-entry__name a {
    color: var(--color-ink-900);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 1px;
  }

  .glossary-entry__name a:hover {
    border-bottom-color: var(--color-accent-500);
  }

  .glossary-entry__story {
    margin: 0 0 0.75rem;
    color: var(--color-ink-800);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .glossary-entry__cta {
    margin: 0;
    font-size: 0.875rem;
  }

  .glossary-entry__cta a {
    color: var(--color-accent-500);
    text-decoration: none;
    font-weight: 500;
  }

  .glossary-entry__cta a:hover {
    text-decoration: underline;
  }

  h2[id="see-also"] {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.75vw + 1rem, 1.875rem);
    margin: 2.5rem 0 1rem;
  }

  .article-end {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-style: italic;
    color: var(--color-ink-500);
    font-size: 0.9375rem;
  }
</style>
