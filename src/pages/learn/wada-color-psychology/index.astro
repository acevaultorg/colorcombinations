---
/**
 * /learn/wada-color-psychology/ — original-research pillar.
 *
 * Reads Sanzo Wada's 348 historical combinations through the standard
 * warm/cool + light/dark associations of color psychology, with every
 * structural claim computed from the archive at build time: how often
 * warm and cool are mixed inside one plate, how the value register
 * skews, and what the two-color discipline does perceptually.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import BundleCta from "@components/BundleCta.astro";
import ShareActions from "@components/ShareActions.astro";
import { wadaCatalog } from "@data/palettes";
import type { HexColor } from "@/types/palette";

const dict = wadaCatalog();
const N = dict.length;

// Per-color warm/cool classification from hue (documented in Method).
function tempOf(hex: string): "warm" | "cool" | "neutral" {
  const r = parseInt(hex.slice(1, 3), 16) / 255;
  const g = parseInt(hex.slice(3, 5), 16) / 255;
  const b = parseInt(hex.slice(5, 7), 16) / 255;
  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  const l = (max + min) / 2;
  const d = max - min;
  if (d < 0.1 || l < 0.12 || l > 0.92) return "neutral";
  let h;
  if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) * 60;
  else if (max === g) h = ((b - r) / d + 2) * 60;
  else h = ((r - g) / d + 4) * 60;
  // warm: red→yellow-green cusp; cool: green→violet
  return h < 85 || h >= 345 ? "warm" : "cool";
}

// 1. Temperature structure per plate
let mixed = 0, allWarm = 0, allCool = 0, withNeutral = 0;
for (const p of dict) {
  const temps = p.colors.map((c) => tempOf(c.hex));
  const hasW = temps.includes("warm");
  const hasC = temps.includes("cool");
  if (temps.includes("neutral")) withNeutral++;
  if (hasW && hasC) mixed++;
  else if (hasW) allWarm++;
  else if (hasC) allCool++;
}
const mixedPct = Math.round((100 * mixed) / N);
const allWarmPct = Math.round((100 * allWarm) / N);
const allCoolPct = Math.round((100 * allCool) / N);

// 2. Value (lightness) register from computed moods
const solemn = dict.filter((p) => p.moods.includes("solemn")).length;
const serene = dict.filter((p) => p.moods.includes("serene")).length;
const refined = dict.filter((p) => p.moods.includes("refined")).length;

// 3. Format discipline
const twoColor = dict.filter((p) => p.colors.length === 2).length;
const fourColor = dict.filter((p) => p.colors.length >= 4).length;

// Example plates for the temperature sections (first by plate order)
const mixedExamples = dict
  .filter((p) => {
    const t = p.colors.map((c) => tempOf(c.hex));
    return t.includes("warm") && t.includes("cool");
  })
  .slice(0, 3);
const allWarmExamples = dict
  .filter((p) => {
    const t = p.colors.map((c) => tempOf(c.hex));
    return t.includes("warm") && !t.includes("cool");
  })
  .slice(0, 3);

const title = "Color Psychology in Wada's System: What 348 Plates Are Built to Feel Like";
const description = `The 1933 Dictionary of Color Combinations, read through color psychology — with the structure measured: ${mixedPct}% of Wada's ${N} plates mix warm against cool, the value register sits overwhelmingly in the mid-tones, and a third of the archive is two-color restraint. What that composition does to a viewer, and how to use it.`;
const keywords = [
  "wada color psychology",
  "japanese color psychology",
  "warm cool color combinations",
  "sanzo wada color meaning",
  "color temperature palette design",
  "psychology of color palettes",
  "Sanzo Wada",
];

const SITE_FIRST_PUBLISHED = "2026-07-23T00:00:00Z";
const BUILD_DATE = new Date().toISOString();
const siteUrl = "https://colorcombinations.org/";
const articleUrl = `${siteUrl}learn/wada-color-psychology/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    url: articleUrl,
    datePublished: SITE_FIRST_PUBLISHED,
    dateModified: BUILD_DATE,
    inLanguage: "en",
    keywords: keywords.join(", "),
    articleSection: "Original research",
    author: { "@type": "Organization", "@id": `${siteUrl}#organization`, name: "The Dictionary of Color Combinations" },
    publisher: { "@id": `${siteUrl}#organization` },
    isPartOf: { "@id": `${siteUrl}#website` },
    isBasedOn: {
      "@type": "Book",
      name: "A Dictionary of Color Combinations",
      author: { "@id": `${siteUrl}#person-sanzo-wada` },
      datePublished: "1933",
      publisher: "Seigensha Art Publishing (2010 reprint)",
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
    license: "https://creativecommons.org/licenses/by/4.0/",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Learn", item: `${siteUrl}learn/` },
      { "@type": "ListItem", position: 3, name: "Color Psychology in Wada's System" },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  image="/og/learn/wada-color-psychology.svg"
  type="article"
  jsonAlternate="/api/learn/wada-color-psychology.json"
  jsonLd={jsonLd}
>
  <article class="article">
    <header class="article-hero">
      <div class="container-narrow">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/learn/">Learn</a></li>
            <li aria-current="page">Color Psychology in Wada's System</li>
          </ol>
        </nav>
        <p class="eyebrow">Original research · Color theory</p>
        <h1 class="display-hero text-balance">{title}</h1>
        <p class="article-hero__lede">
          Color psychology usually gets discussed one color at a time — red is
          energetic, blue is calm. Wada's 1933 dictionary is a rare chance to
          study it at the level where it actually operates: the combination. We
          measured the temperature, value, and format structure of all {N}
          historical plates to see what the archive is built to make a viewer
          feel.
        </p>
        <ShareActions
          title={title}
          url={articleUrl}
          image={new URL("/og/learn/wada-color-psychology.svg", Astro.site).toString()}
          description={description}
          heading="Share this analysis"
          download={{
            kind: "page",
            slug: "learn-wada-color-psychology",
            title,
            subtitle: `Temperature, value, and format across ${N} plates — measured.`,
            eyebrow: "Original research · Color theory",
            accentHex: "#1B2A4E",
          }}
        />
      </div>
    </header>

    <div class="article-body container-narrow">
      <p>
        Two ideas from color psychology are stable enough to build on: warm
        hues (reds through yellows) read as advancing, active, and near, while
        cool hues (greens through violets) read as receding, calm, and distant;
        and darker values read as heavier and more formal than lighter ones.
        What a single color "means" beyond that is mostly context. Combinations
        are where the real signal is — and combinations are exactly what Wada
        catalogued. The numbers below are computed from the archive at build
        time.
      </p>

      <h2 id="temperature">Wada's signature move: warm against cool</h2>
      <p>
        Classifying every member of every plate as warm, cool, or neutral:
      </p>
      <ul class="data-stats">
        <li><strong>{mixedPct}%</strong> ({mixed} of {N}) mix at least one warm and one cool color in the same plate.</li>
        <li><strong>{allWarmPct}%</strong> ({allWarm}) are entirely warm (plus neutrals).</li>
        <li><strong>{allCoolPct}%</strong> ({allCool}) are entirely cool (plus neutrals).</li>
      </ul>
      <p>
        This is the psychological engine of the dictionary. A warm-cool pair
        sets up a figure-ground relationship — the warm color advances, the
        cool one recedes — so even a two-color plate has depth and direction.
        It is why so many Wada pairings feel "complete" despite their size:
        temperature contrast does compositional work that would otherwise need
        more colors. Purely warm sets are the second-largest group, which fits
        the archive's <a href="/learn/color-data-analysis/">measured warm bias</a>;
        purely cool plates are comparatively rare, and read markedly quieter.
      </p>
      <h3>Warm-against-cool — three plates to study</h3>
      <ul class="mood-examples">
        {mixedExamples.map((p) => (
          <li>
            <span class="mood-swatches" aria-hidden="true">
              {p.colors.map((c) => (
                <span class="data-swatch" style={`background:${c.hex}`}></span>
              ))}
            </span>
            <a href={`/palettes/${p.slug}/`}>{p.title}</a>
          </li>
        ))}
      </ul>
      <h3>All-warm — three plates to study</h3>
      <ul class="mood-examples">
        {allWarmExamples.map((p) => (
          <li>
            <span class="mood-swatches" aria-hidden="true">
              {p.colors.map((c) => (
                <span class="data-swatch" style={`background:${c.hex}`}></span>
              ))}
            </span>
            <a href={`/palettes/${p.slug}/`}>{p.title}</a>
          </li>
        ))}
      </ul>

      <h2 id="value">The mid-tone register</h2>
      <p>
        By average lightness, {refined} of {N} plates ({Math.round((100 * refined) / N)}%)
        sit in the mid-tones; only {solemn} ({Math.round((100 * solemn) / N)}%) are
        dark enough to classify as solemn and {serene} ({Math.round((100 * serene) / N)}%)
        pale enough to classify as serene. Psychologically, mid-value palettes
        are the least assertive register: they neither dominate a room the way
        dark schemes do nor disappear the way pastels can. That restraint is
        deliberate — these were combinations for textiles and everyday printed
        goods, meant to be lived with rather than looked at. If you need
        gravity or airiness, the small solemn and serene groups are catalogued
        in <a href="/learn/wada-palettes-by-mood/">the mood grouping</a>.
      </p>

      <h2 id="format">What two colors do that four cannot</h2>
      <p>
        {twoColor} plates ({Math.round((100 * twoColor) / N)}%) are two-color
        pairings; {fourColor} ({Math.round((100 * fourColor) / N)}%) hold four.
        The perceptual difference is load: a pair presents one relationship to
        read, which is why two-color plates feel decisive and quiet at once,
        while a four-color set presents six pairwise relationships and reads as
        rich or busy depending on execution. Wada's heavy use of the pair —
        combined with the warm-cool contrast above — is a masterclass in
        getting maximum felt effect from minimum material.
      </p>

      <h2 id="using">Using this in practice</h2>
      <p>
        Three working rules fall out of the measurements. Want energy with
        stability? Start from a warm-cool pair and let the warm color take the
        active role (buttons, accents) with the cool as field. Want warmth
        without noise? The all-warm plates show how to vary temperature within
        one family. Want calm authority? Take a cool-leaning plate down the
        value scale toward the solemn group. In every case the plate's own page
        lists contrast ratios, so the psychological choice can be checked
        against legibility before it ships.
      </p>

      <h2 id="method">Method</h2>
      <p>
        Each color is classified warm (hue &lt; 85° or ≥ 345°), cool
        (85°–345°), or neutral (low saturation or extreme lightness) from its
        hex value via HSL; plate-level counts follow from member
        classifications. Value groups use average plate lightness (dark &lt;
        35%, pale &gt; 70%). The 30 modern editorial palettes are excluded; all
        figures describe the {N} historical plates and recompute at build time.
        The temperature and value associations referenced are the standard,
        broadly replicated ones (warm-advancing/cool-receding; dark-heavy/
        light-airy) — we make no claims beyond them. Source data is public
        domain; this analysis is
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC&nbsp;BY&nbsp;4.0</a>.
      </p>

      <p class="article-related">
        Keep reading: <a href="/learn/wada-palettes-by-mood/">palettes by mood and season</a> ·
        <a href="/learn/color-data-analysis/">the full data analysis</a> ·
        <a href="/color-psychology/">color psychology by hue</a> ·
        <a href="/browse/">browse all {N} combinations</a>.
      </p>

      <p class="article-end">— colorcombinations.org editorial</p>

      <BundleCta variant="medium" />
    </div>
  </article>
</BaseLayout>

<style>
  .data-stats {
    max-width: 65ch;
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }
  .data-stats li {
    margin-bottom: 0.5rem;
  }
  .mood-examples {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    max-width: 65ch;
  }
  .mood-examples li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    /* Matches the proven .data-colors pattern — lets a long plate title drop to
       its own line on narrow screens instead of being squeezed beside 4 swatches. */
    flex-wrap: wrap;
  }
  .mood-swatches {
    display: inline-flex;
    gap: 2px;
    flex: none;
  }
  .data-swatch {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    flex: none;
  }
  .article-related {
    margin-top: 2rem;
    font-size: 0.9375rem;
  }
  .article-related a {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-end {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-style: italic;
    color: var(--color-ink-500);
    font-size: 0.9375rem;
  }
</style>
