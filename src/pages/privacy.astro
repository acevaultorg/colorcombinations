---
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "Privacy Policy";
const description =
  "How The Dictionary of Color Combinations collects, uses, and protects your data — including our use of analytics and advertising.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: new URL("/privacy", Astro.site).toString(),
  isPartOf: {
    "@type": "WebSite",
    name: "The Dictionary of Color Combinations",
    url: Astro.site?.toString(),
  },
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <article class="legal-page section">
    <div class="container-prose">
      <header class="legal-page__header">
        <p class="eyebrow">Legal</p>
        <h1>Privacy Policy</h1>
        <p class="legal-page__updated">Last updated: September 2026</p>
      </header>

      <div class="prose">
        <h2>Who we are</h2>
        <p>
          The Dictionary of Color Combinations (<strong>colorcombinations.org</strong>) is a
          color reference and design resource inspired by Sanzo Wada's 1933 dictionary. You can
          contact us at <a href="mailto:hello@caslonmedia.com">hello@caslonmedia.com</a>.
        </p>

        <h2>What data we collect</h2>
        <p>We collect limited, anonymised data to understand how the site is used and to improve it:</p>
        <ul>
          <li>
            <strong>Analytics:</strong> We use <a href="https://clarity.microsoft.com" target="_blank" rel="noopener">Microsoft Clarity</a>
            (aggregate usage, heatmaps, and session replay of on-page interactions),
            <a href="https://marketingplatform.google.com/about/analytics/" target="_blank" rel="noopener">Google Analytics 4</a>
            (aggregate traffic reporting, with IP anonymisation enabled), and
            <a href="https://www.cloudflare.com/web-analytics/" target="_blank" rel="noopener">Cloudflare Web Analytics</a>
            (cookieless page and performance metrics). Clarity and Google Analytics set cookies or
            similar identifiers; Cloudflare Web Analytics does not. Clarity does not load at all for visitors whose browser time zone is in the EU, EEA, UK or Switzerland. We never sell this data.
          </li>
          <li>
            <strong>Third-party advertising:</strong> Advertising on this site is managed by
            <strong>Mediavine</strong> (Journey by Mediavine). Mediavine and its programmatic
            advertising partners use cookies and other identifiers to serve and measure ads,
            including ads based on your browsing activity on this site and/or other sites on
            the Internet.
            See the <a href="https://www.mediavine.com/privacy-policy/" target="_blank" rel="noopener">Mediavine privacy policy</a> for the data they process and the partners they work with.
          </li>
          <li>
            <strong>Affiliate links:</strong> Some links on this site (books, design tools) are
            affiliate links. If you click through and make a purchase, we may earn a small
            commission at no extra cost to you. These links do not set cookies on this site.
          </li>
        </ul>

        <h2 id="email-updates">Email updates</h2>
        <p>
          If you choose to join an interest list, we store your email address, the list and page
          you joined from, and the time and version of your consent in our Cloudflare storage.
          We use this to manage the updates you requested. These emails have not started yet.
          Joining does not subscribe you to other lists. We do not sell your address.
        </p>
        <p>
          To leave a list or request deletion of your address, email
          <a href="mailto:hello@caslonmedia.com">hello@caslonmedia.com</a> from that address.
          We keep your signup until you ask us to remove it or we discontinue the list.
        </p>

        <h2>Ask Amili</h2>
        <p>
          Questions typed into the Ask Amili bar are sent to our own server (taskpeace.com) and stored
          anonymously: the question text only, no IP address, no cookie, no identifier. We use them to
          see which answers are missing. The answers come only from pages on this site.
        </p>

        <h2>Cookies</h2>
        <p>
          Cloudflare Web Analytics is cookieless. Microsoft Clarity and Google Analytics 4 set cookies or similar identifiers to measure aggregate usage and record on-page interactions. Clarity does not load for visitors in the EU, EEA, UK or Switzerland. Mediavine and its
          advertising partners may set cookies on your device to serve and personalise advertising.
          You can opt out of personalised advertising at any time via
          <a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener">the NAI opt-out tool</a>,
          or manage consent using the "Cookie Preferences" link in the footer.
        </p>
        <p>
          A cookie consent banner is shown on first visit. You can manage your advertising
          preferences at any time using the "Cookie Preferences" link in the footer.
        </p>

        <h2>Data sharing</h2>
        <p>
          We do not sell, trade, or rent your personal data to third parties. We share anonymised
          usage data only with the analytics and advertising partners described above.
        </p>

        <h2>Your rights</h2>
        <p>
          Depending on your location, you may have rights to access, correct, or request deletion
          of data held about you. For email-list data, contact us directly. For data held by
          analytics and advertising partners, contact the relevant partner named above. To contact us, email
          <a href="mailto:hello@caslonmedia.com">hello@caslonmedia.com</a>.
        </p>

        <h2>EU / EEA / UK users</h2>
        <p>
          Under the GDPR and UK GDPR, you have additional rights including the right to object to
          processing and to lodge a complaint with your national supervisory authority. For
          personalised advertising in the EEA/UK, Mediavine operates a certified Consent Management
          Platform (CMP) that controls the consent flow.
        </p>

        <h2>California users (CCPA)</h2>
        <p>
          California residents may opt out of the "sale" of personal information. We do not sell
          personal information. To opt out of interest-based advertising, use
          <a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener">the NAI opt-out tool</a>
          or the "Cookie Preferences" link in the footer.
        </p>

        <h2>Children</h2>
        <p>
          This site is not directed at children under 13. We do not knowingly collect data from
          children.
        </p>

        <h2>External links</h2>
        <p>
          This site contains links to external resources. We are not responsible for the privacy
          practices of those sites.
        </p>

        <h2>Changes to this policy</h2>
        <p>
          We may update this policy periodically. The "Last updated" date at the top of the page
          reflects when changes were last made.
        </p>

        <h2>Contact</h2>
        <p>
          Privacy questions or requests: <a href="mailto:hello@caslonmedia.com">hello@caslonmedia.com</a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal-page {
    padding-block: var(--spacing-section);
  }

  .legal-page__header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .legal-page__header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-display-xl);
    font-weight: 500;
    color: var(--color-ink-900);
    margin: 0.5rem 0 0;
  }

  .legal-page__updated {
    color: var(--color-ink-500);
    font-size: 0.9375rem;
    margin-top: 0.75rem;
  }

  .prose h2 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--color-ink-900);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p,
  .prose ul,
  .prose ol {
    color: var(--color-ink-700);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .prose ul {
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.75rem;
  }

  .prose a {
    color: var(--color-link);
    text-decoration-line: underline;
    text-underline-offset: 3px;
  }

  .prose a:hover {
    color: var(--color-link-hover);
  }
</style>
