---
import BaseLayout from "@layouts/BaseLayout.astro";
import PaletteCard from "@components/PaletteCard.astro";
import BundleCta from "@components/BundleCta.astro";
import { moods } from "@data/moods";
import { palettes } from "@data/palettes";

export function getStaticPaths() {
  return moods.map((m) => ({ params: { slug: m.slug }, props: { mood: m } }));
}

const { mood } = Astro.props;
if (!mood) return Astro.redirect("/404");

const matches = palettes
  .filter((p) => p.moods.includes(mood.slug))
  .slice(0, 48);
const total = matches.length;

const title = `${mood.name} color palettes`;
const description = `${total} historical Japanese palettes tagged "${mood.slug}". ${mood.tagline}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: new URL(`/mood/${mood.slug}/`, Astro.site).toString(),
    numberOfItems: total,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: new URL("/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Browse",
        item: new URL("/browse/", Astro.site).toString(),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: `${mood.name} palettes`,
      },
    ],
  },
];

const otherMoods = moods.filter((m) => m.slug !== mood.slug);
---

<BaseLayout
  title={title}
  description={description}
  keywords={mood.keywords}
  jsonLd={jsonLd}
>
  <section class="mood section">
    <div class="container-prose mood__intro">
      <nav class="mood__breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">→</span>
        <a href="/browse/">Browse</a>
        <span aria-hidden="true">→</span>
        <span class="mood__breadcrumbs-current">{mood.name} palettes</span>
      </nav>

      <header class="mood__header">
        <p class="eyebrow">Mood tag</p>
        <h1 class="mood__title text-balance">{title}</h1>
        <p class="mood__lede">{mood.tagline}</p>
      </header>

      <div class="prose mood__desc">
        <p>{mood.description}</p>
      </div>
    </div>

    <div class="mood__grid-wrap container-wide">
      <p class="mood__count">
        {total === 0
          ? "No palettes tagged with this mood yet."
          : `Showing up to 48 of the palettes tagged ${mood.slug}:`}
      </p>

      <ul class="mood__grid" role="list">
        {matches.map((p) => (
          <li>
            <PaletteCard palette={p} />
          </li>
        ))}
      </ul>
    </div>

    <div class="mood__other container-prose">
      <p class="mood__other-heading">Other mood filters</p>
      <ul class="mood__chips" role="list">
        {otherMoods.map((m) => (
          <li>
            <a href={`/mood/${m.slug}/`} class="mood__chip">{m.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <BundleCta variant="medium" />
</BaseLayout>

<style>
  .mood {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  .mood__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-ink-500);
    margin-bottom: 1.5rem;
  }

  .mood__breadcrumbs a {
    color: var(--color-ink-500);
    text-decoration: none;
  }

  .mood__breadcrumbs a:hover {
    color: var(--color-accent-500);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .mood__breadcrumbs-current {
    color: var(--color-ink-900);
  }

  .mood__intro {
    margin-bottom: 2.5rem;
  }

  .mood__header {
    margin-bottom: 1.5rem;
  }

  .mood__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 2.5vw + 1rem, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0.5rem 0 0.75rem;
    color: var(--color-ink-900);
  }

  .mood__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 1vw + 0.75rem, 1.1875rem);
    line-height: 1.55;
    color: var(--color-ink-700);
    margin: 0 0 1.25rem;
  }

  .mood__desc p {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-700);
    max-width: 70ch;
  }

  .mood__grid-wrap {
    margin-top: 2.5rem;
  }

  .mood__count {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-ink-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1.25rem;
  }

  .mood__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .mood__other {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .mood__other-heading {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-ink-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
  }

  .mood__chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mood__chip {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    color: var(--color-ink-900);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    background-color: var(--color-bg-elevated, #fff);
    transition: border-color 150ms ease;
  }

  .mood__chip:hover {
    border-color: var(--color-accent-500);
    color: var(--color-accent-500);
  }
</style>
