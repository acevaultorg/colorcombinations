      function loose(raw){var qn=norm(raw);if(!qn||!idx)return[];var tk=qn.split(" ").filter(function(t){return t.length>2});if(!tk.length)return[];var o=[];for(var i=0;i<idx.length;i++){var e=idx[i],hay=norm(e.t+" "+(e.x||"")),w=hay.split(" "),sc=0;for(var k=0;k<tk.length;k++){if(hay.indexOf(tk[k])>=0){sc+=10;continue}for(var j=0;j<w.length;j++){if(w[j].length>3&&(w[j].indexOf(tk[k])===0||tk[k].indexOf(w[j])===0)){sc+=6;break}}}if(sc)o.push([sc,e])}o.sort(function(a,b){return b[0]-a[0]||a[1].t.length-b[1].t.length});return o.slice(0,6).map(function(x){return x[1]})}
      // ROUTE-BEFORE-SEARCH. Two query shapes are not text lookups at all and
      // returned nothing for 30 days: a pasted hex (41 searches) and a bare
      // plate number (18). Measured 2026-09-03, GA4 dims=searchTerm.
      // A hex is a "find me the nearest Wada colour" request — the capability
      // already existed at /tools/palette-from-color, the search box just never
      // pointed at it. Plate numbers are also indexed now (search-index.json.ts),
      // so this offers the tool as a first-class row rather than replacing them.
      // FALSE-POSITIVE GUARD: "facade", "decade", "efface", "deface" and
      // "accede" are all valid 6-char hex made only of a-f, and "facade" is
      // entirely plausible on a colour site. Every hex in the measured data
      // carries a digit (#71406B, #df6616, 00908a, F0CCAC, ff4d52); those words
