      function srch(raw){var found=strict(raw);if(found.length||!idx)return found;var combined=combinationQuery(raw);if(combined!==norm(raw)){found=strict(combined);if(found.length)return found}var core=intent(raw);return core&&core!==norm(raw)?strict(core):found}
      /* Loose fallback (2026-07-23): strict srch() requires EVERY token to match,
