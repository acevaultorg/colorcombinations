      function hexRow(h,i){return "<a role='option' id='cc-o"+i+"' href='/tools/palette-from-color/?hex="+h+"'><span>Find the closest Wada palettes to #"+h.toUpperCase()+"</span><span class='k'>Tool</span></a>"}
      /* Tier 3: TYPO RESCUE (2026-09-06, §E50). Measured over 30d of the site's own
         SearchNoResults log: 18 dead-end searches were single-character misses on
         colours the dictionary ALREADY HAS — "lavendar"→Grayish Lavender,
         "cinamon"→Cinnamon Buff, "Eugenua"→Eugenia Red, "Contiga"→Cotinga Purple,
         "rosalanc purppl"→Rosolanc Purple, "coquetre"→Coquette. Those are not
