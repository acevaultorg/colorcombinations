      var VOC=null;
      function vocab(){if(VOC)return VOC;var m={},i,k,w;for(i=0;i<idx.length;i++){w=norm(idx[i].t+" "+(idx[i].x||"")).split(" ");for(k=0;k<w.length;k++)if(w[k].length>3)m[w[k]]=(m[w[k]]||0)+1}VOC=m;return m}
      function ed(a,b,max){if(Math.abs(a.length-b.length)>max)return 99;var prev=[],cur=[],i,j,mn;for(j=0;j<=b.length;j++)prev[j]=j;for(i=1;i<=a.length;i++){cur[0]=i;mn=i;for(j=1;j<=b.length;j++){cur[j]=Math.min(prev[j]+1,cur[j-1]+1,prev[j-1]+(a.charAt(i-1)===b.charAt(j-1)?0:1));if(cur[j]<mn)mn=cur[j]}if(mn>max)return 99;prev=cur.slice()}return prev[b.length]}
      function fuzzy(raw){if(!idx)return[];var tk=norm(raw).split(" ").filter(function(t){return t.length>3});if(!tk.length)return[];var V=vocab(),out=[],k,w,d,max,best,bd;for(k=0;k<tk.length;k++){max=tk[k].length<=5?1:2;best=null;bd=99;for(w in V){d=ed(tk[k],w,max);if(d>0&&d<bd){bd=d;best=w}else if(d>0&&d===bd&&best&&V[w]>V[best])best=w}if(best)out.push(best)}return out.length?loose(out.join(" ")):[]}
      function render(raw){if(!raw.trim()){box.hidden=true;box.innerHTML="";q.setAttribute("aria-expanded","false");return}if(!idx){box.innerHTML="<div class='cc-none'>Searching…</div>";box.hidden=false;q.setAttribute("aria-expanded","true");load().then(function(){if(q.value===raw)render(raw)});return}var hx=hexOf(raw);if(hx){var ex=srch(hx);box.innerHTML=ex.map(function(e,i){return "<a role='option' id='cc-o"+i+"' href='"+e.s+"'><span>"+esc(e.t)+"</span><span class='k'>"+esc(e.k)+"</span></a>"}).join("")+hexRow(hx,ex.length);items=ex.concat([{s:"/tools/palette-from-color/?hex="+hx}]);exactMiss=false;box.hidden=false;q.setAttribute("aria-expanded","true");sel=-1;return}items=srch(raw);exactMiss=!items.length;if(items.length){box.innerHTML=items.map(function(e,i){return "<a role='option' id='cc-o"+i+"' href='"+e.s+"'><span>"+esc(e.t)+"</span><span class='k'>"+esc(e.k)+"</span></a>"}).join("")}else{var alt=loose(raw);if(alt.length){box.innerHTML="<div class='cc-none'>No exact match for “"+esc(raw)+"” — closest in the dictionary:</div>"+alt.map(function(e,i){return "<a role='option' id='cc-o"+i+"' href='"+e.s+"'><span>"+esc(e.t)+"</span><span class='k'>"+esc(e.k)+"</span></a>"}).join("");items=alt}else{var fz=fuzzy(raw);if(fz.length){box.innerHTML="<div class='cc-none'>No match for “"+esc(raw)+"” — did you mean:</div>"+fz.map(function(e,i){return "<a role='option' id='cc-o"+i+"' href='"+e.s+"'><span>"+esc(e.t)+"</span><span class='k'>"+esc(e.k)+"</span></a>"}).join("");items=fz}else{box.innerHTML="<div class='cc-none'>No match for “"+esc(raw)+"” yet. Try <a href='/browse/'>all 378 palettes</a> · <a href='/colors/'>every named color</a> · <a href='/learn/'>the research</a></div>"}}}box.hidden=false;q.setAttribute("aria-expanded","true");sel=-1}
      function sameSess(a,b){if(!a||!b)return false;var sh=a.length<b.length?a:b,i=0;while(i<sh.length&&a.charAt(i)===b.charAt(i))i++;return i>=sh.length*0.6}function log(){var raw=q.value.trim();if(!raw||raw===last||sameSess(raw,last))return;last=raw;var sq=scrub(raw);if(!sq)return;var z=exactMiss;if(window.clarity){window.clarity("event",z?"SearchNoResults":"Search");window.clarity("set",z?"search_noresult":"search_query",sq)}if(window.gtag)window.gtag("event",z?"SearchNoResults":"Search",{search_term:sq,results:items.length,fallback_shown:z&&items.length>0})}
