---
import "@/styles/global.css";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import FeedbackWidget from "@components/FeedbackWidget.astro";
import CookieConsent from "@components/CookieConsent.astro";

export interface Props {
  title: string;
  description: string;
  /** Optional canonical path override. Defaults to the current URL. */
  canonical?: string;
  /** Open Graph / Twitter image URL (defaults to site default) */
  image?: string;
  /** OG type — default "website", use "article" on palette pages */
  type?: "website" | "article";
  /** Optional JSON-LD structured data payload */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keywords array for meta keywords (optional — Google ignores, but useful for other engines) */
  keywords?: string[];
  /** Suppress indexing (used on 404) */
  noIndex?: boolean;
  /** Optional machine-readable JSON endpoint for this page (emits <link rel="alternate" type="application/json">). Used by LLM crawlers + third-party clients to traverse the data graph without scraping HTML. */
  jsonAlternate?: string;
  /** ISO 8601 publication date — used when type=article for OG/Pinterest rich pins. Defaults to site V1 publication. */
  publishedTime?: string;
  /** ISO 8601 last-modified date — used when type=article. Defaults to current build time. */
  modifiedTime?: string;
  /** Author name for OG article tag. */
  author?: string;
  /** Use `title` verbatim, without the " — {siteName}" suffix. For pages whose
   *  title already carries the brand (the homepage), where the suffix would
   *  repeat "Dictionary of Color Combinations" inside one <title>. */
  bareTitle?: boolean;
  /** Opt this page's <main> into Mediavine in-content ad insertion.
   *
   *  Why a prop and not a global selector: BaseLayout wraps EVERY page in
   *  `main.site-main`, including /privacy/, /terms/, /contact/ and 404 — and
   *  ads on policy pages violate the ad-network placement rules. So the class
   *  is opt-in: content pages pass adContent, policy pages simply don't.
   *
   *  Why a class and not a per-template selector list: the dashboard's
   *  `content_selector` was `article.coty`, a class emitted by exactly ONE
   *  source file (trends/color-trends-2026.astro). Measured 2026-09-05 on the
   *  served HTML: a live /palettes/ page contains 0 occurrences of `coty`, so
   *  in-content units rendered on 1 of ~1,470 sitemap URLs (0.07%). Every
   *  other section had a DIFFERENT wrapper (article.palette-body__prose,
   *  main.mx-auto…, section.color-profile) or none at all, so a hand-written
   *  selector list would have covered ~26% and gone stale on the next
   *  template. One stable class, stamped here, covers every section and every
   *  future template with no dashboard round-trip. */
  adContent?: boolean;
  /** Force the provider's full-page block marker even when the route is not in
   *  the central policy below. This is intentionally separate from adContent:
   *  removing `.mv-content` only stops in-content placements, while adhesion,
   *  interstitial, sidebar and video units may still load. */
  blockAllAds?: boolean;
  /** Page language for <html lang>. Defaults to "en"; the /de/ probe passes "de". */
  lang?: string;
  /** hreflang alternates, e.g. [{ hreflang: "de", href: "/de/farben-kombinieren/" }]. Paths are made absolute. */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description,
  canonical,
  image,
  type = "website",
  jsonLd,
  keywords,
  noIndex = false,
  jsonAlternate,
  publishedTime,
  modifiedTime,
  author = "The Dictionary of Color Combinations editorial",
  bareTitle = false,
  adContent = false,
  blockAllAds = false,
  lang = "en",
  alternates = [],
} = Astro.props;

// Default freshness anchors (matches detail-page JSON-LD).
const SITE_FIRST_PUBLISHED = "2026-04-10T00:00:00Z";
const articlePublished = publishedTime ?? SITE_FIRST_PUBLISHED;
// article:modified_time is OMITTED when a page has no known modification date,
// rather than defaulting to the build clock. The old fallback made 22 of the 27
// type="article" templates advertise "modified today" on every deploy — and it
// silently overrode deliberate decisions: books/[slug].astro withholds
// dateModified from its JSON-LD on the stated grounds that "stamping BUILD_DATE
// on 12 book pages that did not change is freshness inflation", while this line
// stamped exactly that into its OG tags. Absent metadata is honest; a clock is
// not. Pages with a real date pass modifiedTime explicitly.
const articleModified = modifiedTime ?? null;

const siteName = "The Dictionary of Color Combinations";
// `bareTitle` is for pages whose own title ALREADY contains the brand — the
// homepage leads with "Sanzo Wada's Dictionary of Color Combinations", and
// appending the site name there produced an 84-char title that said "Dictionary
// of Color Combinations" twice. Google truncates near 60, so the duplicate half
// was the visible half.
// Generalised 2026-08-29: the manual `bareTitle` flag above was only ever passed by
// index.astro, but the defect it describes is not unique to the homepage. The two
// Sanzo Wada book pages carried it too — "A Dictionary of Color Combinations — Sanzo
// Wada — The Dictionary of Color Combinations" (86 chars) and the Vol. 2 page (93) —
// saying the brand twice, with the duplicate half being the visible half at ~60.
// Those are the site's money pages for "a dictionary of color combinations" (pos 3.7,
// CTR 6.43% vs 13.33% site control) and "dictionary of color combinations" (pos 3.6,
// 5.63%). Detect the duplication instead of hand-flagging each page, so a future book
// or /learn/ page about the dictionary cannot reintroduce it silently.
// Blast radius measured before shipping, not assumed: across 22 sampled pages spanning
// /colors-that-go-with/, /palettes/, /colors/, /paintings/, /learn/ and /books/, exactly
// TWO titles contain the brand twice. Every other page has it once, as the suffix, and
// is unaffected.
const BRAND_CORE = "Dictionary of Color Combinations";
const fullTitle =
  bareTitle || title === siteName || title.includes(BRAND_CORE)
    ? title
    : `${title} — ${siteName}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).toString();

// Full-page Journey exclusions — generated in the signed-in Mediavine portal
// on 2026-09-10. The wrapper is deliberately sitewide, so withholding
// `mv-content` is NOT sufficient: non-in-content units can still render. Keep
// the concentrated Amazon-intent routes and non-content/legal surfaces free of
// every ad unit. Prefix checks are segment-safe (`/shopper` must not match
// `/shop`). `noIndex` closes future error/utility pages by default.
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const fullPageAdBlockExact = new Set([
  "/404",
  "/about",
  "/contact",
  "/copyright",
  "/privacy",
  "/random",
  "/terms",
  "/gift-guide",
  "/compare/wada-vol-1-vs-vol-2",
]);
const fullPageAdBlockPrefixes = ["/books", "/shop"];
const policyBlocksAllAds =
  fullPageAdBlockExact.has(normalizedPath) ||
  fullPageAdBlockPrefixes.some(
    (prefix) => normalizedPath === prefix || normalizedPath.startsWith(`${prefix}/`),
  );
const shouldBlockAllAds = blockAllAds || noIndex || policyBlocksAllAds;

// Default OG image must be a raster: every social surface (FB / X / LinkedIn /
// Slack / Discord / WhatsApp) and Pinterest refuse an SVG og:image and render a
// blank card. Rasterised from og-default.svg with @resvg/resvg-js.
const ogImage = image ?? "/og-default.png";
const imageUrl = new URL(ogImage, Astro.site).toString();

// Global Organization/WebSite schema — merged with page-specific entries.
// Both emitted on every page for consistent brand-entity signal (Aleyda
// Solis LLM-citation characteristic #3 Recognizable + Google Knowledge
// Graph eligibility).
const siteUrl = Astro.site?.toString() ?? "https://colorcombinations.org/";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: siteName,
  alternateName: "Dictionary of Color Combinations",
  url: siteUrl,
  parentOrganization: {
    "@type": "Organization",
    "@id": "https://caslonmedia.com/#organization",
    name: "Caslon Media",
    url: "https://caslonmedia.com/",
  },
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl.replace(/\/$/, "")}/favicon.svg`,
  },
  description:
    "Editorial archive of Sanzo Wada's 1933 Dictionary of Color Combinations — all 348 historical plates plus 30 modern editorial palettes. Free to browse, copy, embed, and export.",
  sameAs: [
    "https://github.com/acevaultorg/colorcombinations",
  ],
  knowsAbout: [
    "Color theory",
    "Japanese color tradition",
    "Sanzo Wada",
    "Shikisai",
    "Wabi-sabi",
    "Color palettes",
    "WCAG contrast",
    "Design systems",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    email: "hello@caslonmedia.com",
    contactType: "Editorial",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  name: siteName,
  url: siteUrl,
  description:
    "All 348 historical combinations from Sanzo Wada's 1933 Dictionary of Color Combinations, plus 30 editorial deep-dives into the Japanese shikisai tradition. Free to browse, copy, and export.",
  inLanguage: "en",
  publisher: { "@id": `${siteUrl}#organization` },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl.replace(/\/$/, "")}/browse/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const jsonLdArray = jsonLd
  ? [organizationSchema, websiteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : [organizationSchema, websiteSchema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    {/* Bing Webmaster verification. ACCOUNT-level token (the same value verifies every
        fleet property), so this is safe to ship site-wide. It is the prerequisite for
        Bing sitemap submission and the AI Performance report — and ChatGPT cites via the
        Bing index, so for this site it matters more than Google: colorcombinations ranks
        on Bing/DDG/Ecosia and is cited by ChatGPT while getting ~0 Google sessions. */}
    <meta name="msvalidate.01" content="E99F14F043F0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, Astro.site).toString()} />)}

    <!-- Icons & manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="en_US" />

    {type === "article" && (
      <>
        <meta property="article:published_time" content={articlePublished} />
        {articleModified && (
          <meta property="article:modified_time" content={articleModified} />
        )}
        <meta property="article:author" content={author} />
        <meta property="article:section" content="Color theory" />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Sitemap discovery -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="The Dictionary of Color Combinations" href="/feed.xml" />

    {jsonAlternate && (
      <link rel="alternate" type="application/json" title={`${title} — JSON data`} href={jsonAlternate} />
    )}

    <!-- Editorial fonts — EB Garamond for serif, Inter for UI.
         Loaded non-blocking (2026-09-04): a synchronous cross-origin <link rel="stylesheet">
         here is a render-blocking request that Lighthouse measured at ~1.3s wasted (mobile,
         throttled) — the CSSOM can't finish until this round-trip completes. The stylesheet
         only contains @font-face declarations (already using display=swap for the font
         FILES), so nothing else on the page depends on it loading synchronously. Preload +
         media=print/onload swap keeps the font request starting immediately (same priority
         as before) while letting the browser paint without waiting on it; <noscript> keeps
         the fonts working with JS disabled. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'; this.onload=null;"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>

    {jsonLdArray.map((entry) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(entry)}
      />
    ))}


    {/* FLEET-AGENT GATE — keeps our own verification traffic out of Clarity + GA4, so
        session/engagement numbers describe humans. Ported from readstacks 2026-08-11.

        Visit any page once with ?__fa=1 from an agent-driven browser; persists in
        localStorage. Undo: localStorage.removeItem('__fleet_agent').
        Covers Chrome MCP too (real Chrome UA, webdriver false — invisible to any UA
        test, and it is the fleet's default verification browser). Also excludes the
        operator's own self-visits.

        SELF-DECLARATION, NOT UA-SNIFFING — deliberately. A UA-matching version was
        written and reverted on readstacks: matching a vendor client string drops real
        humans who browse in that client, silently and uncountably. Do not reintroduce.

        ⚠️ The GA4 id is HARDCODED here on purpose. readstacks emits its kill-switch
        only when an env var is set, which is safe there because GA4 also only loads
        under that var. This site hardcodes both ids (line below), so an env-conditioned
        copy would emit NO ga-disable while GA4 still loaded — a gate that reports
        success and suppresses nothing. Keep this in sync with the loader's own ids.

        Ordering: the async gtag.js below dispatches no hit by itself; the first hit is
        the inline gtag('config'), which runs after this. ga-disable is read per-hit. */}
    <script is:inline set:html={`(function(){var a=false;try{if(location.search.indexOf("__fa=1")>-1){localStorage.setItem("__fleet_agent","1");}a=localStorage.getItem("__fleet_agent")==="1";}catch(e){}if(navigator.webdriver===true||(navigator.userAgent||"").indexOf("HeadlessChrome")>-1){a=true;}if(a){window.__FLEET_AGENT__=1;document.documentElement.setAttribute("data-google-analytics-opt-out","");window["ga-disable-G-QT7PC59PV6"]=true;}})();`} />

    {/* Crawler-shaped viewport gate — GA4 only. Evidence-derived 2026-09-05, NOT a heuristic.
        Pooled 5 fleet sites (GA4 screenResolution x country, 30d, truncated:false):

          1366x1366   15,268 sessions   1.2% premium-country   (square = physically impossible)
          1280x1200    8,603 sessions   0.2% premium
          393x851        406 sessions   0.0% premium
          -- every REAL profile for comparison --
          1920x1080    2,707 sessions  55.7% premium
          402x874        964 sessions  86.0% premium
          800x600        260 sessions  70.0% premium   <-- looks synthetic, is NOT. Do not add.

        On this site the set is 1,349 sessions (19.3%) of which SEVEN are premium-country,
        so the false-positive cost is ~0.5% of premium traffic. Excluding it moves the
        premium-country share 29.4% -> 36.3%, which is what Mediavine reviews.

        DO NOT "tidy" 393x851: it is ONE PIXEL from the real Android profile 393x852,
        which is 1,015 sessions at 71.5% premium. A typo here suppresses real humans.

        Clarity is deliberately NOT gated on this flag — it keeps recording these sessions
        so the gate stays auditable and we can prove it is firing on the right traffic.

        Same hardcoded-id discipline as the gate above, and for the same reason. */}
    <script is:inline set:html={`(function(){try{var CS={"1280x1200":1,"1366x1366":1,"1600x1600":1,"393x851":1};var k=(screen.width||0)+"x"+(screen.height||0);if(CS[k]===1){window.__CRAWLER_SHAPED__=1;window["ga-disable-G-QT7PC59PV6"]=true;document.documentElement.setAttribute("data-crawler-shaped","");}}catch(e){}})();`} />

    {/* Microsoft Clarity — heatmaps + session recordings (project wpwnyowok1).
        Guarded by the gate above: Clarity has no documented runtime opt-out (GA4 has
        ga-disable-<ID>), so the only way to stop it recording an agent session is to
        never inject the tag. */}
    <script is:inline set:html={`if(!window.__FLEET_AGENT__){(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","wpwnyowok1");}`} />

    {/* Google Analytics 4 — measurement ID G-QT7PC59PV6 (stacked with Clarity). */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QT7PC59PV6"></script>
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-QT7PC59PV6',{anonymize_ip:true});`} />

    <slot name="head" />

    {/* Amazon affiliate-click measurement (Clarity amazon_click + GA4 + first-party /c beacon).
        defer attribute added 2026-09-04 (LCP fix mtncwponxsc3i5): this external script tag had
        no async or defer attribute, so it blocked the HTML parser on a network round-trip before
        this site's Mediavine tag. The file only attaches document-level click/auxclick listeners
        — no dependency on running before DOMContentLoaded, no user can click within that window
        — so deferring it costs nothing functionally and removes it from the critical path. */}
    <script is:inline defer src="/amazon-track.js"></script>
    {/* Mediavine Journey ad script — site 0e3765cf-7571-4481-9b28-bc96fd84b4e4.
        Approved for Journey 2026-09-04.

        is:inline is REQUIRED. Without it Astro bundles/rewrites the tag and drops the
        data-noptimize / data-cfasync attributes the Mediavine wrapper relies on.

        Placed last in <head> per Mediavine's own onboarding text: "just before the
        closing </head> tag (recommended)".

        DELIBERATELY NOT added to src/pages/embed/*.astro — those layouts render the
        embeddable widgets that run inside OTHER people's sites. The Master Publisher
        Agreement grants exclusivity over Ads on "the Property"; serving Mediavine ads
        from a third-party page is out of scope and a policy risk.

        ⚠️ The site id is 0e3765cf (zero-E). A 0c… variant returns HTTP 200 with a
        ZERO-BYTE body, so a status-code check cannot tell the two apart — verify by
        response SIZE (~171KB) if this ever needs re-checking. */}
    <script is:inline type="text/javascript" async="async" data-noptimize="1" data-cfasync="false" src="//scripts.scriptwrapper.com/tags/0e3765cf-7571-4481-9b28-bc96fd84b4e4.js"></script>

  </head>
  <body>
    {/* Official provider-generated full-page exclusion. It must be present in
        rendered HTML; selecting toggles in the portal alone changes nothing. */}
    {shouldBlockAllAds && (
      <div id="ad-management-config-settings" data-blocklist-all="1"></div>
    )}
    {/* Event tracking — connects data-event attributes to the analytics sinks.
        DUAL-SINK (fixed 2026-07-23): previously fired to Plausible ONLY, which had
        been a dead sink since the subscription lapsed 2026-06-28 — every custom
        event on the site (shares, exports, hex copies, CTA clicks) was invisible.
        Now fires GA4 (what the fleet metrics layer reads) + Clarity (filterable
        tag) as well. Plausible was removed 2026-07-30 (subscription lapsed 2026-06-28).

        type="module" (2026-09-04, LCP fix mtncwponxsc3i5): a delegated click listener has no
        reason to execute during the parse/paint critical path — module scripts are deferred by
        spec (parsed but not executed until after HTML parsing), which pulls this off the main
        thread during first paint without changing behavior (still attached well before any real
        user can click). All names referenced here are locals inside the IIFE; nothing else on
        the page reads them, so strict-mode module scoping changes nothing observable. */}
    <script is:inline type="module">
    (function(){
      document.addEventListener('click', function(e) {
        var el = e.target.closest('[data-event]');
        if (!el) return;
        var name = el.getAttribute('data-event');
        if (!name) return;
        var props = {};
        if (el.dataset.format) props.format = el.dataset.format;
        if (el.dataset.book) props.book = el.dataset.book;
        if (el.dataset.tool) props.tool = el.dataset.tool;
        if (el.dataset.variant) props.variant = el.dataset.variant;
        if (el.href) props.url = el.href;
        // amazon_click is already dual-sunk by /amazon-track.js — don't double-count.
        if (name !== 'amazon_click') {
          try {
            if (window.gtag) window.gtag('event', name, Object.assign({page: location.pathname}, props));
            if (window.clarity) { window.clarity('event', name); window.clarity('set', 'last_event', name); }
          } catch (x) {}
        }
      });
    })();
    </script>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <div class="cc-search">
      <input id="cc-q" type="search" role="combobox" aria-expanded="false" aria-controls="cc-results" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Search palettes, colors, collections…" aria-label="Search the dictionary of color combinations" />
      <div id="cc-results" role="listbox" aria-label="Search results" hidden></div>
    </div>
    <main id="main" class={adContent ? "site-main mv-content" : "site-main"}>
      <slot />
    </main>
    <FeedbackWidget />
    <SiteFooter />
    <CookieConsent />

    <style>
      .skip-link {
        position: absolute;
        left: -10000px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .skip-link:focus {
        position: static;
        width: auto;
        height: auto;
        overflow: visible;
        background: var(--color-ink-900);
        color: var(--color-paper-50);
        padding: 0.75rem 1rem;
        border-radius: var(--radius-md);
        margin: 0.5rem;
        display: inline-block;
      }

      .site-main {
        min-height: calc(100dvh - 200px);
      }
    </style>

    <!-- Fleet Search Standard v1.0 — instant search + monitored zero-result signal -->
    <style is:global>
      .cc-search{position:relative;max-width:560px;margin:0 auto;padding:.75rem 1rem 0}
      .cc-search input{width:100%;padding:.7rem 1rem;font-size:1rem;border:1px solid var(--color-ink-200,#d8d2c4);border-radius:var(--radius-md,8px);background:var(--color-paper-50,#fff);color:var(--color-ink-900,#1a1714);-webkit-appearance:none}
      .cc-search input:focus{outline:2px solid var(--color-accent,#b8860b);outline-offset:1px}
      #cc-results{position:absolute;left:1rem;right:1rem;top:100%;z-index:60;background:var(--color-paper-50,#fff);border:1px solid var(--color-ink-200,#d8d2c4);border-radius:var(--radius-md,8px);box-shadow:0 8px 28px rgba(0,0,0,.12);max-height:60vh;overflow-y:auto}
      #cc-results a{display:flex;justify-content:space-between;gap:10px;padding:.6rem 1rem;text-decoration:none;color:var(--color-ink-900,#1a1714);border-bottom:1px solid var(--color-ink-100,#eee)}
      #cc-results a:last-child{border-bottom:0}
      #cc-results a[aria-selected=true],#cc-results a:hover{background:var(--color-paper-100,#f7f4ee)}
      #cc-results .k{font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;color:var(--color-ink-500,#8a8378);align-self:center;white-space:nowrap}
