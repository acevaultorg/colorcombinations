---
import "@/styles/global.css";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import FeedbackWidget from "@components/FeedbackWidget.astro";
import CookieConsent from "@components/CookieConsent.astro";

export interface Props {
  title: string;
  description: string;
  /** Optional canonical path override. Defaults to the current URL. */
  canonical?: string;
  /** Open Graph / Twitter image URL (defaults to site default) */
  image?: string;
  /** OG type — default "website", use "article" on palette pages */
  type?: "website" | "article";
  /** Optional JSON-LD structured data payload */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keywords array for meta keywords (optional — Google ignores, but useful for other engines) */
  keywords?: string[];
  /** Suppress indexing (used on 404) */
  noIndex?: boolean;
  /** Optional machine-readable JSON endpoint for this page (emits <link rel="alternate" type="application/json">). Used by LLM crawlers + third-party clients to traverse the data graph without scraping HTML. */
  jsonAlternate?: string;
  /** ISO 8601 publication date — used when type=article for OG/Pinterest rich pins. Defaults to site V1 publication. */
  publishedTime?: string;
  /** ISO 8601 last-modified date — used when type=article. Defaults to current build time. */
  modifiedTime?: string;
  /** Author name for OG article tag. */
  author?: string;
  /** Use `title` verbatim, without the " — {siteName}" suffix. For pages whose
   *  title already carries the brand (the homepage), where the suffix would
   *  repeat "Dictionary of Color Combinations" inside one <title>. */
  bareTitle?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type = "website",
  jsonLd,
  keywords,
  noIndex = false,
  jsonAlternate,
  publishedTime,
  modifiedTime,
  author = "The Dictionary of Color Combinations editorial",
  bareTitle = false,
} = Astro.props;

// Default freshness anchors (matches detail-page JSON-LD).
const SITE_FIRST_PUBLISHED = "2026-04-10T00:00:00Z";
const articlePublished = publishedTime ?? SITE_FIRST_PUBLISHED;
const articleModified = modifiedTime ?? new Date().toISOString();

const siteName = "The Dictionary of Color Combinations";
// `bareTitle` is for pages whose own title ALREADY contains the brand — the
// homepage leads with "Sanzo Wada's Dictionary of Color Combinations", and
// appending the site name there produced an 84-char title that said "Dictionary
// of Color Combinations" twice. Google truncates near 60, so the duplicate half
// was the visible half.
// Generalised 2026-08-29: the manual `bareTitle` flag above was only ever passed by
// index.astro, but the defect it describes is not unique to the homepage. The two
// Sanzo Wada book pages carried it too — "A Dictionary of Color Combinations — Sanzo
// Wada — The Dictionary of Color Combinations" (86 chars) and the Vol. 2 page (93) —
// saying the brand twice, with the duplicate half being the visible half at ~60.
// Those are the site's money pages for "a dictionary of color combinations" (pos 3.7,
// CTR 6.43% vs 13.33% site control) and "dictionary of color combinations" (pos 3.6,
// 5.63%). Detect the duplication instead of hand-flagging each page, so a future book
// or /learn/ page about the dictionary cannot reintroduce it silently.
// Blast radius measured before shipping, not assumed: across 22 sampled pages spanning
// /colors-that-go-with/, /palettes/, /colors/, /paintings/, /learn/ and /books/, exactly
// TWO titles contain the brand twice. Every other page has it once, as the suffix, and
// is unaffected.
const BRAND_CORE = "Dictionary of Color Combinations";
const fullTitle =
  bareTitle || title === siteName || title.includes(BRAND_CORE)
    ? title
    : `${title} — ${siteName}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).toString();

// Default OG image must be a raster: every social surface (FB / X / LinkedIn /
// Slack / Discord / WhatsApp) and Pinterest refuse an SVG og:image and render a
// blank card. Rasterised from og-default.svg with @resvg/resvg-js.
const ogImage = image ?? "/og-default.png";
const imageUrl = new URL(ogImage, Astro.site).toString();

// Global Organization/WebSite schema — merged with page-specific entries.
// Both emitted on every page for consistent brand-entity signal (Aleyda
// Solis LLM-citation characteristic #3 Recognizable + Google Knowledge
// Graph eligibility).
const siteUrl = Astro.site?.toString() ?? "https://colorcombinations.org/";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: siteName,
  alternateName: "Dictionary of Color Combinations",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl.replace(/\/$/, "")}/favicon.svg`,
  },
  description:
    "Editorial archive of Sanzo Wada's 1933 Dictionary of Color Combinations — all 348 historical plates plus 30 modern editorial palettes. Free to browse, copy, embed, and export.",
  sameAs: [
    "https://github.com/acevaultorg/colorcombinations",
  ],
  knowsAbout: [
    "Color theory",
    "Japanese color tradition",
    "Sanzo Wada",
    "Shikisai",
    "Wabi-sabi",
    "Color palettes",
    "WCAG contrast",
    "Design systems",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    email: "contact@colorcombinations.org",
    contactType: "Editorial",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  name: siteName,
  url: siteUrl,
  description:
    "All 348 historical combinations from Sanzo Wada's 1933 Dictionary of Color Combinations, plus 30 editorial deep-dives into the Japanese shikisai tradition. Free to browse, copy, and export.",
  inLanguage: "en",
  publisher: { "@id": `${siteUrl}#organization` },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl.replace(/\/$/, "")}/browse/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const jsonLdArray = jsonLd
  ? [organizationSchema, websiteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : [organizationSchema, websiteSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    {/* Bing Webmaster verification. ACCOUNT-level token (the same value verifies every
        fleet property), so this is safe to ship site-wide. It is the prerequisite for
        Bing sitemap submission and the AI Performance report — and ChatGPT cites via the
        Bing index, so for this site it matters more than Google: colorcombinations ranks
        on Bing/DDG/Ecosia and is cited by ChatGPT while getting ~0 Google sessions. */}
    <meta name="msvalidate.01" content="E99F14F043F0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />

    <!-- Icons & manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="en_US" />

    {type === "article" && (
      <>
        <meta property="article:published_time" content={articlePublished} />
        <meta property="article:modified_time" content={articleModified} />
        <meta property="article:author" content={author} />
        <meta property="article:section" content="Color theory" />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Sitemap discovery -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="The Dictionary of Color Combinations" href="/feed.xml" />

    {jsonAlternate && (
      <link rel="alternate" type="application/json" title={`${title} — JSON data`} href={jsonAlternate} />
    )}

    <!-- Editorial fonts — EB Garamond for serif, Inter for UI -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap"
    />

    {jsonLdArray.map((entry) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(entry)}
      />
    ))}


    {/* FLEET-AGENT GATE — keeps our own verification traffic out of Clarity + GA4, so
        session/engagement numbers describe humans. Ported from readstacks 2026-08-11.

        Visit any page once with ?__fa=1 from an agent-driven browser; persists in
        localStorage. Undo: localStorage.removeItem('__fleet_agent').
        Covers Chrome MCP too (real Chrome UA, webdriver false — invisible to any UA
        test, and it is the fleet's default verification browser). Also excludes the
        operator's own self-visits.

        SELF-DECLARATION, NOT UA-SNIFFING — deliberately. A UA-matching version was
        written and reverted on readstacks: matching a vendor client string drops real
        humans who browse in that client, silently and uncountably. Do not reintroduce.

        ⚠️ The GA4 id is HARDCODED here on purpose. readstacks emits its kill-switch
        only when an env var is set, which is safe there because GA4 also only loads
        under that var. This site hardcodes both ids (line below), so an env-conditioned
        copy would emit NO ga-disable while GA4 still loaded — a gate that reports
        success and suppresses nothing. Keep this in sync with the loader's own ids.

        Ordering: the async gtag.js below dispatches no hit by itself; the first hit is
        the inline gtag('config'), which runs after this. ga-disable is read per-hit. */}
    <script is:inline set:html={`(function(){var a=false;try{if(location.search.indexOf("__fa=1")>-1){localStorage.setItem("__fleet_agent","1");}a=localStorage.getItem("__fleet_agent")==="1";}catch(e){}if(navigator.webdriver===true||(navigator.userAgent||"").indexOf("HeadlessChrome")>-1){a=true;}if(a){window.__FLEET_AGENT__=1;document.documentElement.setAttribute("data-google-analytics-opt-out","");window["ga-disable-G-QT7PC59PV6"]=true;}})();`} />

    {/* Microsoft Clarity — heatmaps + session recordings (project wpwnyowok1).
        Guarded by the gate above: Clarity has no documented runtime opt-out (GA4 has
        ga-disable-<ID>), so the only way to stop it recording an agent session is to
        never inject the tag. */}
    <script is:inline set:html={`if(!window.__FLEET_AGENT__){(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","wpwnyowok1");}`} />

    {/* Google Analytics 4 — measurement ID G-QT7PC59PV6 (stacked with Clarity). */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QT7PC59PV6"></script>
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-QT7PC59PV6',{anonymize_ip:true});`} />

    <slot name="head" />

    {/* Amazon affiliate-click measurement (Clarity amazon_click + GA4 + first-party /c beacon) */}
    <script is:inline src="/amazon-track.js"></script>
  </head>
  <body>
    {/* Event tracking — connects data-event attributes to the analytics sinks.
        DUAL-SINK (fixed 2026-07-23): previously fired to Plausible ONLY, which had
        been a dead sink since the subscription lapsed 2026-06-28 — every custom
        event on the site (shares, exports, hex copies, CTA clicks) was invisible.
        Now fires GA4 (what the fleet metrics layer reads) + Clarity (filterable
        tag) as well. Plausible was removed 2026-07-30 (subscription lapsed 2026-06-28). */}
    <script is:inline>
    (function(){
      document.addEventListener('click', function(e) {
        var el = e.target.closest('[data-event]');
        if (!el) return;
        var name = el.getAttribute('data-event');
        if (!name) return;
        var props = {};
        if (el.dataset.format) props.format = el.dataset.format;
        if (el.dataset.book) props.book = el.dataset.book;
        if (el.dataset.tool) props.tool = el.dataset.tool;
        if (el.dataset.variant) props.variant = el.dataset.variant;
        if (el.href) props.url = el.href;
        // amazon_click is already dual-sunk by /amazon-track.js — don't double-count.
        if (name !== 'amazon_click') {
          try {
            if (window.gtag) window.gtag('event', name, Object.assign({page: location.pathname}, props));
            if (window.clarity) { window.clarity('event', name); window.clarity('set', 'last_event', name); }
          } catch (x) {}
        }
      });
    })();
    </script>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <div class="cc-search">
      <input id="cc-q" type="search" role="combobox" aria-expanded="false" aria-controls="cc-results" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Search palettes, colors, collections…" aria-label="Search the dictionary of color combinations" />
      <div id="cc-results" role="listbox" aria-label="Search results" hidden></div>
    </div>
    <main id="main" class="site-main">
      <slot />
    </main>
    <FeedbackWidget />
    <SiteFooter />
    <CookieConsent />

    <style>
      .skip-link {
        position: absolute;
        left: -10000px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .skip-link:focus {
        position: static;
        width: auto;
        height: auto;
        overflow: visible;
        background: var(--color-ink-900);
        color: var(--color-paper-50);
        padding: 0.75rem 1rem;
        border-radius: var(--radius-md);
        margin: 0.5rem;
        display: inline-block;
      }

      .site-main {
        min-height: calc(100dvh - 200px);
      }
    </style>

    <!-- Fleet Search Standard v1.0 — instant search + monitored zero-result signal -->
    <style is:global>
      .cc-search{position:relative;max-width:560px;margin:0 auto;padding:.75rem 1rem 0}
      .cc-search input{width:100%;padding:.7rem 1rem;font-size:1rem;border:1px solid var(--color-ink-200,#d8d2c4);border-radius:var(--radius-md,8px);background:var(--color-paper-50,#fff);color:var(--color-ink-900,#1a1714);-webkit-appearance:none}
      .cc-search input:focus{outline:2px solid var(--color-accent,#b8860b);outline-offset:1px}
      #cc-results{position:absolute;left:1rem;right:1rem;top:100%;z-index:60;background:var(--color-paper-50,#fff);border:1px solid var(--color-ink-200,#d8d2c4);border-radius:var(--radius-md,8px);box-shadow:0 8px 28px rgba(0,0,0,.12);max-height:60vh;overflow-y:auto}
      #cc-results a{display:flex;justify-content:space-between;gap:10px;padding:.6rem 1rem;text-decoration:none;color:var(--color-ink-900,#1a1714);border-bottom:1px solid var(--color-ink-100,#eee)}
      #cc-results a:last-child{border-bottom:0}
      #cc-results a[aria-selected=true],#cc-results a:hover{background:var(--color-paper-100,#f7f4ee)}
      #cc-results .k{font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;color:var(--color-ink-500,#8a8378);align-self:center;white-space:nowrap}
      .cc-none{padding:.75rem 1rem;color:var(--color-ink-500,#8a8378);font-size:.9rem}
      .cc-none a{color:var(--color-accent,#b8860b)}
    </style>

    <script is:inline>
      (function(){
      var q=document.getElementById("cc-q"),box=document.getElementById("cc-results");if(!q||!box)return;
      var idx=null,idxP=null,items=[],sel=-1,last="",lt,rt,exactMiss=false;
      function load(){if(idxP)return idxP;idxP=fetch("/search-index.json").then(function(r){return r.json()}).then(function(j){idx=j;return j}).catch(function(){idx=[];return[]});return idxP}
      function norm(s){return (s||"").toLowerCase().replace(/[^a-z0-9 ]+/g," ").replace(/\s+/g," ").trim()}
      function esc(s){return (s||"").replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
      function scrub(s){return s.replace(/\S+@\S+/g,"").replace(/\d{6,}/g,"").slice(0,60).trim()}
      function srch(raw){var qn=norm(raw);if(!qn||!idx)return[];var tk=qn.split(" "),o=[];for(var i=0;i<idx.length;i++){var e=idx[i],tn=norm(e.t),hay=norm(e.t+" "+(e.x||"")),sc=0;if(tn.indexOf(qn)===0)sc=100;else if(tn.indexOf(qn)>=0)sc=70;else if(hay.indexOf(qn)>=0)sc=40;else{var all=1;for(var k=0;k<tk.length;k++)if(hay.indexOf(tk[k])<0){all=0;break}if(all)sc=20}if(sc)o.push([sc,e])}o.sort(function(a,b){return b[0]-a[0]||a[1].t.length-b[1].t.length});return o.slice(0,8).map(function(x){return x[1]})}
      /* Loose fallback (2026-07-23): strict srch() requires EVERY token to match,
         so "sunset orange" returned nothing even though orange palettes exist —
         a dead end is a conversion leak. Score by ANY token hit (whole-word or
         prefix) so a near-miss query still lands on real, relevant entries. */
      function loose(raw){var qn=norm(raw);if(!qn||!idx)return[];var tk=qn.split(" ").filter(function(t){return t.length>2});if(!tk.length)return[];var o=[];for(var i=0;i<idx.length;i++){var e=idx[i],hay=norm(e.t+" "+(e.x||"")),w=hay.split(" "),sc=0;for(var k=0;k<tk.length;k++){if(hay.indexOf(tk[k])>=0){sc+=10;continue}for(var j=0;j<w.length;j++){if(w[j].length>3&&(w[j].indexOf(tk[k])===0||tk[k].indexOf(w[j])===0)){sc+=6;break}}}if(sc)o.push([sc,e])}o.sort(function(a,b){return b[0]-a[0]||a[1].t.length-b[1].t.length});return o.slice(0,6).map(function(x){return x[1]})}
      function render(raw){if(!raw.trim()){box.hidden=true;box.innerHTML="";q.setAttribute("aria-expanded","false");return}if(!idx){box.innerHTML="<div class='cc-none'>Searching…</div>";box.hidden=false;q.setAttribute("aria-expanded","true");load().then(function(){if(q.value===raw)render(raw)});return}items=srch(raw);exactMiss=!items.length;if(items.length){box.innerHTML=items.map(function(e,i){return "<a role='option' id='cc-o"+i+"' href='"+e.s+"'><span>"+esc(e.t)+"</span><span class='k'>"+esc(e.k)+"</span></a>"}).join("")}else{var alt=loose(raw);if(alt.length){box.innerHTML="<div class='cc-none'>No exact match for “"+esc(raw)+"” — closest in the dictionary:</div>"+alt.map(function(e,i){return "<a role='option' id='cc-o"+i+"' href='"+e.s+"'><span>"+esc(e.t)+"</span><span class='k'>"+esc(e.k)+"</span></a>"}).join("");items=alt}else{box.innerHTML="<div class='cc-none'>No match for “"+esc(raw)+"” yet. Try <a href='/browse/'>all 378 palettes</a> · <a href='/colors/'>every named color</a> · <a href='/learn/'>the research</a></div>"}}box.hidden=false;q.setAttribute("aria-expanded","true");sel=-1}
      function log(){var raw=q.value.trim();if(!raw||raw===last)return;last=raw;var sq=scrub(raw);if(!sq)return;var z=exactMiss;if(window.clarity){window.clarity("event",z?"SearchNoResults":"Search");window.clarity("set",z?"search_noresult":"search_query",sq)}if(window.gtag)window.gtag("event",z?"SearchNoResults":"Search",{search_term:sq,results:items.length,fallback_shown:z&&items.length>0})}
      q.addEventListener("focus",load);
      q.addEventListener("input",function(){clearTimeout(rt);rt=setTimeout(function(){load().then(function(){render(q.value)})},110);clearTimeout(lt);lt=setTimeout(log,900)});
      q.addEventListener("keydown",function(e){if(e.key==="Escape"){box.hidden=true;q.blur();return}if(e.key==="Enter"){clearTimeout(rt);render(q.value);clearTimeout(lt);log();var t=sel>=0&&items[sel]?items[sel]:items[0];if(t)location.href=t.s;return}if(e.key==="ArrowDown"||e.key==="ArrowUp"){e.preventDefault();if(!items.length)return;sel=(sel+(e.key==="ArrowDown"?1:-1)+items.length)%items.length;for(var i=0;i<items.length;i++){var o=document.getElementById("cc-o"+i);if(o)o.setAttribute("aria-selected",i===sel?"true":"false")}q.setAttribute("aria-activedescendant",sel>=0?"cc-o"+sel:"")}});
      document.addEventListener("keydown",function(e){if(e.key==="/"&&document.activeElement!==q){var tn=(document.activeElement||{}).tagName||"";if(!/INPUT|TEXTAREA|SELECT/.test(tn)){e.preventDefault();q.focus()}}});
      document.addEventListener("click",function(e){if(!e.target.closest||!e.target.closest(".cc-search"))box.hidden=true});
      })();
    </script>
  </body>
</html>
