      function strict(raw){var qn=norm(raw);if(!qn||!idx)return[];var tk=qn.split(" "),o=[];for(var i=0;i<idx.length;i++){var e=idx[i],tn=norm(e.t),hay=norm(e.t+" "+(e.x||"")),sc=0;if(tn.indexOf(qn)===0)sc=100;else if(tn.indexOf(qn)>=0)sc=70;else if(hay.indexOf(qn)>=0)sc=40;else{var all=1;for(var k=0;k<tk.length;k++)if(hay.indexOf(tk[k])<0){all=0;break}if(all)sc=20}if(sc)o.push([sc,e])}o.sort(function(a,b){return b[0]-a[0]||a[1].t.length-b[1].t.length});return o.slice(0,8).map(function(x){return x[1]})}
      // Retry misses using colour-name spelling only: "lightbrown" is the
      // adjacent words "Light Brown" in an actual Color entry, not a guessed
      // colour. Preserve every successful query's ordering and require ALL
      // remaining words. Separate colours existing does not prove a palette
      // contains their combination; genuine misses keep the partial-match UI.
      var JOINED=null;
      function combinationQuery(raw){
        if(!JOINED){JOINED={};(idx||[]).forEach(function(e){if(e.k!=="Color")return;var w=norm(e.t).split(" ");for(var i=0;i<w.length-1;i++){var key=w[i]+w[i+1],value=w[i]+" "+w[i+1];if(!(key in JOINED))JOINED[key]=value;else if(JOINED[key]!==value)JOINED[key]=key}})}
        var words=norm(raw).split(" ").filter(function(w){return w!=="and"}).map(function(w){return JOINED[w]||w});
        return words.length>1?words.join(" "):norm(raw);
      }
      // Intent wrapper (2026-09-28, GA4 SearchNoResults): readers type the question,
      // not the colour — "Colors that go with old rose", "Clay color", "Red coruleur
