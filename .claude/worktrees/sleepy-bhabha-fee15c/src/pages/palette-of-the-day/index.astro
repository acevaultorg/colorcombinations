---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getRecentPalettes, formatLongDate } from "@data/palette-of-the-day";

const entries = getRecentPalettes(14);
const today = entries[0];

const title = `Palette of the Day — ${today.longDate}`;
const description = `Today's historical color combination: ${today.palette.title} (${today.palette.era} era). A new palette every day from the 378-plate Sanzo Wada archive — plus the last two weeks of daily picks.`;

const keywords = [
  "palette of the day",
  "color palette of the day",
  "daily color palette",
  "daily color combination",
  "Sanzo Wada palette",
  "color inspiration daily",
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: `Palette of the Day — ${today.palette.title}`,
    description: today.palette.summary,
    datePublished: today.isoDate,
    url: `${Astro.site}palette-of-the-day/`,
    isPartOf: {
      "@type": "WebSite",
      name: "The Dictionary of Color Combinations",
      url: Astro.site?.toString() ?? "https://colorcombinations.org",
    },
    about: {
      "@type": "Thing",
      name: today.palette.title,
      url: `${Astro.site}palettes/${today.palette.slug}/`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${Astro.site}` },
      { "@type": "ListItem", position: 2, name: "Palette of the Day", item: `${Astro.site}palette-of-the-day/` },
    ],
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} jsonLd={jsonLd}>
  <section class="archive-hero section">
    <div class="container-wide">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Palette of the day</span>
      </nav>

      <p class="eyebrow">Palette of the day — {today.longDate}</p>
      <h1 class="display-hero text-balance">
        Today: <em>{today.palette.title}</em>
        {today.palette.titleJa && <span class="title-ja">— {today.palette.titleJa}</span>}
      </h1>
      <p class="archive-hero__lede">{today.palette.summary}</p>

      <a href={`/palettes/${today.palette.slug}/`} class="archive-hero__card" aria-label={`Open the ${today.palette.title} palette detail page`}>
        <div class="archive-hero__swatches" role="img" aria-label={`${today.palette.colors.length} color palette`}>
          {today.palette.colors.map((c) => (
            <span class="archive-hero__swatch" style={`background-color: ${c.hex}`}>
              <span class="archive-hero__swatch-label">
                {c.nameRomaji && <span class="archive-hero__swatch-name">{c.nameRomaji}</span>}
                <span class="archive-hero__swatch-hex">{c.hex.toUpperCase()}</span>
              </span>
            </span>
          ))}
        </div>
        <span class="archive-hero__open">Open palette detail →</span>
      </a>
    </div>
  </section>

  <section class="archive-list section">
    <div class="container-wide">
      <header class="section-head">
        <p class="eyebrow">Archive</p>
        <h2 class="text-balance">The last two weeks.</h2>
        <p class="section-lede">
          Every day a different historical combination from the 378-plate archive. Deterministic, not random — the same date always surfaces the same palette so you can link to it and come back.
        </p>
      </header>

      <ol class="archive-grid" role="list">
        {entries.slice(1).map((entry) => (
          <li class="archive-item">
            <a href={`/palettes/${entry.palette.slug}/`} class="archive-item__link" aria-label={`${entry.longDate}: ${entry.palette.title}`}>
              <div class="archive-item__swatches" aria-hidden="true">
                {entry.palette.colors.map((c) => (
                  <span class="archive-item__swatch" style={`background-color: ${c.hex}`} />
                ))}
              </div>
              <div class="archive-item__body">
                <p class="archive-item__date">{entry.longDate}</p>
                <p class="archive-item__title">
                  {entry.palette.title}
                  {entry.palette.titleJa && <span class="archive-item__title-ja"> — {entry.palette.titleJa}</span>}
                </p>
                <p class="archive-item__summary">{entry.palette.summary}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <div class="archive-list__footer">
        <a href="/browse" class="btn btn-secondary">Browse all 378 combinations →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .archive-hero {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  .breadcrumb {
    font-size: 0.875rem;
    color: var(--color-ink-500);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: var(--color-ink-500);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-500);
    border-bottom-color: currentColor;
  }

  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .archive-hero h1 {
    margin-top: 1.25rem;
    max-width: 20ch;
  }

  .archive-hero h1 em {
    font-style: italic;
    color: var(--color-accent-500);
  }

  .archive-hero h1 .title-ja {
    font-style: normal;
    font-size: 0.55em;
    font-weight: 400;
    color: var(--color-ink-500);
    display: block;
    margin-top: 0.5rem;
  }

  .archive-hero__lede {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.2vw + 0.875rem, 1.375rem);
    line-height: 1.55;
    color: var(--color-ink-700);
    max-width: 58ch;
    margin-top: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .archive-hero__card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-paper-50, #fff);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .archive-hero__card:hover,
  .archive-hero__card:focus-visible {
    border-color: var(--color-ink-900);
    box-shadow: 0 6px 24px -14px rgba(0, 0, 0, 0.22);
  }

  .archive-hero__card:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 3px;
  }

  .archive-hero__swatches {
    display: grid;
    grid-auto-flow: row;
    grid-auto-rows: 1fr;
    min-height: 18rem;
  }

  @media (min-width: 720px) {
    .archive-hero__swatches {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      min-height: 24rem;
    }
  }

  .archive-hero__swatch {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    min-height: 5rem;
  }

  .archive-hero__swatch-label {
    display: inline-flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    background-color: rgba(255, 255, 255, 0.92);
    color: var(--color-ink-900);
    font-size: 0.8125rem;
    border-radius: 2px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .archive-hero__swatch-name {
    font-family: var(--font-serif);
    font-weight: 500;
  }

  .archive-hero__swatch-hex {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.75rem;
    color: var(--color-ink-500);
  }

  .archive-hero__open {
    display: block;
    padding: 1rem 1.5rem;
    text-align: right;
    font-size: 0.9375rem;
    color: var(--color-accent-500);
    font-weight: 500;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-paper-100);
  }

  @media (max-width: 520px) {
    .archive-hero__open {
      text-align: left;
    }
  }

  .archive-list {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .archive-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .archive-item {
    margin: 0;
  }

  .archive-item__link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-paper-50, #fff);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .archive-item__link:hover {
    border-color: var(--color-ink-900);
    transform: translateY(-2px);
  }

  .archive-item__link:focus-visible {
    outline: 2px solid var(--color-accent-500);
    outline-offset: 2px;
  }

  .archive-item__swatches {
    display: flex;
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--color-border);
  }

  .archive-item__swatch {
    flex: 1;
  }

  .archive-item__body {
    padding: 1rem 1.125rem 1.25rem;
  }

  .archive-item__date {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-500);
    margin: 0 0 0.375rem;
  }

  .archive-item__title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-ink-900);
    margin: 0 0 0.375rem;
  }

  .archive-item__title-ja {
    font-size: 0.85em;
    font-weight: 400;
    color: var(--color-ink-500);
  }

  .archive-item__summary {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-500);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .archive-list__footer {
    margin-top: 2.5rem;
    text-align: center;
  }
</style>
