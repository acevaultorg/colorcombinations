---
/**
 * PrintOnDemand — POD provider affiliates (v19.37 Tier-S retrofit).
 *
 * Sibling to DesignTools.astro + LearnResources.astro. Lists Printful +
 * Printify as colour-matched-merch print-on-demand options. Keeps the
 * /shop "the toolbox" framing — designers using a colour archive can
 * produce brand-matched apparel/posters/stationery without inventory.
 *
 * Used on /shop. Falls back gracefully when affiliate links are
 * placeholders (still renders editorial recommendation).
 */

import { POD_PROVIDERS } from "@/config/monetization";

export interface Props {
  title?: string;
  intro?: string;
}

const {
  title = "Turn a palette into something you can hold",
  intro = "Print-on-demand is the cleanest path from a Wada palette to actual physical merch — apparel, posters, stationery, brand collateral. No inventory; the platform prints when someone orders. Both providers below pay a referral commission if you click through and create an account.",
} = Astro.props;
---

<section class="pod-providers">
  <header class="pod-providers__head">
    <p class="eyebrow">Print-on-demand</p>
    <h2 class="text-balance">{title}</h2>
    <p class="pod-providers__intro">{intro}</p>
  </header>

  <ul class="pod-providers__list" role="list">
    {POD_PROVIDERS.map((provider) => (
      <li class="pod-providers__item">
        <h3 class="pod-providers__name">
          <a
            href={provider.url}
            target="_blank"
            rel={provider.affiliate ? "noopener sponsored" : "noopener"}
            data-event={provider.affiliate ? "pod_affiliate_click" : "pod_click"}
            data-provider={provider.name}
          >
            {provider.name}
            <span class="pod-providers__arrow" aria-hidden="true">↗</span>
          </a>
        </h3>
        <p class="pod-providers__tagline">{provider.tagline}</p>
        <p class="pod-providers__why">{provider.why}</p>
        {provider.affiliate && (
          <p class="pod-providers__affiliate-note">
            <span aria-hidden="true">→</span> affiliate link — commission at no cost to you
          </p>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .pod-providers {
    padding-block: var(--spacing-section);
  }

  .pod-providers__head {
    max-width: 58ch;
    margin-bottom: 2.5rem;
  }

  .pod-providers__head .eyebrow {
    margin-bottom: 0.75rem;
  }

  .pod-providers__head h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw + 1rem, 2.25rem);
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .pod-providers__intro {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-ink-700);
    line-height: 1.65;
  }

  .pod-providers__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .pod-providers__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pod-providers__item {
    padding: 1.5rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-plate);
  }

  .pod-providers__name {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .pod-providers__name a {
    color: var(--color-ink-900);
    text-decoration: none;
  }

  .pod-providers__name a:hover {
    color: var(--color-accent-500);
  }

  .pod-providers__arrow {
    display: inline-block;
    margin-left: 0.25rem;
    font-size: 0.75em;
    opacity: 0.5;
  }

  .pod-providers__tagline {
    font-size: 0.9375rem;
    color: var(--color-ink-700);
    line-height: 1.55;
    margin: 0 0 0.75rem;
  }

  .pod-providers__why {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-500);
    margin: 0 0 1rem;
    font-style: italic;
  }

  .pod-providers__affiliate-note {
    font-size: 0.6875rem;
    color: var(--color-ink-400);
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .pod-providers__affiliate-note span {
    color: var(--color-accent-500);
  }
</style>
